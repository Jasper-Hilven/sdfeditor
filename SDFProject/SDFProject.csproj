<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- The viewer that Program.cs serves -->
    <ItemGroup>
        <None Update="Resources\SdfViewer\**" CopyToOutputDirectory="PreserveNewest" />
        <!-- The renderer is shared with the IDE, whose dev server only serves files that are really in its wwwroot -->
        <None Include="..\IDE\wwwroot\js\sdf-renderer.js" Link="Resources\SdfViewer\sdf-renderer.js" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
