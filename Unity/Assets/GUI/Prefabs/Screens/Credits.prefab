  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<size=170%><color=#FFD54F>MINIGUN MUSHROOMS 2</color></size>

    <size=70%><color=#FFF2D9>Last
    year''s champion. Probably still.</color></size>


    <size=125%><color=#FFD54F>A
    GAME BY</color></size>

    <color=#FFF2D9>Jasper Hilven</color>


    <size=125%><color=#FFD54F>STARRING</color></size>

    <color=#FFF2D9>Mushroom
    42, as themselves</color>

    <color=#FFF2D9>Mushroom 7 and Mushroom 13</color>

    <color=#FFF2D9>Mushroom
    99, who joined late</color>

    <color=#FFF2D9>Ref Puffball, as the referee</color>

    <color=#FFF2D9>Chanterelle
    Prime, as himself, regrettably</color>


    <size=125%><color=#FFD54F>MADE WITH</color></size>

    <color=#FFF2D9>Unity
    6 and its Universal Render Pipeline</color>

    <color=#FFF2D9>C# and .NET</color>

    <color=#FFF2D9>JetBrains
    Rider</color>

    <color=#FFF2D9>Claude, by Anthropic</color>

    <size=70%><color=#FFF2D9>Every
    mushroom, castle and chess piece is a signed distance function,</color></size>

    <size=70%><color=#FFF2D9>baked
    to a mesh before the game ever runs.</color></size>


