                    CappedCone height=0.4 bottomRadius=0.2 topRadius=0.02
        Socket name=drill_tip at=(0, 0, 1.4) dir=(0, 0, 1)
    Bone name=turret head=(0, 0.3, -0.1) tail=(0, 0.6, -0.1) falloff=0
        Material material=machine_tread
            Translate translation=(0, 0.45, -0.1)
                Box size=(0.2, 0.15, 0.2)
        Socket name=muzzle at=(0, 0.6, 0.3)
