<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SDFProject\SDFProject.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SDFPipeline.Tests" />
  </ItemGroup>

  <!-- GPU evaluation of the SDF programs (ticket 39): WebGPU over wgpu-native (Metal on Mac, Vulkan or DX12 elsewhere), GLSL compute
       shaders from the WebGL 2 code generator. Versions are pinned: wgpu-native's C API changes between releases. -->
  <ItemGroup>
    <PackageReference Include="Silk.NET.WebGPU" Version="2.23.0" />
    <PackageReference Include="Silk.NET.WebGPU.Extensions.WGPU" Version="2.23.0" />
    <PackageReference Include="Silk.NET.WebGPU.Native.WGPU" Version="2.23.0" />
  </ItemGroup>

  <!-- The render page, and the IDE's renderer it draws with, so renders match what the IDE shows -->
  <ItemGroup>
    <EmbeddedResource Include="Rendering\Page\render.html" LogicalName="SDFPipeline.Rendering.render.html" />
    <EmbeddedResource Include="Rendering\Page\render.js" LogicalName="SDFPipeline.Rendering.render.js" />
    <EmbeddedResource Include="..\IDE\wwwroot\js\sdf-renderer.js" Link="Rendering\Page\sdf-renderer.js" LogicalName="SDFPipeline.Rendering.sdf-renderer.js" />
  </ItemGroup>

</Project>
