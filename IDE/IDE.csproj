<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- SDFProject is an executable (the SDF viewer), only its library code is used here -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.1" PrivateAssets="all" />
  </ItemGroup>

  <!-- The operations and program nodes are found through reflection, so trimming may not remove any of their members -->
  <ItemGroup>
    <TrimmerRootAssembly Include="SDFProject" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SDFProject\SDFProject.csproj" />
  </ItemGroup>

</Project>
