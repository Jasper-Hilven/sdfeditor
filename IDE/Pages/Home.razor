@page "/"
@using System.Globalization
@using System.Text.RegularExpressions
@using SDFProject.SDFProgramOperator.Helpers
@using SDFProject.Calculation
@using SDFProject.ShaderExport
@using SDFProject.MeshExport
@using SDFProject.ProgramDefinition
@using SDFProject.SDFInteractiveNode
@using SDFProject.SDFInteractiveNode.InteractiveCommands
@using SDFProject.SDFInteractiveNode.PartialCommandStateFullEditing
@using SDFPipeline.Materials
@using SDFPipeline.ProgramFiles
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>SDF IDE</PageTitle>

<div class="quarters">
    <section class="panel">
        <header>Program</header>
        <pre class="code">@string.Join("\n", yamlRender.GetRender(program))</pre>
    </section>

    <section class="panel">
        <header>
            Render
            @if (renderError is not null)
            {
                <span class="error" title="@renderError">shader error, showing the last scene that worked</span>
            }
            <span class="view-options">
                <button class="toggle @(quadView ? "active" : "")" @onclick="ToggleQuadView">Quad view</button>
                <button class="toggle @(rotateView ? "active" : "")" @onclick="ToggleRotateView">Rotate view</button>
            </span>
        </header>
        <div class="view-area">
            <canvas class="view" @ref="canvas"></canvas>
            @if (quadView)
            {
                <span class="view-label" style="left: 0; top: 0">x</span>
                <span class="view-label" style="left: 50%; top: 0">y</span>
                <span class="view-label" style="left: 0; top: 50%">z</span>
                <span class="view-label" style="left: 50%; top: 50%">standard</span>
                <div class="quad-divider horizontal"></div>
                <div class="quad-divider vertical"></div>
            }
        </div>
    </section>

    <section class="panel">
        <header class="tabs">
            @foreach (var tab in Enum.GetValues<Tab>())
            {
                <button class="tab @(shownTab == tab ? "active" : "")" @onclick="() => ShowTab(tab)">@tab</button>
            }
            <span class="status">
                mode @partialProgram.state.Mode · selected @(program.SelectedNodeId ?? "none") · zoom @program.StrZoomLevel
                @if (partialProgram.state.Mode == SDFPartialCommandNodeProgramMode.EditParameter
                     && SDFPartialCommandNodeProgramOperator.EditedParameter(partialProgram) is { IsConstant: true } edited)
                {
                    <text> · @edited.Name = @FormatComponents(edited)</text>
                }
                @if (SDFPartialCommandNodeProgramOperator.EditedMaterial(partialProgram) is { } material)
                {
                    <text> · @material.Name.@material.Parameter.Name = @FormatMaterialValue(material)</text>
                }
                else if (SDFPartialCommandNodeProgramOperator.SelectedMaterialName(partialProgram) is { } materialName)
                {
                    <text> · material @materialName@(partialProgram.Materials.Contains(materialName) ? "" : " (missing)")</text>
                }
            </span>
        </header>
        @if (operationError is not null)
        {
            <div class="error">@operationError</div>
        }
        @if (shownTab == Tab.Keyboard)
        {
            var letters = KeyLetters;
            <div class="keyboard">
                @foreach (var row in KeyboardRows())
                {
                    <div class="keyboard-row">
                        @foreach (var key in row)
                        {
                            var binding = KeyCap(key);
                            <button class="keycap @binding.Style @(key == pressedKey ? "pressed" : "")" title="@binding.Name" disabled="@(!binding.Available)"
                                    @onclick="() => Press(key)">
                                <span class="keycap-letter">@letters[key].ToUpperInvariant()</span>
                                <span class="keycap-symbol" style="@binding.SymbolStyle">@binding.Label?.Symbol</span>
                                <span class="keycap-text">@binding.Label?.Text</span>
                            </button>
                        }
                    </div>
                }
                <button class="layout-switch" @onclick="() => qwerty = !qwerty">
                    Layout: @(qwerty ? "QWERTY" : "AZERTY (BE)") · switch to @(qwerty ? "AZERTY (BE)" : "QWERTY")
                </button>
            </div>
        }
        else if (shownTab == Tab.Keys)
        {
            var bindings = CurrentKeyBindings().ToList();
            <div class="keys">
                <div class="key-columns">
                    @foreach (var column in bindings.Where(b => !b.SwitchesMode).Chunk(10))
                    {
                        <ul>
                            @foreach (var (key, action, _) in column)
                            {
                                <li><kbd>@key.ToUpperInvariant()</kbd> @action</li>
                            }
                        </ul>
                    }
                </div>
                @if (bindings.Any(b => b.SwitchesMode))
                {
                    <h3>Modes</h3>
                    <div class="key-columns">
                        @foreach (var column in bindings.Where(b => b.SwitchesMode).Chunk(10))
                        {
                            <ul>
                                @foreach (var (key, action, _) in column)
                                {
                                    <li><kbd>@key.ToUpperInvariant()</kbd> @action</li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        }
        else if (shownTab == Tab.History)
        {
            var graph = SDFPartialHistoryGraph.Of(history);
            var rows = history.Entries.Count + 1;
            var currentRow = SDFPartialHistoryGraph.Row(history.Position);
            var onPath = history.Path(history.Position).Select(i => SDFPartialHistoryGraph.Row(i)).Append(0).ToHashSet();
            var options = history.RedoOptions.Select(i => SDFPartialHistoryGraph.Row(i)).ToList();
            var graphWidth = graph.LaneCount * LaneWidth + 8;
            var letters = KeyLetters;
            <div class="history-controls">
                <button type="button" disabled="@(playing || history.Position is null)" @onclick="PlayHistory">▶ Play history</button>
                <label class="mesh-resolution">
                    Speed
                    <select @bind="playSpeed" disabled="@playing">
                        @foreach (var speed in PlaySpeeds)
                        {
                            <option value="@speed">@speed commands/s</option>
                        }
                    </select>
                </label>
                <span class="hint">Replays every command from the start up to the current one.</span>
            </div>
            <div class="history" @ref="historyList">
                <div class="history-rows" style="height: @(rows * RowHeight)px">
                    <svg class="history-graph" width="@graphWidth" height="@(rows * RowHeight)">
                        @foreach (var (parent, child) in graph.Edges)
                        {
                            <path d="@EdgePath(graph, rows, parent, child)" stroke="@LaneColor(graph.Lanes[child])"
                                  class="@(onPath.Contains(child) ? "" : "off-path")" />
                        }
                        @for (var row = 0; row < rows; row++)
                        {
                            <circle cx="@LaneX(graph.Lanes[row])" cy="@RowY(rows, row)" r="@(row == currentRow ? 6 : 4)"
                                    fill="@(row == currentRow ? LaneColor(graph.Lanes[row]) : "#1e1e24")" stroke="@LaneColor(graph.Lanes[row])"
                                    class="@(onPath.Contains(row) ? "" : "off-path")" />
                        }
                    </svg>
                    @for (var row = 0; row < rows; row++)
                    {
                        var option = options.IndexOf(row);
                        var entry = row == 0 ? (int?)null : row - 1;
                        <div class="history-row @(row == currentRow ? "current" : onPath.Contains(row) ? "" : "off-path")"
                             style="top: @((rows - 1 - row) * RowHeight)px; padding-left: @(graphWidth)px" @onclick="() => Act(new GoToHistoryEntry(entry))">
                            @if (option >= 0)
                            {
                                <kbd>@letters[SDFPartialKeyBindings.RedoChoiceKeys[option]].ToUpperInvariant()</kbd>
                            }
                            @(row == 0 ? "start" : HistoryEntry(history.Entries[row - 1].Action))
                        </div>
                    }
                </div>
            </div>
        }
        else if (shownTab == Tab.File)
        {
            <div class="file">
                <section>
                    <h3>Export</h3>
                    <p class="hint">Saves every command in the history, all branches included, and where you are in it.</p>
                    <button type="button" @onclick="Export">Download program</button>
                </section>
                <section>
                    <h3>Model</h3>
                    <p class="hint">Saves the current scene as a .sdf file, to put back into content/ (for example as @(loadedModel?.Path ?? "models/my-model.sdf")).</p>
                    <button type="button" @onclick="DownloadModel">Download .sdf</button>
                </section>
                <section>
                    <h3>Materials</h3>
                    <p class="hint">Saves a material as a .sdfmat file, to put back into materials/. Changed materials are marked ●.</p>
                    <div class="material-list">
                        @foreach (var name in partialProgram.Materials.Names)
                        {
                            var changed = !Equals(partialProgram.Materials.Resolve(name), BundledContent.Materials.Resolve(name));
                            <button type="button" @onclick="() => DownloadMaterial(name)">
                                <span class="swatch" style="background: @CssColor(partialProgram.Materials.Resolve(name).baseColor)"></span>
                                @name@(changed ? " ●" : "")
                            </button>
                        }
                    </div>
                </section>
                <section>
                    <h3>Mesh</h3>
                    <p class="hint">Turns the current scene into triangles for 3D printing or other 3D tools. Infinite shapes are cut off at 50 units.</p>
                    <label class="mesh-resolution">
                        Detail
                        <select @bind="meshResolution">
                            <option value="48">coarse (48)</option>
                            <option value="96">normal (96)</option>
                            <option value="160">fine (160)</option>
                        </select>
                    </label>
                    <button type="button" disabled="@exportingMesh" @onclick="() => ExportMesh(stl: true)">STL</button>
                    <button type="button" disabled="@exportingMesh" @onclick="() => ExportMesh(stl: false)">OBJ</button>
                </section>
                <section>
                    <h3>Shader</h3>
                    <p class="hint">Downloads the current scene as a shader with the lighting of the render view.</p>
                    <button type="button" @onclick="ExportShadertoy">Shadertoy</button>
                    <button type="button" @onclick="ExportGlsl">GLSL fragment shader</button>
                </section>
                <section>
                    <h3>Import</h3>
                    <p class="hint">Replaces the current program and its history with those of the file.</p>
                    <InputFile OnChange="Import" accept=".json,application/json" />
                </section>
                @if (fileMessage is not null)
                {
                    <p class="@(fileFailed ? "error" : "hint")">@fileMessage</p>
                }
            </div>
        }
        else if (shownTab == Tab.Examples)
        {
            <div class="examples">
                <p class="hint">Loading an example replaces the current program and its history with the commands that build the scene, so you can step through them in the History tab.</p>
                @if (exampleMessage is not null)
                {
                    <p class="@(exampleFailed ? "error" : "hint")">@exampleMessage</p>
                }
                @foreach (var problem in BundledContent.Problems)
                {
                    <p class="error">@problem</p>
                }
                <h3>Models</h3>
                <p class="hint">The .sdf files in content/. Opening one starts a fresh history with that model and the materials of materials/.</p>
                <div class="example-list">
                    @foreach (var model in BundledContent.Models)
                    {
                        <button type="button" class="example" @onclick="() => LoadModel(model)">
                            <span class="example-name">@model.Name</span>
                            <span class="example-description">content/@model.Path</span>
                        </button>
                    }
                </div>
                <h3>Examples</h3>
                <div class="example-list">
                    @foreach (var example in SDFExamples.All)
                    {
                        <button type="button" class="example" @onclick="() => LoadExample(example)">
                            <span class="example-name">@example.Name</span>
                            <span class="example-description">@example.Description</span>
                        </button>
                    }
                </div>
            </div>
        }
    </section>

    <section class="panel">
        <header>WebGL2 code</header>
        <pre class="code">@shaderCode</pre>
    </section>
</div>

@if (SDFPartialCommandNodeProgramOperator.TakesText(partialProgram.state.Mode))
{
    var typed = partialProgram.state.Text;
    <div class="backdrop" @onclick="() => Act(new CancelText())">
        <div class="popup" @onclick:stopPropagation>
            <h3>@TextTitle()</h3>
            <div class="typed">@typed<span class="caret"></span>@if (typed.Length == 0)
                {
                    <span class="suggestion">@TextSuggestion()</span>
                }</div>
            @if (operationError is not null)
            {
                <div class="error">@operationError</div>
            }
            <div class="hint">Enter to confirm, Esc to cancel</div>
            <div class="actions">
                <button type="button" @onclick="() => Act(new CancelText())">Cancel</button>
                <button type="button" @onclick="() => Act(new ConfirmText())">OK</button>
            </div>
        </div>
    </div>
}

@if (playing)
{
    <div class="play-freeze">
        <div class="play-status">
            <span>Playing @playedCount / @playTotal</span>
            <button type="button" @onclick="StopPlaying">Stop</button>
        </div>
    </div>
}

@if (history.ChoosingRedo)
{
    var letters = KeyLetters;
    var options = history.RedoOptions;
    <div class="backdrop" @onclick="() => Act(new CancelRedoChoice())">
        <div class="popup" @onclick:stopPropagation>
            <h3>Redo which branch?</h3>
            @for (var i = 0; i < options.Count; i++)
            {
                var index = i;
                <button type="button" class="redo-option" @onclick="() => Act(new ChooseRedoBranch(index))">
                    <kbd>@letters[SDFPartialKeyBindings.RedoChoiceKeys[index]].ToUpperInvariant()</kbd>
                    @HistoryEntry(history.Entries[options[index]].Action)
                    <span class="hint">@BranchSize(options[index]) action(s)</span>
                </button>
            }
            <div class="hint">Press the key of a branch, Esc to cancel</div>
            <div class="actions">
                <button type="button" @onclick="() => Act(new CancelRedoChoice())">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly YamlRender yamlRender = new();
    private static SDFPartialCommandNodeProgram InitialProgram() => new(
        SdfInteractiveNodeProgramConstants.GetInitialProgram(),
        new SDFPartialCommandNodeProgramState(SDFPartialCommandNodeProgramMode.Home))
    {
        Materials = BundledContent.Materials,
    };

    /// <summary>The shader of a program, with its materials.</summary>
    private static string Shader(SDFPartialCommandNodeProgram partial) =>
        new Webgl2CodeGenerator(partial.Materials).GenerateShaderCode(partial.interactiveProgram.Program);

    private BundledContent.Model? loadedModel;

    private SDFPartialActionHistory history = SDFPartialActionHistory.Start(InitialProgram());
    private SDFPartialCommandNodeProgram partialProgram => history.Current;
    private SdfInteractiveNodeProgram program => partialProgram.interactiveProgram;
    private string shaderCode = "";
    private string? operationError;

    private ElementReference canvas;
    private IJSObjectReference? rendererModule;
    private IJSObjectReference? renderer;
    private string? renderedCode;
    private string? renderError;
    private bool quadView;
    private bool rotateView;

    private enum Tab { Keyboard, Keys, History, File, Examples }

    private Tab shownTab = Tab.Keyboard;

    private DotNetObjectReference<Home>? keyHandler;
    private IJSObjectReference? keyboardModule;
    private IJSObjectReference? keyListener;

    protected override void OnInitialized() => shaderCode = Shader(partialProgram);

    private static IEnumerable<InputKey[]> KeyboardRows() =>
    [
        FingerKeyLayouts.KeyColumns.Select(c => c.Up).ToArray(),
        FingerKeyLayouts.KeyColumns.Select(c => c.Home).ToArray(),
        FingerKeyLayouts.KeyColumns.Select(c => c.Down).ToArray(),
    ];

    private bool qwerty;

    private Dictionary<string, InputKey> Layout =>
        qwerty ? FingerKeyLayouts.QwertyFingerKeyToIndex : FingerKeyLayouts.AzertyBeFingerKeyToIndex;

    private Dictionary<InputKey, string> KeyLetters => Layout.ToDictionary(pair => pair.Value, pair => pair.Key);

    private (SDFPartialActionLabel? Label, string Name, bool Available, string Style, string? SymbolStyle) KeyCap(InputKey key)
    {
        if (history.ActionFor(key) is not { } action || NotOnThisNode(action))
            return (null, "", false, "unbound", null);

        var available = history.IsAvailable(key);
        var style = ModeSwitchingActions.Contains(action) ? "mode" : "";
        var symbolStyle = action switch
        {
            PaintColor paint => $"color: {CssColor(paint.color)}",
            AssignMaterial assign => $"color: {CssColor(partialProgram.Materials.Resolve(assign.name).baseColor)}",
            _ => null,
        };
        return (Label(action), Describe(action), available, available ? style : $"{style} unavailable", symbolStyle);
    }

    private static string CssColor(V3 color) =>
        FormattableString.Invariant($"rgb({color.x * 255:0}, {color.y * 255:0}, {color.z * 255:0})");

    private SDFPartialActionLabel Label(ISDFPartialAction action) => action is ChooseRedoBranch choose
        ? new("⎇", SDFPartialActionLabels.Label(BranchAction(choose)).Text)
        : SDFPartialActionLabels.Label(action, partialProgram);

    private ISDFPartialAction BranchAction(ChooseRedoBranch choose) => history.Entries[history.RedoOptions[choose.index]].Action;

    private int BranchSize(int entry) => 1 + history.Children(entry).Sum(BranchSize);

    private void Press(InputKey key)
    {
        if (history.ActionFor(key) is { } action)
            Act(action);
    }

    private ISDFPartialAction? TextAction(string key) => key switch
    {
        "Enter" => new ConfirmText(),
        "Escape" => new CancelText(),
        "Backspace" => new DeleteLastCharacter(),
        _ when key.Length == 1 => new InsertText(key),
        _ => null,
    };

    private string TextTitle() =>
        partialProgram.state.Mode == SDFPartialCommandNodeProgramMode.ExtractVariable
            ? "Extract variable"
            : SDFPartialCommandNodeProgramOperator.EditedMaterial(partialProgram) is { } material
                ? $"{material.Name}.{material.Parameter.Name}{(material.Parameter.ComponentCount > 1 ? ", numbers separated by commas" : "")}"
            : SDFPartialCommandNodeProgramOperator.EditedParameter(partialProgram) is { } edited
                ? $"{edited.Name}{(edited.Kind == NodeParameterKind.Angle ? " (degrees)" : "")}, numbers separated by commas"
                : "Value";

    private string TextSuggestion() =>
        partialProgram.state.Mode == SDFPartialCommandNodeProgramMode.ExtractVariable
            ? SDFPartialCommandNodeProgramOperator.SuggestedVariableName(partialProgram)
            : SDFPartialCommandNodeProgramOperator.EditedMaterial(partialProgram) is { } material
                ? string.Join(", ", material.Parameter.Get(material.Material).Select(Format))
            : SDFPartialCommandNodeProgramOperator.EditedParameter(partialProgram) is { } edited
                ? string.Join(", ", edited.Components().Select(Format))
                : "";

    private static string Format(float value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    private static string FormatComponents(NodeParameter parameter)
    {
        var text = string.Join(", ", parameter.Components().Select(Format));
        return parameter.Kind switch
        {
            NodeParameterKind.Angle => $"{text}°",
            NodeParameterKind.Number => text,
            _ => $"({text})",
        };
    }

    private static string FormatMaterialValue(SDFPartialCommandNodeProgramOperator.EditedMaterialParameter edited)
    {
        var components = edited.Parameter.Get(edited.Material).Select(Format).ToArray();
        return components.Length == 1 ? components[0] : $"({string.Join(", ", components)})";
    }

    private bool NotOnThisNode(ISDFPartialAction action) => action switch
    {
        ParameterYDown or ParameterYUp when SDFPartialCommandNodeProgramOperator.EditedMaterial(partialProgram) is { } material
            => material.Parameter.ComponentCount < 2,
        ParameterZDown or ParameterZUp when SDFPartialCommandNodeProgramOperator.EditedMaterial(partialProgram) is { } material
            => material.Parameter.ComponentCount < 3,
        EditParameter1 or EditParameter2 or EditParameter3 or EditParameter4
            => SDFPartialCommandNodeProgramOperator.ParameterToEdit(partialProgram, action) is null,
        ParameterYDown or ParameterYUp
            => SDFPartialCommandNodeProgramOperator.EditedParameter(partialProgram) is not { ComponentCount: >= 2 },
        ParameterZDown or ParameterZUp
            => SDFPartialCommandNodeProgramOperator.EditedParameter(partialProgram) is not { ComponentCount: 3 },
        _ => false,
    };

    private string Describe(ISDFPartialAction action) =>
        action is PaintColor paint ? $"Paint {paint.name}"
        : action is AssignMaterial assign ? $"Material {assign.name}"
        : action is PickMaterialParameter pick ? $"Edit {SDFPartialActionLabels.Label(pick).Text}"
        : action is ParameterXDown or ParameterXUp or ParameterYDown or ParameterYUp or ParameterZDown or ParameterZUp or TypeParameterValue
          && SDFPartialCommandNodeProgramOperator.EditedMaterial(partialProgram) is { } material
            ? $"{SpelledOut(action)} ({material.Name}.{material.Parameter.Name})"
        : action is ChooseRedoBranch choose ? $"Redo {HistoryEntry(BranchAction(choose))}"
        : SDFPartialCommandNodeProgramOperator.ParameterToEdit(partialProgram, action) is { } picked ? $"Edit {picked.Name}"
        : action is ParameterXDown or ParameterXUp or ParameterYDown or ParameterYUp or ParameterZDown or ParameterZUp
              or TypeParameterValue
          && SDFPartialCommandNodeProgramOperator.EditedParameter(partialProgram) is { } edited ? $"{SpelledOut(action)} ({edited.Name})"
        : SpelledOut(action);

    private static string SpelledOut(ISDFPartialAction action) => SpelledOut(action.GetType());

    private static string SpelledOut(Type type) => Regex.Replace(type.Name, "(?<=[a-z])(?=[A-Z])", " ");

    private static string HistoryEntry(ISDFPartialAction action) => action switch
    {
        InsertText insert => $"Insert Text \"{insert.text}\"",
        PaintColor paint => $"Paint {paint.name}",
        AssignMaterial assign => $"Material {assign.name}",
        PickMaterialParameter pick => $"Edit material {SDFPartialActionLabels.Label(pick).Text}",
        ApplyInteractiveOperation apply => $"Operation: {SpelledOut(apply.operation.GetType())}",
        _ => SpelledOut(action),
    };

    private const int RowHeight = 24;
    private const int LaneWidth = 16;
    private static readonly string[] LaneColors = ["#e0a458", "#6cb4ee", "#9ad27f", "#d987c9", "#ef7b72", "#7fd6c8"];

    private ElementReference historyList;
    private string? revealedHistory;

    private static string LaneColor(int lane) => LaneColors[lane % LaneColors.Length];

    private static int LaneX(int lane) => 4 + lane * LaneWidth + LaneWidth / 2;

    private static int RowY(int rows, int row) => (rows - 1 - row) * RowHeight + RowHeight / 2;

    private static string EdgePath(SDFPartialHistoryGraph graph, int rows, int parent, int child)
    {
        int px = LaneX(graph.Lanes[parent]), py = RowY(rows, parent), cx = LaneX(graph.Lanes[child]), cy = RowY(rows, child);
        return px == cx
            ? $"M {px} {py} L {cx} {cy}"
            : $"M {px} {py} C {px} {py - RowHeight / 2} {cx} {py - RowHeight / 2} {cx} {py - RowHeight} L {cx} {cy}";
    }

    private void ShowTab(Tab tab)
    {
        shownTab = tab;
        revealedHistory = null;
    }

    private static readonly int[] PlaySpeeds = [1, 2, 5, 10, 25, 50, 100];

    private const int MaxRendersPerSecond = 5;

    private int playSpeed = 10;
    private bool playing;
    private bool stopRequested;
    private int playedCount;
    private int playTotal;

    private async Task PlayHistory()
    {
        var path = history.Path(history.Position);
        if (path.Count == 0 || playing)
            return;

        playing = true;
        stopRequested = false;
        playedCount = 0;
        playTotal = path.Count;
        shownTab = Tab.Keyboard;
        try
        {
            history = history.GoTo(null);
            shaderCode = Shader(partialProgram);
            operationError = null;
            StateHasChanged();
            var rendersPerSecond = Math.Min(playSpeed, MaxRendersPerSecond);
            var stepsPerRender = (int)Math.Ceiling((double)playSpeed / rendersPerSecond);
            var interval = 1000 / rendersPerSecond;
            var pressDelay = interval * 2 / 5;
            var resultDelay = interval - pressDelay;
            while (playedCount < path.Count)
            {
                await Task.Delay(resultDelay);
                if (stopRequested)
                    break;
                var batch = path.Skip(playedCount).Take(stepsPerRender).ToList();
                foreach (var entry in batch.SkipLast(1))
                    history = history.StepForward(entry);
                var last = batch[^1];
                pressedKey = KeyFor(history.Entries[last].Action);
                StateHasChanged();
                await Task.Delay(pressDelay);
                history = history.StepForward(last);
                pressedKey = null;
                playedCount += batch.Count;
                shaderCode = Shader(partialProgram);
                StateHasChanged();
                if (stopRequested)
                    break;
            }
        }
        catch (Exception e)
        {
            operationError = $"Playing the history failed: {e.Message}";
        }
        finally
        {
            playing = false;
            pressedKey = null;
            StateHasChanged();
        }
    }

    private InputKey? pressedKey;

    private InputKey? KeyFor(ISDFPartialAction action) =>
        KeyboardRows().SelectMany(row => row).Cast<InputKey?>()
            .FirstOrDefault(key => action.Equals(history.ActionFor(key!.Value)));

    private void StopPlaying() => stopRequested = true;

    [JSInvokable]
    public async Task OnKeyDown(string key)
    {
        if (playing)
        {
            if (key == "Escape")
                StopPlaying();
            return;
        }
        if (history.ChoosingRedo && key == "Escape")
        {
            Act(new CancelRedoChoice());
        }
        else if (!history.ChoosingRedo && SDFPartialCommandNodeProgramOperator.TakesText(partialProgram.state.Mode))
        {
            if (TextAction(key) is not { } action)
                return;
            Act(action);
        }
        else if (!history.ChoosingRedo && shownTab == Tab.History && key.ToLowerInvariant() is "i" or "k")
        {
            if (keyboardModule is not null)
                await keyboardModule.InvokeVoidAsync("scrollBy", historyList, key.ToLowerInvariant() == "i" ? -3 * RowHeight : 3 * RowHeight);
            return;
        }
        else if (Layout.TryGetValue(key, out var inputKey))
        {
            Press(inputKey);
        }
        else
        {
            return;
        }

        StateHasChanged();
    }

    private static readonly HashSet<ISDFPartialAction> ModeSwitchingActions =
    [
        new SwitchToHomeMode(),
        new SwitchToScaleMode(),
        new SwitchToRotateMode(),
        new SwitchToTranslateMode(),
        new StopEditingParameter(),
        new CancelAddNode(),
        new ShowMoreNodeTypes(),
        new ShowFirstNodeTypes(),
        new CancelReplaceNode(),
        new ShowMoreReplaceNodeTypes(),
        new ShowFirstReplaceNodeTypes(),
        new CancelText(),
        new CancelRedoChoice(),
        new SwitchToMaterialMode(),
        new ShowMaterials(),
        new CancelMaterials(),
        new EditMaterial(),
        new StopEditingMaterialParameter(),
    ];

    private IEnumerable<(string Key, string Action, bool SwitchesMode)> CurrentKeyBindings() =>
        Layout
            .Where(pair => history.IsAvailable(pair.Value))
            .OrderBy(pair => pair.Key, StringComparer.Ordinal)
            .Select(pair => (pair.Key, Action: history.ActionFor(pair.Value)!))
            .Select(pair => (pair.Key, Describe(pair.Action), ModeSwitchingActions.Contains(pair.Action)));

    private void Act(ISDFPartialAction action)
    {
        var name = action is ApplyInteractiveOperation apply ? apply.operation.GetType().Name : action.GetType().Name;
        try
        {
            var next = history.Do(action);
            shaderCode = Shader(next.Current);
            history = next;
            operationError = null;
        }
        catch (Exception e)
        {
            operationError = $"{name} failed: {e.Message}";
        }
    }

    private IJSObjectReference? filesModule;
    private string? fileMessage;
    private bool fileFailed;
    private string? exampleMessage;
    private bool exampleFailed;

    private async Task Export()
    {
        filesModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/files.js");
        await filesModule.InvokeVoidAsync("downloadText", "sdf-program.json", SDFPartialHistorySerializer.Serialize(history), "application/json");
        fileMessage = $"Exported {history.Entries.Count} command(s)";
        fileFailed = false;
    }

    private async Task DownloadText(string fileName, string text, string type)
    {
        filesModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/files.js");
        await filesModule.InvokeVoidAsync("downloadText", fileName, text, type);
    }

    private int meshResolution = SdfMeshExporter.DefaultResolution;
    private bool exportingMesh;

    private async Task ExportMesh(bool stl)
    {
        exportingMesh = true;
        fileMessage = $"Building the mesh at detail {meshResolution}…";
        fileFailed = false;
        StateHasChanged();
        await Task.Delay(1);
        try
        {
            var mesh = SdfMeshExporter.ToMesh(program.Program, meshResolution);
            if (mesh.IsEmpty)
            {
                fileMessage = "The scene has no surface to export";
                fileFailed = true;
                return;
            }

            filesModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/files.js");
            if (stl)
                await filesModule.InvokeVoidAsync("downloadBytes", "sdf-scene.stl", StlWriter.Write(mesh), "model/stl");
            else
                await filesModule.InvokeVoidAsync("downloadText", "sdf-scene.obj", ObjWriter.Write(mesh), "model/obj");
            fileMessage = $"Exported {(stl ? "STL" : "OBJ")} with {mesh.TriangleCount:N0} triangles";
        }
        catch (Exception e)
        {
            fileMessage = $"Could not export the mesh: {e.Message}";
            fileFailed = true;
        }
        finally
        {
            exportingMesh = false;
        }
    }

    private async Task ExportShadertoy()
    {
        await DownloadText("sdf-scene.shadertoy.glsl", SdfShaderExporter.ToShadertoy(program.Program), "text/plain");
        fileMessage = "Exported the Shadertoy shader, paste it into the Image tab on shadertoy.com";
        fileFailed = false;
    }

    private async Task ExportGlsl()
    {
        await DownloadText("sdf-scene.frag", SdfShaderExporter.ToGlslFragment(program.Program), "text/plain");
        fileMessage = $"Exported the GLSL fragment shader, it needs the uniforms {SdfShaderExporter.ResolutionUniform}, {SdfShaderExporter.CameraPositionUniform}, {SdfShaderExporter.CameraTargetUniform} and {SdfShaderExporter.CameraUpUniform}";
        fileFailed = false;
    }

    private async Task Import(InputFileChangeEventArgs e)
    {
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(maxAllowedSize: 50_000_000));
            var imported = SDFPartialHistorySerializer.Deserialize(await reader.ReadToEndAsync(), InitialProgram());
            shaderCode = Shader(imported.Current);
            history = imported;
            loadedModel = null;
            operationError = null;
            fileMessage = $"Imported {e.File.Name} with {imported.Entries.Count} command(s)";
            fileFailed = false;
        }
        catch (Exception exception)
        {
            fileMessage = $"Could not import {e.File.Name}: {exception.Message}";
            fileFailed = true;
        }
    }

    private void LoadModel(BundledContent.Model model)
    {
        try
        {
            var loaded = SdfProgramFile.Read(model.Text, BundledContent.Part);
            var interactive = new SdfInteractiveNodeProgram(loaded, PointerTables.PointerId(loaded.scene), 0);
            var started = SDFPartialActionHistory.Start(InitialProgram() with { interactiveProgram = interactive });
            shaderCode = Shader(started.Current);
            history = started;
            loadedModel = model;
            operationError = null;
            exampleMessage = $"Opened content/{model.Path}";
            exampleFailed = false;
        }
        catch (Exception exception)
        {
            exampleMessage = $"Could not open content/{model.Path}: {exception.Message}";
            exampleFailed = true;
        }
    }

    private async Task DownloadModel()
    {
        try
        {
            var fileName = loadedModel is { } model ? $"{model.Name}{SdfProgramFile.Extension}" : $"model{SdfProgramFile.Extension}";
            await DownloadText(fileName, SdfProgramFile.Write(program.Program), "text/plain");
            fileMessage = $"Downloaded {fileName}";
            fileFailed = false;
        }
        catch (Exception exception)
        {
            fileMessage = $"Could not write the model: {exception.Message}";
            fileFailed = true;
        }
    }

    private async Task DownloadMaterial(string name)
    {
        var fileName = $"{name}{MaterialFile.Extension}";
        await DownloadText(fileName, MaterialFile.Write(partialProgram.Materials.Resolve(name)), "text/plain");
        fileMessage = $"Downloaded {fileName}, put it in materials/";
        fileFailed = false;
    }

    private void LoadExample(SDFExample example)
    {
        try
        {
            var loaded = example.Load(InitialProgram());
            shaderCode = Shader(loaded.Current);
            history = loaded;
            loadedModel = null;
            operationError = null;
            exampleMessage = $"Loaded {example.Name} with {loaded.Entries.Count} command(s)";
            exampleFailed = false;
        }
        catch (Exception exception)
        {
            exampleMessage = $"Could not load {example.Name}: {exception.Message}";
            exampleFailed = true;
        }
    }

    private async Task ToggleQuadView()
    {
        quadView = !quadView;
        if (renderer is not null)
            await renderer.InvokeVoidAsync("setQuadView", quadView);
    }

    private async Task ToggleRotateView()
    {
        rotateView = !rotateView;
        if (renderer is not null)
            await renderer.InvokeVoidAsync("setRotateView", rotateView);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var historyState = $"{history.Position}/{history.Entries.Count}";
        if (shownTab == Tab.History && revealedHistory != historyState && keyboardModule is not null)
        {
            revealedHistory = historyState;
            await keyboardModule.InvokeVoidAsync("revealCurrent", historyList);
        }

        if (firstRender)
        {
            keyHandler = DotNetObjectReference.Create(this);
            keyboardModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/keyboard.js");
            keyListener = await keyboardModule.InvokeAsync<IJSObjectReference>("listenToKeys", keyHandler);

            rendererModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sdf-renderer.js");
            try
            {
                renderer = await rendererModule.InvokeAsync<IJSObjectReference>("createRenderer", canvas);
            }
            catch (JSException e)
            {
                renderError = e.Message;
                StateHasChanged();
            }
        }

        if (renderer is null || renderedCode == shaderCode)
            return;

        renderedCode = shaderCode;
        var error = await renderer.InvokeAsync<string?>("setCode", shaderCode);
        if (error != renderError)
        {
            renderError = error;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (keyListener is not null)
        {
            await keyListener.InvokeVoidAsync("dispose");
            await keyListener.DisposeAsync();
        }
        if (keyboardModule is not null)
            await keyboardModule.DisposeAsync();
        keyHandler?.Dispose();

        if (renderer is not null)
        {
            await renderer.InvokeVoidAsync("dispose");
            await renderer.DisposeAsync();
        }
        if (rendererModule is not null)
            await rendererModule.DisposeAsync();
        if (filesModule is not null)
            await filesModule.DisposeAsync();
    }
}
