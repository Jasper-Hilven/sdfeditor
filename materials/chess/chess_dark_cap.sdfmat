# The dark side's caps: a glossy deep chestnut-red, like a bay bolete's, darkening to a burnt umber in broad patches and at the
# rim, flecked with cream warts. Dark but warm, so it keeps its toon bands and does not read as a black hole. Lengths are at
# chess-piece scale (pieces 2.5 to 5.5 m tall).
format 1

baseColor = (0.3, 0.07, 0.04)
roughness = 0.4
specular = 0.45
subsurfaceColor = (0.8, 0.22, 0.1)
subsurfaceRadius = 0.1
detailStrength = 0.2
detailScale = 0.05
colorVariation = 0.14
wetness = 0.5
detailStretch = 3
detailAxis = (0, 1, 0)
edgeColor = (0.22, 0.07, 0.04)
edgeThickness = 0.15
variationColor = (0.26, 0.08, 0.05)
variationScale = 0.6
speckleColor = (0.92, 0.84, 0.66)
speckleScale = 0.22
speckleDensity = 0.45
speckleSize = 0.3
