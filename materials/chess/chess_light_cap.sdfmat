# The light side's caps: a pale ivory parasol cap, satiny, warming to a creamy biscuit in broad patches and at its thin rim, flecked
# with small tan scales. Lengths are at chess-piece scale (pieces 2.5 to 5.5 m tall), so the scales read from across a board square.
format 1

baseColor = (0.92, 0.8, 0.6)
roughness = 0.5
specular = 0.4
subsurfaceColor = (1, 0.86, 0.62)
subsurfaceRadius = 0.12
detailStrength = 0.2
detailScale = 0.05
colorVariation = 0.12
wetness = 0.2
detailStretch = 3
detailAxis = (0, 1, 0)
edgeColor = (0.86, 0.72, 0.5)
edgeThickness = 0.15
variationColor = (0.86, 0.7, 0.48)
variationScale = 0.6
speckleColor = (0.62, 0.45, 0.28)
speckleScale = 0.22
speckleDensity = 0.45
speckleSize = 0.3
