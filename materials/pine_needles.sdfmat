# Pine needles: one solid mass of needles per tier rather than needle cards, a deep blue-green that stays cooler and darker than
# the broadleaf canopy, shading to a bluer teal in large patches and glowing a mossy green where light comes through the tier rims.
# subsurfaceRadius is at tree scale.
format 1

baseColor = (0.07, 0.2, 0.15)
roughness = 0.75
specular = 0.3
subsurfaceColor = (0.2, 0.46, 0.3)
subsurfaceRadius = 0.12
detailStrength = 0.3
detailScale = 0.06
colorVariation = 0.18
wetness = 0
detailStretch = 3
detailAxis = (0, 1, 0)
edgeColor = (0.2, 0.42, 0.26)
edgeThickness = 0.25
variationColor = (0.06, 0.17, 0.19)
variationScale = 0.7
speckleColor = (0.22, 0.4, 0.26)
speckleScale = 0.1
speckleDensity = 0.35
speckleSize = 0.28
