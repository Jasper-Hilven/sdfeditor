# Home lamp shade: the desk lamp's cap-shaped shade and bulb, a warm cream that glows (a strong subsurface), the room's key light. There
# is no emissive material: the story capture adds the light itself, and the glow here keeps the shade bright.
format 1

baseColor = (1, 0.88, 0.55)
roughness = 0.6
specular = 0.1
subsurfaceColor = (1, 0.75, 0.3)
subsurfaceRadius = 0.4
detailStrength = 0
detailScale = 0.01
colorVariation = 0.08
wetness = 0
variationColor = (1, 0.8, 0.4)
variationScale = 0.1
