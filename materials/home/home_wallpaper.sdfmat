# Home wallpaper: a warm cream with soft, low-contrast vertical stripes. The stripes are the material's, not the mesh's: the
# fibres pattern draws a fine line every 12 cm up the wall (in ink, so thin), and the colour variation is stretched upwards into
# broad, faint bands in between. Matte, no highlight, so the lamp's glow is what lights it.
format 1

baseColor = (0.86, 0.72, 0.52)
roughness = 0.9
specular = 0.05
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0.12
detailScale = 0.06
colorVariation = 0.14
wetness = 0
detailStretch = 12
detailAxis = (0, 1, 0)
variationColor = (0.78, 0.6, 0.42)
variationScale = 0.12
pattern fibres size=0.12 grout=0.003
