# Home poster: stand-in for the picture on the tournament poster, a deep blue with a warm glow. The story capture paints the real
# picture on the poster_picture part as a texture.
format 1

baseColor = (0.2, 0.3, 0.6)
roughness = 0.8
specular = 0.1
subsurfaceColor = (1, 0.6, 0.3)
subsurfaceRadius = 0.03
detailStrength = 0
detailScale = 0.01
colorVariation = 0.08
wetness = 0
variationColor = (0.3, 0.2, 0.5)
variationScale = 0.1
