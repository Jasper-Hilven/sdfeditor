# Home screen: the monitor's glass, a dark blue-black with a faint glow. A stand-in: the story capture draws the screen part with
# its own unlit material and a texture, so this is only what the part looks like in the model's own preview.
format 1

baseColor = (0.06, 0.1, 0.16)
roughness = 0.15
specular = 0.6
subsurfaceColor = (0.2, 0.45, 0.8)
subsurfaceRadius = 0.01
detailStrength = 0
detailScale = 0.01
colorVariation = 0
wetness = 0.3
