# Home wood: the desk's and the shelf's varnished pine, a warm honey brown with a lengthwise grain, a little glossy so the lamp
# catches the edges. Lighter than the castle's oak and the flag pole.
format 1

baseColor = (0.62, 0.4, 0.2)
roughness = 0.55
specular = 0.3
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0.3
detailScale = 0.02
colorVariation = 0.12
wetness = 0.1
detailStretch = 8
detailAxis = (1, 0, 0)
variationColor = (0.7, 0.46, 0.24)
variationScale = 0.3
