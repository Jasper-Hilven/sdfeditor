# Home gem blue: the crown's blue gems, a bright cut stone that seems lit from inside (a strong subsurface glow, so it stays
# bright in the shade).
format 1

baseColor = (0.25, 0.5, 1)
roughness = 0.1
specular = 0.9
subsurfaceColor = (0.2, 0.5, 1)
subsurfaceRadius = 0.3
detailStrength = 0
detailScale = 0.01
colorVariation = 0.08
wetness = 0
variationColor = (0.15, 0.4, 0.9)
variationScale = 0.1
