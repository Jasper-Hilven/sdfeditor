# Home sky: the dusk behind the window, a deep violet fading to a warm orange (the variation colour, in broad patches) with a
# scatter of pale stars (the speckles). It sits on a flat card, so nothing about it is lit or shaded.
format 1

baseColor = (0.2, 0.14, 0.38)
roughness = 1
specular = 0
subsurfaceColor = (0.6, 0.35, 0.5)
subsurfaceRadius = 0.05
detailStrength = 0
detailScale = 0.05
colorVariation = 0.5
wetness = 0
variationColor = (0.95, 0.5, 0.3)
variationScale = 0.8
speckleColor = (1, 0.96, 0.8)
speckleScale = 0.05
speckleDensity = 0.25
speckleSize = 0.2
