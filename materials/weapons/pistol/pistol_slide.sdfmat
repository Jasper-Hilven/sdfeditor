# The pistol's cap (its slide): an ink cap's bell gone blue-black and wet as it melts, with pale shaggy scales flecked over it and
# fine fibres running along the gun
format 1

baseColor = (0.09, 0.08, 0.12)
roughness = 0.3
specular = 0.6
subsurfaceColor = (0.2, 0.12, 0.3)
subsurfaceRadius = 0.01
detailStrength = 0.12
detailScale = 0.004
detailStretch = 4
detailAxis = (0, 0, 1)
colorVariation = 0.15
wetness = 0.6
variationColor = (0.16, 0.14, 0.2)
variationScale = 0.03
speckleColor = (0.78, 0.74, 0.7)
speckleScale = 0.009
speckleDensity = 0.4
speckleSize = 0.3
