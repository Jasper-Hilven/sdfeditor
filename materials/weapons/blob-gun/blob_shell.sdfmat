# The blob gun's yellow flesh: a sulphur shelf's glossy sunflower-yellow, smooth as a toy with a soft sheen, warming to orange in
# patches and paling at its thin wavy edges
format 1

baseColor = (0.95, 0.68, 0.08)
roughness = 0.3
specular = 0.5
subsurfaceColor = (1, 0.75, 0.3)
subsurfaceRadius = 0.02
detailStrength = 0.1
detailScale = 0.01
colorVariation = 0.12
wetness = 0.2
edgeColor = (1, 0.88, 0.45)
edgeThickness = 0.006
variationColor = (0.98, 0.5, 0.06)
variationScale = 0.05
