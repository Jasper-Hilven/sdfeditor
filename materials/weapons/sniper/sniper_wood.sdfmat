# The sniper's stock: hard brown bracket fungus, matte and woody, banded in growth rings of russet and fawn along the rifle, paler
# where it bulges
format 1

baseColor = (0.32, 0.18, 0.09)
roughness = 0.7
specular = 0.3
subsurfaceColor = (0.7, 0.45, 0.25)
subsurfaceRadius = 0.01
detailStrength = 0.25
detailScale = 0.008
detailStretch = 6
detailAxis = (0, 0, 1)
colorVariation = 0.25
variationColor = (0.48, 0.32, 0.18)
variationScale = 0.05
