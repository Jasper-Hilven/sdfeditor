# The chanterelle scout's cap, in the blue side's colour: a clear cornflower blue, velvety with fine radial fibres, dewy, deeper blue
# at the thin wavy edge, and light glows through it. subsurfaceRadius is at character scale (a 2 m mushroom), not real mushroom scale.
format 1

baseColor = (0.14, 0.4, 0.88)
roughness = 0.55
specular = 0.4
subsurfaceColor = (0.35, 0.62, 1)
subsurfaceRadius = 0.08
detailStrength = 0.5
detailScale = 0.012
colorVariation = 0.24
wetness = 0.35
detailStretch = 6
detailAxis = (0, 1, 0)
edgeColor = (0.06, 0.2, 0.62)
edgeThickness = 0.1
variationColor = (0.1, 0.28, 0.74)
variationScale = 0.16
speckleColor = (0.05, 0.14, 0.42)
speckleScale = 0.026
speckleDensity = 0.6
speckleSize = 0.26
