# The golden-orange cap of a chanterelle: velvety with fine radial fibres, dewy, deeper orange at the thin wavy edge,
# and light glows through it. subsurfaceRadius is at character scale (a 2 m mushroom), not real mushroom scale.
format 1

baseColor = (0.93, 0.56, 0.09)
roughness = 0.55
specular = 0.4
subsurfaceColor = (1, 0.5, 0.1)
subsurfaceRadius = 0.08
detailStrength = 0.5
detailScale = 0.012
colorVariation = 0.24
wetness = 0.35
detailStretch = 6
detailAxis = (0, 1, 0)
edgeColor = (0.78, 0.32, 0.02)
edgeThickness = 0.1
variationColor = (0.82, 0.36, 0.03)
variationScale = 0.16
speckleColor = (0.5, 0.2, 0.03)
speckleScale = 0.026
speckleDensity = 0.6
speckleSize = 0.26
