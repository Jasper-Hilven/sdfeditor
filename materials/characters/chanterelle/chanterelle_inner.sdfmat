# The chanterelle scout's inner flesh, where it breaks open: firm, fibrous and much paler than the blue outside, an icy blue-white
# with a cool glow, so the cut faces of the exploding pieces read at once (as the amanita's cream flesh does on the red side)
format 1

baseColor = (0.84, 0.91, 1)
roughness = 0.6
specular = 0.35
subsurfaceColor = (0.6, 0.78, 1)
subsurfaceRadius = 0.08
detailStrength = 0.25
detailScale = 0.015
colorVariation = 0.12
detailStretch = 3
detailAxis = (0, 1, 0)
variationColor = (0.7, 0.82, 0.98)
variationScale = 0.05
wetness = 0.15
