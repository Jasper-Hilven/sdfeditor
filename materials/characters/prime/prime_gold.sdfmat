# Prime gold: Chanterelle Prime's gold (the crown's, and the minigun-gold of the boss fight): the home crown's bright gold as a
# material of its own, so the boss's pieces do not depend on the home room's.
format 1

baseColor = (0.95, 0.72, 0.2)
roughness = 0.2
specular = 0.8
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0.03
detailScale = 0.01
colorVariation = 0.06
wetness = 0
variationColor = (0.8, 0.55, 0.12)
variationScale = 0.15
