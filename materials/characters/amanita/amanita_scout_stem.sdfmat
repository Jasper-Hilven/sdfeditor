# The amanita scout's stem, bulb, ring and hands: the fly agaric's fibrous stem flesh tinted a soft rosy red, so the scout reads as the
# red side all over, but lighter and less saturated than the scarlet cap, which stays the strongest red. Its own material, as
# amanita_stem is also the giant amanitas' and the castle's off-white stem and must not turn red with it.
format 1

baseColor = (0.84, 0.32, 0.27)
roughness = 0.66
specular = 0.3
subsurfaceColor = (1, 0.44, 0.34)
subsurfaceRadius = 0.06
detailStrength = 0.3
detailScale = 0.02
colorVariation = 0.26
detailStretch = 4
detailAxis = (0, 1, 0)
variationColor = (0.68, 0.2, 0.16)
variationScale = 0.07
speckleColor = (0.42, 0.12, 0.09)
speckleScale = 0.022
speckleDensity = 0.5
speckleSize = 0.24
wetness = 0.05
