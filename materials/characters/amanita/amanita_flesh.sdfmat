roughness = 0.6
specular = 0.35
subsurfaceColor = (1, 0.82, 0.55)
subsurfaceRadius = 0.08
detailStrength = 0.25
detailScale = 0.015
colorVariation = 0.12
detailStretch = 3
detailAxis = (0, 1, 0)
variationColor = (0.98, 0.84, 0.62)
variationScale = 0.05
wetness = 0.15
