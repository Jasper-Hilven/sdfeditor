# The inside of a monster head where it bursts (ticket 51): pale, matte and neutral, so the cut faces of the pieces read at once in
# every head's own colours (the blood is the head's colour, thrown and splatted by the gore).
format 1

baseColor = (0.93, 0.9, 0.84)
roughness = 0.65
specular = 0.25
subsurfaceColor = (1, 0.9, 0.8)
subsurfaceRadius = 0.05
detailStrength = 0.2
detailScale = 0.02
colorVariation = 0.1
detailStretch = 1
detailAxis = (0, 1, 0)
variationColor = (0.85, 0.8, 0.72)
variationScale = 0.05
wetness = 0.2
