# Arena floodlight cap: the giant floodlight mushrooms' glowing cap, warm gold. Drawn as lit windows are, with a high subsurfaceRadius
# so it stays bright under the dusk sky; the boss script changes its colour (gold to orange-red in phase 3).
format 1

baseColor = (1, 0.82, 0.38)
roughness = 0.4
specular = 0.2
subsurfaceColor = (1, 0.78, 0.3)
subsurfaceRadius = 0.25
detailStrength = 0.05
detailScale = 0.08
colorVariation = 0.08
wetness = 0.1
variationColor = (1, 0.92, 0.6)
variationScale = 0.8
