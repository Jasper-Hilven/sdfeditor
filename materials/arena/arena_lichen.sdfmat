# Arena lichen: the pale yellow-green crust that furs the arena's stone, matte and flecked, used for the tops and ledges of the
# pillars and walls so the stone is not one colour.
format 1

baseColor = (0.68, 0.72, 0.4)
roughness = 0.9
specular = 0.1
subsurfaceColor = (0.8, 0.85, 0.4)
subsurfaceRadius = 0.04
detailStrength = 0.4
detailScale = 0.05
colorVariation = 0.25
wetness = 0
variationColor = (0.5, 0.58, 0.28)
variationScale = 0.5
speckleColor = (0.88, 0.88, 0.62)
speckleScale = 0.08
speckleDensity = 0.35
speckleSize = 0.3
