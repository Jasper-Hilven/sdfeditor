# Arena fungal stone: the grey-green stone the Champion's Arena is built from, pale and weathered, laid in big blocks with inked joints
# (the toon shader's stones pattern) and furred with lichen in patches. Cooler and greener than the castles' warm stone, so the
# stadium reads apart from them; no red or blue in it.
format 1

baseColor = (0.55, 0.58, 0.5)
roughness = 0.85
specular = 0.25
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0.3
detailScale = 0.08
colorVariation = 0.16
wetness = 0
variationColor = (0.42, 0.5, 0.34)
variationScale = 2.5
speckleColor = (0.78, 0.8, 0.62)
speckleScale = 0.18
speckleDensity = 0.2
speckleSize = 0.25
pattern stones size=0.9 grout=0.04
