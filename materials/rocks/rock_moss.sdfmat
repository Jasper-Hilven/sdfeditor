# Rock moss: a soft, cushiony moss in a deep, warm olive green, brighter yellow-green in large patches and flecked with pale
# sporophyte tips, matte and without glow, so it shares the stone's specular-only diffusion profile in Unity.
format 1

baseColor = (0.15, 0.27, 0.06)
roughness = 0.9
specular = 0.3
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0.4
detailScale = 0.02
colorVariation = 0.22
wetness = 0
variationColor = (0.34, 0.46, 0.1)
variationScale = 0.3
speckleColor = (0.62, 0.66, 0.3)
speckleScale = 0.03
speckleDensity = 0.3
speckleSize = 0.25
