# Fairy-ring dirt: the low band of earth the ring of mushrooms grows from, the fungal level's bare dirt
# (materials/ground/ground_dirt.sdfmat) with the same colours and the same patch and fleck sizes, the ring being metres across as
# the ground is, so the band reads as the ground heaped up a little and only the mushrooms draw the ring. Matte.
format 1

baseColor = (0.3, 0.2, 0.12)
roughness = 0.95
specular = 0.3
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.3
colorVariation = 0.22
wetness = 0
variationColor = (0.4, 0.3, 0.18)
variationScale = 6
speckleColor = (0.52, 0.47, 0.38)
speckleScale = 0.18
speckleDensity = 0.3
speckleSize = 0.18
