# Moss cushion: a dense, soft moss in a deep olive green turning teal in the shade, brighter yellow-green in large patches
# and flecked with pale tips, matte, glowing a little where light comes through it. For the moss turfs of the fungal level.
format 1

baseColor = (0.11, 0.3, 0.15)
roughness = 0.9
specular = 0.3
subsurfaceColor = (0.35, 0.7, 0.4)
subsurfaceRadius = 0.04
detailStrength = 0.4
detailScale = 0.02
colorVariation = 0.22
wetness = 0
variationColor = (0.22, 0.42, 0.13)
variationScale = 0.3
speckleColor = (0.5, 0.65, 0.38)
speckleScale = 0.03
speckleDensity = 0.3
speckleSize = 0.25
