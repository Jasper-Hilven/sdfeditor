# Mycena cap: a bioluminescent bonnet, a cold cyan-green that glows through itself (a high subsurfaceRadius, as the lit windows have
# it) and so keeps its brightness under the night sky while the rest is dimmed. The level's one accent.
format 1

baseColor = (0.2, 0.8, 0.62)
roughness = 0.4
specular = 0.3
subsurfaceColor = (0.45, 1, 0.8)
subsurfaceRadius = 0.3
detailStrength = 0.05
detailScale = 0.03
colorVariation = 0.08
wetness = 0.2
edgeColor = (0.7, 1, 0.9)
edgeThickness = 0.04
variationColor = (0.45, 1, 0.82)
variationScale = 0.2
