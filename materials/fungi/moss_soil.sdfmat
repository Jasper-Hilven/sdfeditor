# Moss soil: the dark humus the moss turfs grow from, nearly black olive brown, matte, so the turfs sit in the forest floor
# (the lowest 8 cm is tinted to the ground anyway).
format 1

baseColor = (0.1, 0.11, 0.07)
roughness = 0.95
specular = 0.3
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0.45
detailScale = 0.01
colorVariation = 0.2
wetness = 0
variationColor = (0.2, 0.2, 0.12)
variationScale = 0.12
speckleColor = (0.32, 0.3, 0.2)
speckleScale = 0.01
speckleDensity = 0.35
speckleSize = 0.25
