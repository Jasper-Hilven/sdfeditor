# Moss soil: the mound of earth the moss turfs grow from, the fungal level's bare dirt (materials/ground/ground_dirt.sdfmat): the
# same warm mid brown drifting to a drier tan, flecked with small pale pebbles, so the turfs sit in the ground (the lowest 8 cm is
# tinted to the ground anyway). Matte. The patches and flecks at the model's own scale.
format 1

baseColor = (0.3, 0.2, 0.12)
roughness = 0.95
specular = 0.3
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0.45
detailScale = 0.01
colorVariation = 0.22
wetness = 0
variationColor = (0.4, 0.3, 0.18)
variationScale = 0.12
speckleColor = (0.52, 0.47, 0.38)
speckleScale = 0.01
speckleDensity = 0.3
speckleSize = 0.25
