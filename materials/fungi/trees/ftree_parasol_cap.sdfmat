# A parasol mushroom's broad cap: a biscuit-brown skin that broke up into big shaggy cream-and-brown scales, darkest on the central
# boss. The scales are large flecks (speckleScale at tree scale), so they read from far away.
format 1

baseColor = (0.5, 0.35, 0.22)
roughness = 0.62
specular = 0.3
subsurfaceColor = (0.9, 0.6, 0.3)
subsurfaceRadius = 0.07
detailStrength = 0.25
detailScale = 0.1
colorVariation = 0.3
wetness = 0.05
edgeColor = (0.8, 0.68, 0.5)
edgeThickness = 0.12
variationColor = (0.33, 0.22, 0.14)
variationScale = 0.9
speckleColor = (0.86, 0.75, 0.58)
speckleScale = 0.45
speckleDensity = 0.55
speckleSize = 0.35
