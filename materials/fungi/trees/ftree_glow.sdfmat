# The edges of the gills of the woods' glowing trees: the cold cyan-green of bioluminescent mycena. Drawn as the lit windows are, with
# a high subsurfaceRadius, so under the night sky it keeps its brightness while the rest is dimmed.
format 1

baseColor = (0.45, 0.95, 0.78)
roughness = 0.4
specular = 0.3
subsurfaceColor = (0.3, 1, 0.72)
subsurfaceRadius = 0.25
detailStrength = 0.05
detailScale = 0.05
colorVariation = 0.05
wetness = 0.2
