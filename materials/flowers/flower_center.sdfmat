# Flower centre: the pollen-dusted heart of the daisy, a warm egg-yolk yellow shading to orange in patches and densely speckled
# with paler pollen grains, dry and velvety.
format 1

baseColor = (0.85, 0.6, 0.08)
roughness = 0.85
specular = 0.3
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0.4
detailScale = 0.005
colorVariation = 0.15
wetness = 0
variationColor = (0.85, 0.42, 0.06)
variationScale = 0.03
speckleColor = (1, 0.88, 0.45)
speckleScale = 0.006
speckleDensity = 0.5
speckleSize = 0.35
