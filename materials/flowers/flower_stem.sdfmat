# Flower stem: the stems and leaves of the flowers, a fresh, juicy mid green, a little bluer in large patches and fibrous along
# the stem, glowing yellow-green where light comes through the thin leaves. subsurfaceRadius matches the foliage's look.
format 1

baseColor = (0.2, 0.42, 0.12)
roughness = 0.6
specular = 0.35
subsurfaceColor = (0.5, 0.8, 0.2)
subsurfaceRadius = 0.1
detailStrength = 0.2
detailScale = 0.01
colorVariation = 0.15
wetness = 0
detailStretch = 3
detailAxis = (0, 1, 0)
edgeColor = (0.45, 0.7, 0.2)
edgeThickness = 0.008
variationColor = (0.16, 0.38, 0.16)
variationScale = 0.1
speckleColor = (0.42, 0.6, 0.2)
speckleScale = 0.012
speckleDensity = 0.2
speckleSize = 0.25
