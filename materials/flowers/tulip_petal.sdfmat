# Tulip petal: a glossy, saturated cartoon red, deepening to crimson in large patches. No subsurface, like the apple: HDRP has no free
# diffusion profile for a red glow, and without one the petal shares the specular-only profile.
format 1

baseColor = (0.62, 0.02, 0.04)
roughness = 0.4
specular = 0.5
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0.1
detailScale = 0.015
colorVariation = 0.12
wetness = 0
detailStretch = 3
detailAxis = (0, 1, 0)
edgeColor = (1, 0.35, 0.2)
edgeThickness = 0.008
variationColor = (0.5, 0.03, 0.08)
variationScale = 0.08
speckleColor = (1, 0.5, 0.3)
speckleScale = 0.012
speckleDensity = 0.1
speckleSize = 0.2
