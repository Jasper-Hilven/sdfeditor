# Tulip petal: a glossy, saturated cartoon red, deepening to crimson in large patches, glowing warm red-orange where light shines
# through the cup's thin petals. subsurfaceRadius is at flower scale.
format 1

baseColor = (0.62, 0.02, 0.04)
roughness = 0.4
specular = 0.5
subsurfaceColor = (1, 0.3, 0.15)
subsurfaceRadius = 0.02
detailStrength = 0.1
detailScale = 0.015
colorVariation = 0.12
wetness = 0
detailStretch = 3
detailAxis = (0, 1, 0)
edgeColor = (1, 0.35, 0.2)
edgeThickness = 0.008
variationColor = (0.5, 0.03, 0.08)
variationScale = 0.08
speckleColor = (1, 0.5, 0.3)
speckleScale = 0.012
speckleDensity = 0.1
speckleSize = 0.2
