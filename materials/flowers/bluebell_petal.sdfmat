# Bluebell petal: a cool, saturated violet blue, paler towards the bell mouths in large patches, waxy, glowing a clear blue
# where light shines through the bells. subsurfaceRadius is at flower scale.
format 1

baseColor = (0.14, 0.18, 0.62)
roughness = 0.45
specular = 0.35
subsurfaceColor = (0.3, 0.6, 1)
subsurfaceRadius = 0.02
detailStrength = 0.1
detailScale = 0.01
colorVariation = 0.12
wetness = 0
edgeColor = (0.5, 0.6, 1)
edgeThickness = 0.008
variationColor = (0.38, 0.3, 0.8)
variationScale = 0.04
speckleColor = (0.7, 0.75, 1)
speckleScale = 0.01
speckleDensity = 0.1
speckleSize = 0.2
