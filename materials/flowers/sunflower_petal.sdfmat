# Sunflower petal: a bright, warm golden yellow, deepening to orange towards the head in large patches and glowing warm
# where the sun comes through the long petals. subsurfaceRadius is at flower scale.
format 1

baseColor = (0.92, 0.68, 0.08)
roughness = 0.55
specular = 0.35
subsurfaceColor = (1, 0.75, 0.2)
subsurfaceRadius = 0.06
detailStrength = 0.15
detailScale = 0.015
colorVariation = 0.15
wetness = 0
detailStretch = 4
detailAxis = (0, 1, 0)
edgeColor = (1, 0.85, 0.3)
edgeThickness = 0.008
variationColor = (0.9, 0.48, 0.05)
variationScale = 0.08
speckleColor = (1, 0.9, 0.5)
speckleScale = 0.015
speckleDensity = 0.15
speckleSize = 0.2
