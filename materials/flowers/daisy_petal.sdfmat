# Daisy petal: a soft, creamy white, blushing faintly pink at the tips in large patches, matte and silky, glowing warm where light
# shines through the thin petals. subsurfaceRadius is at flower scale.
format 1

baseColor = (0.88, 0.86, 0.8)
roughness = 0.55
specular = 0.35
subsurfaceColor = (1, 0.8, 0.55)
subsurfaceRadius = 0.04
detailStrength = 0.1
detailScale = 0.01
colorVariation = 0.1
wetness = 0
edgeColor = (1, 0.85, 0.88)
edgeThickness = 0.008
variationColor = (0.9, 0.72, 0.74)
variationScale = 0.06
speckleColor = (1, 0.95, 0.85)
