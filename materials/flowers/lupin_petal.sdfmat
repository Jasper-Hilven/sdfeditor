# Lupin petal: the little flowers of the lupin spike, a rich purple drifting towards magenta-pink in large patches, with pale
# flecks where the banner petals catch the light, glowing violet through the thin petals. subsurfaceRadius is at flower scale.
format 1

baseColor = (0.48, 0.2, 0.7)
roughness = 0.5
specular = 0.35
subsurfaceColor = (0.4, 0.35, 1)
subsurfaceRadius = 0.02
detailStrength = 0.12
detailScale = 0.01
colorVariation = 0.18
wetness = 0
edgeColor = (0.75, 0.55, 1)
edgeThickness = 0.008
variationColor = (0.75, 0.25, 0.6)
variationScale = 0.06
speckleColor = (0.95, 0.85, 1)
speckleScale = 0.008
speckleDensity = 0.25
speckleSize = 0.25
