detailScale = 0.006
colorVariation = 0.15
wetness = 0
variationColor = (0.32, 0.18, 0.06)
variationScale = 0.04
speckleColor = (0.5, 0.38, 0.18)
speckleScale = 0.007
speckleDensity = 0.5
speckleSize = 0.35
