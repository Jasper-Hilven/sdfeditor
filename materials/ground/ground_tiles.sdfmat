# Ground tiles: the paving round the castles, the castle stone laid as flat flagstones, a warm sandy grey a little lighter than the
# boulders, some stones drifting to a cooler grey and others to a mossy olive, flecked with pale lichen. The grout between them is
# the edge colour, a dark earthy brown with moss in it. The stones' size and the grout's width are the region's (the level file's
# tiles line); each stone takes its own tone between the base and variation colours. Matte. Lengths are in metres over the level.
format 1

baseColor = (0.5, 0.46, 0.4)
roughness = 0.85
specular = 0.3
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.15
colorVariation = 0.12
wetness = 0
edgeColor = (0.16, 0.14, 0.08)
edgeThickness = 0
variationColor = (0.4, 0.41, 0.36)
variationScale = 3
speckleColor = (0.68, 0.68, 0.55)
speckleScale = 0.12
speckleDensity = 0.12
speckleSize = 0.25
