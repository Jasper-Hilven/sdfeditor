# Ground path: the footpath worn between the castles, packed sandy earth, paler and warmer than the dirt round the castles so the
# path reads as a line across the meadow, with darker damp patches along it, mottled finely, and scattered with small grey pebbles.
# Matte. Lengths are at ground scale, in metres over the level.
format 1

baseColor = (0.45, 0.34, 0.2)
roughness = 0.9
specular = 0.3
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.2
colorVariation = 0.18
wetness = 0
variationColor = (0.36, 0.26, 0.15)
variationScale = 4
speckleColor = (0.55, 0.53, 0.48)
speckleScale = 0.14
speckleDensity = 0.25
speckleSize = 0.2
