# Ground moss: the fungal level's floor seen as a whole, a dark, mossy olive-green turning teal in the broad shade, darker and bluer
# than the meadow's grass so the two levels read apart at a glance, mottled over a couple of metres and flecked with small, paler
# lichen-green cushions. Matte. Lengths are at ground scale: the ground is shaded in world space, so these are metres over the level.
format 1

baseColor = (0.07, 0.22, 0.12)
roughness = 0.92
specular = 0.25
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.5
colorVariation = 0.2
wetness = 0
variationColor = (0.05, 0.25, 0.22)
variationScale = 9
speckleColor = (0.16, 0.34, 0.2)
speckleScale = 0.3
speckleDensity = 0.35
speckleSize = 0.2
