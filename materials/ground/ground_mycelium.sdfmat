# Ground mycelium: the felted mat round the castles and before their gates, a pale cream like the castle stems, a little warmer
# in broad patches, finely speckled with threads of white and a cold hint of green. Plain, with no stones; the region's default
# edge wobble lets it fray out into the moss. Matte. Lengths are at ground scale, in metres over the level.
format 1

baseColor = (0.78, 0.72, 0.58)
roughness = 0.9
specular = 0.25
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.15
colorVariation = 0.1
wetness = 0
variationColor = (0.7, 0.66, 0.5)
variationScale = 3
speckleColor = (0.9, 0.88, 0.78)
speckleScale = 0.1
speckleDensity = 0.3
speckleSize = 0.15
