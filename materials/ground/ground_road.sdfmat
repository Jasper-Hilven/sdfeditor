# Ground road: the road printed on the play rug and the felt, a flat mid grey tarmac with a slight mottle and fine pale grit. A plain
# region: the ground shader draws no centre dashes. Matte. Lengths are in metres over the level.
format 1

baseColor = (0.44, 0.44, 0.47)
roughness = 0.9
specular = 0.15
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.2
colorVariation = 0.05
wetness = 0
variationColor = (0.39, 0.39, 0.43)
variationScale = 3
speckleColor = (0.56, 0.56, 0.58)
speckleScale = 0.1
speckleDensity = 0.2
speckleSize = 0.2
