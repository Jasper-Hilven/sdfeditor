# Ground oak: the kitchen island's worktop seen as a whole, honey oak, a little darker in broad soft streaks a few metres across and flecked with fine pale
# specks, a lacquered hardwood and not paint. Plain colours only: the 2.4 m staves along x and the knife marks are the ground shader's job (later).
# Slightly glossy. Lengths are in metres over the level (60 times life size).
format 1

baseColor = (0.78, 0.55, 0.28)
roughness = 0.55
specular = 0.35
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.2
colorVariation = 0.08
wetness = 0
variationColor = (0.68, 0.46, 0.22)
variationScale = 3
speckleColor = (0.86, 0.66, 0.38)
speckleScale = 0.12
speckleDensity = 0.12
speckleSize = 0.25
