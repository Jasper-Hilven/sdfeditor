# Ground playmat: the cream play rug under the train loop, a soft, warm off-white with a faint weave, drifting a little toward biscuit
# in wide patches and flecked with tiny darker tufts. Matte. Lengths are in metres over the level.
format 1

baseColor = (0.86, 0.8, 0.64)
roughness = 0.95
specular = 0.12
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.18
colorVariation = 0.06
wetness = 0
variationColor = (0.8, 0.73, 0.57)
variationScale = 5
speckleColor = (0.74, 0.66, 0.5)
speckleScale = 0.12
speckleDensity = 0.3
speckleSize = 0.25
