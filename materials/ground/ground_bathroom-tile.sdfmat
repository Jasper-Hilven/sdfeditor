# Ground bathroom tile: the bathroom floor, glazed tiles in warm white (#F3F0E8) drifting a little toward cream in wide patches, with a
# few pale specks. The base ground, which draws no pattern of its own (the ground shader's stones are an offset bond, not a square
# grid), so the 5 m tiles come from the grout region's strips laid on the world grid. A soft sheen. Lengths are in metres over the
# level (30 times life size).
format 1

baseColor = (0.899, 0.875, 0.812)
roughness = 0.5
specular = 0.35
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.2
colorVariation = 0.03
wetness = 0
variationColor = (0.86, 0.84, 0.78)
variationScale = 6
speckleColor = (0.8, 0.8, 0.75)
speckleScale = 0.3
speckleDensity = 0.08
speckleSize = 0.2
