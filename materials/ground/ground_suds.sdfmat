# Ground suds: a soap slick, a smeared white foam film over the floor with a bubble pattern (large, dense round pale grey-mint specks),
# glossy. Lengths are in metres over the level.
format 1

baseColor = (0.93, 0.95, 0.93)
roughness = 0.15
specular = 0.8
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.3
colorVariation = 0.03
wetness = 1
variationColor = (0.86, 0.9, 0.88)
variationScale = 1.5
speckleColor = (0.72, 0.8, 0.77)
speckleScale = 0.45
speckleDensity = 0.55
speckleSize = 0.5
