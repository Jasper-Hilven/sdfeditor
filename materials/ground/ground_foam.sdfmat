# Ground foam: the foam play mats under the castles, pale yellow rubber foam tiles laid like ground_tiles (the level file's foam line
# gives the tile size, 4 m, and the seam width): each tile its own tone between the base and variation colours, a deeper yellow-ochre
# in the seams (the edge colour), fine pale specks. Matte. Lengths are in metres over the level.
format 1

baseColor = (0.92, 0.85, 0.52)
roughness = 0.9
specular = 0.2
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.2
colorVariation = 0.05
wetness = 0
edgeColor = (0.66, 0.58, 0.3)
edgeThickness = 0
variationColor = (0.88, 0.8, 0.46)
variationScale = 3
speckleColor = (0.96, 0.9, 0.62)
speckleScale = 0.1
speckleDensity = 0.15
speckleSize = 0.2
