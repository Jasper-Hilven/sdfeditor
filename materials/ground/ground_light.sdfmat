# Ground light: the chessboard's light squares, the pale cream of a parasol mushroom's cap laid flat, drifting to a warmer biscuit
# in broad patches several metres across and flecked with small tan scales, so a square of it still reads as mushroom flesh from
# eye height. A little darker than the light pieces' caps, so the pieces stand out on it. Matte. Lengths are in metres over the level.
format 1

baseColor = (0.74, 0.64, 0.47)
roughness = 0.85
specular = 0.3
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.3
colorVariation = 0.12
wetness = 0
variationColor = (0.68, 0.55, 0.38)
variationScale = 5
speckleColor = (0.56, 0.42, 0.27)
speckleScale = 0.35
speckleDensity = 0.25
speckleSize = 0.25
