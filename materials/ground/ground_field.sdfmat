# Ground field: the arena's playing field inside the running track, the same raked spore-sand as the floor (ground_sand), a region of
# its own so that the track round it is a ring of darker sand. Matte. Lengths are at ground scale, in metres over the level.
format 1

baseColor = (0.74, 0.65, 0.46)
roughness = 0.95
specular = 0.2
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.3
colorVariation = 0.14
wetness = 0
variationColor = (0.66, 0.56, 0.38)
variationScale = 5
speckleColor = (0.86, 0.8, 0.62)
speckleScale = 0.16
speckleDensity = 0.3
speckleSize = 0.16
