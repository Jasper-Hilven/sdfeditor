# Ground felt: the toy chest's lining seen as a whole, sage-green felt, a little lighter in broad soft patches a few metres across and
# flecked with short paler fibres, so the floor reads as a woven, fuzzy pile and not as plain paint. Matte, no shine. Lengths are in
# metres over the level (60 times life size: the fibres are about 3 cm real).
format 1

baseColor = (0.45, 0.57, 0.4)
roughness = 0.97
specular = 0.1
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.2
colorVariation = 0.1
wetness = 0
variationColor = (0.5, 0.62, 0.45)
variationScale = 4
speckleColor = (0.58, 0.69, 0.5)
speckleScale = 0.14
speckleDensity = 0.5
speckleSize = 0.3
