# Ground dirt: the bare, trodden earth round the castles, a warm mid brown a little lighter than the turfs' soil so it reads at a
# distance, drifting to a drier, sandier tan in broad patches several metres across, mottled over a metre or so, and flecked with
# small pale pebbles. Matte. Lengths are at ground scale, in metres over the level (the ground is shaded in world space).
format 1

baseColor = (0.3, 0.2, 0.12)
roughness = 0.95
specular = 0.3
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.3
colorVariation = 0.22
wetness = 0
variationColor = (0.4, 0.3, 0.18)
variationScale = 6
speckleColor = (0.52, 0.47, 0.38)
speckleScale = 0.18
speckleDensity = 0.3
speckleSize = 0.18
