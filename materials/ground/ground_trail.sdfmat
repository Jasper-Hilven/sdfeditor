# Ground trail: the track trodden between the castles, pale spore dust and crushed fungus, a dusty grey-cream that reads as a line
# across the dark moss, with darker damp patches along it, mottled finely, and scattered with specks of olive spore powder.
# Matte. Lengths are at ground scale, in metres over the level.
format 1

baseColor = (0.5, 0.45, 0.34)
roughness = 0.9
specular = 0.25
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.2
colorVariation = 0.18
wetness = 0
variationColor = (0.36, 0.32, 0.22)
variationScale = 4
speckleColor = (0.62, 0.58, 0.42)
speckleScale = 0.14
speckleDensity = 0.25
speckleSize = 0.2
