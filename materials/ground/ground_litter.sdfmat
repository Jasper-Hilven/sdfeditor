# Ground litter: the dark humus and fallen leaves round each castle, a deep, damp brown a little redder than the moss is green,
# drifting to a lighter, drier leaf brown in patches several metres across, mottled finely, and flecked with small pale
# bits of rotten wood. Matte. Lengths are at ground scale, in metres over the level.
format 1

baseColor = (0.16, 0.1, 0.07)
roughness = 0.95
specular = 0.25
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.3
colorVariation = 0.22
wetness = 0
variationColor = (0.27, 0.17, 0.09)
variationScale = 6
speckleColor = (0.42, 0.34, 0.24)
speckleScale = 0.18
speckleDensity = 0.3
speckleSize = 0.18
