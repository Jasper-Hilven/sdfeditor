# Ground dark: the chessboard's dark squares, the deep chestnut-brown of a bay bolete's cap laid flat, drifting to a redder umber in
# broad patches several metres across and flecked with pale cream warts like the dark pieces' caps. Light enough to keep its toon
# bands in the shade. Matte. Lengths are in metres over the level.
format 1

baseColor = (0.3, 0.13, 0.07)
roughness = 0.85
specular = 0.3
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.3
colorVariation = 0.14
wetness = 0
variationColor = (0.36, 0.12, 0.06)
variationScale = 5
speckleColor = (0.62, 0.5, 0.36)
speckleScale = 0.4
speckleDensity = 0.18
speckleSize = 0.22
