# Ground puddle: standing water, flat pale grey-mint (never blue), no transparency and no reflection. A very low roughness and full
# specular give the toon shader's hard white highlight band; fine pale specks stand in for ripples (ripple rings themselves need the
# ground shader, not done). Lengths are in metres over the level.
format 1

baseColor = (0.701, 0.782, 0.737)
roughness = 0.03
specular = 1
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.3
colorVariation = 0.01
wetness = 1
variationColor = (0.66, 0.75, 0.7)
variationScale = 4
speckleColor = (0.85, 0.92, 0.89)
speckleScale = 0.5
speckleDensity = 0.1
speckleSize = 0.12
