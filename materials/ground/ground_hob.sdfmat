# Ground hob: the hob's black glass-ceramic top, near black with a cool tint and a hard shine, a faint variation so it is not flat paint. Plain colour (the printed
# control strip along the south edge is the ground shader's job, later). Lengths are in metres over the level.
format 1

baseColor = (0.07, 0.07, 0.085)
roughness = 0.2
specular = 0.8
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.2
colorVariation = 0.03
wetness = 0
variationColor = (0.1, 0.1, 0.12)
variationScale = 4
speckleColor = (0.16, 0.16, 0.18)
speckleScale = 0.1
speckleDensity = 0.05
speckleSize = 0.2
