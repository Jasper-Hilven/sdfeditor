# Ground planks: the kitchen worktop's oak laid as long staves, the oak of ground_oak with each board taking its own tone between the base and the variation colour. The seams between
# the boards are the edge colour, dark brown. The boards' width and the seams' width are the region's (the level file's planks line). Slightly glossy. Lengths are in metres over the level.
format 1

baseColor = (0.8, 0.57, 0.3)
roughness = 0.55
specular = 0.35
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.2
colorVariation = 0.08
wetness = 0
edgeColor = (0.3, 0.19, 0.08)
edgeThickness = 0
variationColor = (0.66, 0.44, 0.21)
variationScale = 3
speckleColor = (0.88, 0.68, 0.4)
speckleScale = 0.12
speckleDensity = 0.12
speckleSize = 0.25
