subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.3
colorVariation = 0.14
wetness = 0
variationColor = (0.66, 0.56, 0.38)
variationScale = 5
speckleColor = (0.86, 0.8, 0.62)
speckleScale = 0.16
speckleDensity = 0.3
speckleSize = 0.16
