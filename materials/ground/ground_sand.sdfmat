# Ground sand: the Champion's Arena's floor, pale raked spore-sand, a warm cream a shade darker than the paving of the corner and the
# box so the stone reads on it, drifting to a duskier tan in broad patches, finely mottled and flecked with pale grains. Matte.
# Lengths are at ground scale, in metres over the level.
format 1

baseColor = (0.74, 0.65, 0.46)
roughness = 0.95
specular = 0.2
