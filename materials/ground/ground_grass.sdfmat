# Ground grass: the meadow's turf seen as a whole, a fresh but slightly deeper green than the grass blades so the turfs on it stand
# out a little, drifting to a sunnier yellow-green in broad patches several metres across, mottled lighter and darker over a couple
# of metres, and flecked with small, slightly paler clover leaves. Matte. Lengths are at ground scale: the ground is shaded in world
# space, so these are metres over the level, not over a model.
format 1

baseColor = (0.17, 0.36, 0.08)
roughness = 0.9
specular = 0.3
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.5
colorVariation = 0.2
wetness = 0
variationColor = (0.3, 0.44, 0.09)
variationScale = 9
speckleColor = (0.27, 0.45, 0.11)
speckleScale = 0.3
speckleDensity = 0.35
speckleSize = 0.2
