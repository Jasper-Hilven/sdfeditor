# Ground rim: the band round the chessboard, its frame, a dark, damp forest-floor brown like rotting wood, mottled with mossy olive
# patches and flecked with small white threads of mycelium, darker than both kinds of square so the board's edge reads as a frame
# against the grass of the hills. Matte. Lengths are in metres over the level.
format 1

baseColor = (0.17, 0.12, 0.08)
roughness = 0.9
specular = 0.3
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.2
colorVariation = 0.2
wetness = 0
variationColor = (0.2, 0.2, 0.09)
variationScale = 3
speckleColor = (0.7, 0.68, 0.6)
speckleScale = 0.25
speckleDensity = 0.2
speckleSize = 0.18
