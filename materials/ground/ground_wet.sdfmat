# Ground wet: the damp floor, the tile a shade darker and glossier, one flat tone with a hard sheen. The region lies over the grout
# strips (it is a later region), so the joints are lost under it as water fills them. Lengths are in metres over the level.
format 1

baseColor = (0.74, 0.74, 0.69)
roughness = 0.2
specular = 0.7
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.2
colorVariation = 0.02
wetness = 1
variationColor = (0.7, 0.71, 0.67)
variationScale = 5
speckleColor = (0.82, 0.84, 0.8)
speckleScale = 0.3
speckleDensity = 0.05
speckleSize = 0.2
