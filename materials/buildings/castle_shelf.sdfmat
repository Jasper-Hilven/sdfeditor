# The shelf fungi of the castle's stairs: amanita_gills' pale cream, with gill lines running out from the keep's stem they grow
# on, inked by the toon shader (ticket 06)
format 1

baseColor = (0.93, 0.88, 0.74)
roughness = 0.7
specular = 0.35
subsurfaceColor = (1, 0.8, 0.55)
subsurfaceRadius = 0.06
detailStrength = 0.5
detailScale = 0.004
colorVariation = 0.06
detailStretch = 12
detailAxis = (0, 1, 0)
pattern gills size=0.09 grout=0.012
