# The fly agaric castle's curtain wall: the stem's grubby off-white flesh, as amanita_stem, with the same fine fibres running up it,
# inked by the toon shader (ticket 06). The bays are three stems packed along a core, so the fibres read as stems grown together:
# the wall is grown, not built, with no courses of stone (ticket 14.2)
format 1

baseColor = (0.76, 0.68, 0.52)
roughness = 0.68
specular = 0.3
subsurfaceColor = (1, 0.76, 0.48)
subsurfaceRadius = 0.06
detailStrength = 0.32
detailScale = 0.02
colorVariation = 0.32
detailStretch = 4
detailAxis = (0, 1, 0)
variationColor = (0.4, 0.29, 0.17)
variationScale = 0.07
speckleColor = (0.26, 0.19, 0.12)
speckleScale = 0.022
speckleDensity = 0.7
speckleSize = 0.26
wetness = 0.05
pattern fibres size=0.08 grout=0.012
