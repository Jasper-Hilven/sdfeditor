# Castle roof: the stone castle's pointed roofs, fired-clay tiles in a warm brick red with darker, weathered patches and a few
# orange flecks, matte, the one strong colour of the castle.
format 1

baseColor = (0.5, 0.14, 0.08)
roughness = 0.8
specular = 0.3
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0.25
detailScale = 0.1
colorVariation = 0.15
wetness = 0
variationColor = (0.34, 0.1, 0.07)
variationScale = 1.5
speckleColor = (0.7, 0.3, 0.12)
speckleScale = 0.2
speckleDensity = 0.15
speckleSize = 0.25
