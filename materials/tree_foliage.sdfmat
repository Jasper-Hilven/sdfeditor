# Canopy foliage: one solid mass of leaves rather than leaf cards, a warm sappy green that shades towards yellow in large soft
# patches and glows yellow-green where the sun shines through the thinner clumps. subsurfaceRadius is at tree scale.
format 1

baseColor = (0.34, 0.52, 0.14)
roughness = 0.7
specular = 0.35
subsurfaceColor = (0.62, 0.9, 0.2)
subsurfaceRadius = 0.15
detailStrength = 0.25
detailScale = 0.08
colorVariation = 0.2
wetness = 0
edgeColor = (0.6, 0.78, 0.18)
edgeThickness = 0.3
variationColor = (0.5, 0.6, 0.12)
variationScale = 0.8
speckleColor = (0.62, 0.74, 0.24)
speckleScale = 0.12
speckleDensity = 0.4
speckleSize = 0.3
