# Fruit tree leaves: a dense, slightly deeper green than the broadleaf canopy, so the red apples stand out against
# it, shading towards olive in large patches and glowing yellow-green through the thinner clumps. subsurfaceRadius is at tree
# scale.
format 1

baseColor = (0.2, 0.4, 0.12)
roughness = 0.72
specular = 0.32
subsurfaceColor = (0.45, 0.75, 0.18)
subsurfaceRadius = 0.12
detailStrength = 0.25
detailScale = 0.06
colorVariation = 0.18
wetness = 0
edgeColor = (0.52, 0.74, 0.2)
edgeThickness = 0.25
variationColor = (0.36, 0.5, 0.14)
variationScale = 0.6
speckleColor = (0.5, 0.68, 0.24)
speckleScale = 0.09
speckleDensity = 0.35
speckleSize = 0.3
