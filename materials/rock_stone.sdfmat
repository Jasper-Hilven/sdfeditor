# Boulder stone: a warm, sandy grey with a mossy olive cast in the hollows and pale lichen flecks, dry and matte, coarse grained,
# so it sits on the same warm forest floor as the mushrooms rather than reading as cold concrete
format 1

baseColor = (0.44, 0.41, 0.36)
roughness = 0.85
specular = 0.3
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0.35
detailScale = 0.03
colorVariation = 0.2
wetness = 0
variationColor = (0.42, 0.45, 0.27)
variationScale = 0.25
speckleColor = (0.66, 0.66, 0.52)
speckleScale = 0.05
speckleDensity = 0.2
speckleSize = 0.22
