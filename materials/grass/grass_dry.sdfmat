# Dry grass: sun-bleached straw, a warm wheat gold shading to a dusty tan in large patches and fibrous along the blades, glowing
# warm amber where light comes through them. edgeThickness is at grass scale.
format 1

baseColor = (0.62, 0.48, 0.22)
roughness = 0.75
specular = 0.3
subsurfaceColor = (1, 0.72, 0.3)
subsurfaceRadius = 0.06
detailStrength = 0.22
detailScale = 0.01
colorVariation = 0.2
wetness = 0
detailStretch = 4
detailAxis = (0, 1, 0)
edgeColor = (0.85, 0.7, 0.38)
edgeThickness = 0.006
variationColor = (0.5, 0.4, 0.2)
variationScale = 0.15
speckleColor = (0.8, 0.7, 0.45)
speckleScale = 0.012
speckleDensity = 0.2
speckleSize = 0.25
