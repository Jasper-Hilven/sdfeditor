detailStrength = 0.3
detailScale = 0.006
colorVariation = 0.15
wetness = 0
variationColor = (0.9, 0.6, 0.7)
variationScale = 0.03
speckleColor = (0.95, 0.7, 0.78)
speckleScale = 0.006
speckleDensity = 0.4
