# Grass soil: the dark, crumbly earth the turfs sit in, a rich warm brown with drier, paler patches and fine grit, matte, so the
# turfs sit on the forest floor rather than float on it.
format 1

baseColor = (0.22, 0.15, 0.1)
roughness = 0.95
specular = 0.3
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0.45
detailScale = 0.01
colorVariation = 0.2
wetness = 0
variationColor = (0.34, 0.26, 0.18)
variationScale = 0.12
speckleColor = (0.42, 0.36, 0.28)
speckleScale = 0.01
speckleDensity = 0.35
speckleSize = 0.25
