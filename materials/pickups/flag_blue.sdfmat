# Flag blue: the east side's flag cloth, a plain flat cornflower blue, the chanterelle scout's blue, so the flag reads as that side's
# colour at a distance: one colour, no flecks, pattern or noise. A little light glows through the cloth.
format 1

baseColor = (0.08, 0.3, 0.82)
roughness = 0.6
specular = 0.3
subsurfaceColor = (0.22, 0.48, 1)
subsurfaceRadius = 0.05
wetness = 0
