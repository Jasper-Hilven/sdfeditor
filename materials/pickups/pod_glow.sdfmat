# Pod glow: the ring inlaid in the top of a weapon pickup pedestal, a soft mint-teal that seems lit from inside (a strong subsurface
# glow in the toon look, so it stays bright in the shade) and tells the player something here can be picked up.
format 1

baseColor = (0.45, 0.95, 0.8)
roughness = 0.35
specular = 0.3
subsurfaceColor = (0.3, 1, 0.8)
subsurfaceRadius = 0.3
detailStrength = 0
detailScale = 0.05
colorVariation = 0.04
wetness = 0.2
