# Health white: the rim of a health pickup's cross, a clean painted white with a soft cool glow under it (a little subsurface, so
# the toon bands stay light in the shade) and a gloss like enamel. Toon bands and the ink line do the rest.
format 1

baseColor = (0.92, 0.93, 0.95)
roughness = 0.35
specular = 0.4
subsurfaceColor = (0.85, 0.9, 1)
subsurfaceRadius = 0.15
detailStrength = 0
detailScale = 0.05
colorVariation = 0.02
wetness = 0.1
