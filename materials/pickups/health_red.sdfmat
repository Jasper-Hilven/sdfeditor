# Health red: the face of a health pickup's cross, a saturated first-aid red that seems lit from inside (a strong red subsurface
# glow in the toon look, like the pods' ring), so the pickup reads at a distance and in the shade. Toon bands and the ink line do the
# rest.
format 1

baseColor = (0.9, 0.08, 0.08)
roughness = 0.35
specular = 0.4
subsurfaceColor = (1, 0.15, 0.1)
subsurfaceRadius = 0.3
detailStrength = 0
detailScale = 0.05
colorVariation = 0.03
wetness = 0.1
