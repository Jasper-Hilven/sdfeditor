# Flag red: the west side's flag cloth, a plain flat scarlet, the amanita scout's red, so the flag reads as that side's colour at a
# distance: one colour, no flecks, pattern or noise. A little light glows through the cloth.
format 1

baseColor = (0.76, 0.06, 0.035)
roughness = 0.6
specular = 0.3
subsurfaceColor = (1, 0.28, 0.12)
subsurfaceRadius = 0.05
wetness = 0
