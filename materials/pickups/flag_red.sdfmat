# Flag red: the west side's flag cloth, the amanita scout's glossy scarlet with white flecks like
# the remains of the fly agaric's veil, so the flag reads as that side's colour at a distance. A little light glows through the cloth.
format 1

baseColor = (0.72, 0.05, 0.025)
roughness = 0.6
specular = 0.3
subsurfaceColor = (1, 0.28, 0.12)
subsurfaceRadius = 0.05
detailStrength = 0.15
detailScale = 0.02
colorVariation = 0.12
wetness = 0
detailStretch = 4
detailAxis = (1, 0, 0)
edgeColor = (0.82, 0.12, 0.04)
edgeThickness = 0.02
variationColor = (0.8, 0.12, 0.03)
variationScale = 0.2
speckleColor = (0.96, 0.93, 0.84)
speckleScale = 0.075
speckleDensity = 0.35
speckleSize = 0.32
