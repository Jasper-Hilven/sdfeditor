# Pod stone: the pale, sandy stone of a weapon pickup pedestal, a shade lighter than the boulders so it reads as made, not grown,
# smooth and matte with a little wear, and a faint warm cast in the hollows. Toon bands and the ink line do the rest.
format 1

baseColor = (0.62, 0.58, 0.5)
roughness = 0.8
specular = 0.3
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0.15
detailScale = 0.05
colorVariation = 0.12
wetness = 0
variationColor = (0.55, 0.5, 0.38)
variationScale = 0.35
speckleColor = (0.78, 0.74, 0.62)
speckleScale = 0.06
speckleDensity = 0.12
speckleSize = 0.2
