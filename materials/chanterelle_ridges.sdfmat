# The false gills under a chanterelle's cap: a little darker than the cap, fibrous along their length
format 1

baseColor = (0.85, 0.42, 0.06)
roughness = 0.65
specular = 0.35
subsurfaceColor = (1, 0.48, 0.1)
subsurfaceRadius = 0.04
detailStrength = 0.3
detailScale = 0.01
colorVariation = 0.14
wetness = 0.3
detailStretch = 4
detailAxis = (0, 1, 0)
variationColor = (0.95, 0.66, 0.26)
variationScale = 0.16
# No speckles of their own, but the stem's speckle colour and spacing, so where the ridges blend into the stem below the cap
# the stem's flecks thin out instead of turning dark or changing size
speckleColor = (0.84, 0.62, 0.3)
speckleScale = 0.03
speckleDensity = 0
