# Bathroom ceiling: plain flat white paint (#F7F6F2), no pattern. The room shader (SdfRoomTiles.shader with a tile size of 0, picked by
# this name in LevelRoom.Looks) draws it as one colour in the toon bands. Matte. Colours are linear.
format 1

baseColor = (0.93, 0.922, 0.888)
roughness = 0.9
specular = 0.1
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.3
colorVariation = 0
wetness = 0
edgeColor = (0.578, 0.672, 0.624)
edgeThickness = 0
variationColor = (0.93, 0.922, 0.888)
variationScale = 5
speckleColor = (0, 0, 0)
speckleScale = 1
speckleDensity = 0
speckleSize = 0.2
