# Toy box wall: the inside of the toy chest, painted pine boards 6 m wide (10 cm real at 60 times) running up, a warm honey cream with
# the odd darker knot. The seams between the boards are the edge colour, a dark brown, edgeThickness metres wide. The room shader
# (SdfRoomPlanks.shader, picked by this name in LevelRoom) adds the boards' tone steps, the stencilled alphabet frieze and the dovetail
# joints at the corners. Matte. Lengths are in metres over the room.
format 1

baseColor = (0.6, 0.47, 0.28)
roughness = 0.85
specular = 0.25
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.3
colorVariation = 0.1
wetness = 0
edgeColor = (0.1, 0.06, 0.035)
edgeThickness = 0.2
variationColor = (0.52, 0.38, 0.22)
variationScale = 6
speckleColor = (0.34, 0.2, 0.1)
speckleScale = 2.2
speckleDensity = 0.12
speckleSize = 0.2
