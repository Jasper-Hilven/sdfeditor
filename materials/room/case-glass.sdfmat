# Computer case glass: the smoked side panel that is the room's lid, a very dark grey with the faintest cool cast. The edge colour is the
# frame's near black. The room shader (SdfRoomCase.shader, picked by this name in LevelRoom) adds the diagonal reflection streak and the soft
# warm glow patch. Matte, so the toon highlight does not make a blob on the huge quad (the streak is the reflection). Lengths are in metres over the room.
format 1

baseColor = (0.05, 0.054, 0.062)
roughness = 0.8
specular = 0.2
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.3
colorVariation = 0.04
wetness = 0
edgeColor = (0.02, 0.022, 0.026)
edgeThickness = 0.3
variationColor = (0.05, 0.055, 0.065)
variationScale = 20
speckleColor = (0.1, 0.105, 0.12)
speckleScale = 1
speckleDensity = 0
speckleSize = 0.1
