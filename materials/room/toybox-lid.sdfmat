# Toy box lid: the underside of the chest's lid, the same boards in a darker, warmer pine (unpainted, oiled), 6 m wide, with the dark
# seams between them as edgeColor, edgeThickness metres wide. The room shader (SdfRoomPlanks.shader, picked by this name in LevelRoom)
# adds the boards' tone steps and the two cross battens. Matte. Lengths are in metres over the room.
format 1

baseColor = (0.38, 0.21, 0.095)
roughness = 0.8
specular = 0.25
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.3
colorVariation = 0.1
wetness = 0
edgeColor = (0.07, 0.04, 0.02)
edgeThickness = 0.2
variationColor = (0.3, 0.16, 0.07)
variationScale = 5
speckleColor = (0.2, 0.1, 0.045)
speckleScale = 2.5
speckleDensity = 0.12
speckleSize = 0.2
