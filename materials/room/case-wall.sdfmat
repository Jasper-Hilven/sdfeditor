# Computer case wall: the inside of the PC case, dark gunmetal steel in big panels. The seams between the panels are the edge colour, a near
# black, edgeThickness metres wide; the variation colour is the brushed grain. The room shader (SdfRoomCase.shader, picked by this name in
# LevelRoom) adds the panel tone steps, the brushed streaks and the honeycomb vents on the west and east walls. Lengths are in metres over the room.
format 1

baseColor = (0.1, 0.108, 0.125)
roughness = 0.85
specular = 0.2
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0
detailScale = 0.3
colorVariation = 0.08
wetness = 0
edgeColor = (0.035, 0.04, 0.05)
edgeThickness = 0.16
variationColor = (0.07, 0.078, 0.095)
variationScale = 8
speckleColor = (0.2, 0.215, 0.24)
speckleScale = 1.2
speckleDensity = 0.05
speckleSize = 0.12
