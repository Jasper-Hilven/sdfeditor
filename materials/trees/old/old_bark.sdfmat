# Old bark: a dark, weathered grey-brown, deeply fibrous along the twisted trunk, with moss-green patches creeping over it and
# pale lichen flecks, so the old tree reads older and damper than the broadleaf tree's warm bark. Dry and matte.
format 1

baseColor = (0.22, 0.17, 0.13)
roughness = 0.85
specular = 0.3
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0.5
detailScale = 0.05
colorVariation = 0.22
wetness = 0
detailStretch = 6
detailAxis = (0, 1, 0)
variationColor = (0.24, 0.3, 0.12)
variationScale = 0.5
speckleColor = (0.5, 0.52, 0.38)
speckleScale = 0.07
speckleDensity = 0.3
speckleSize = 0.25
