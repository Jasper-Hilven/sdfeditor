# Willow leaves: the hanging curtains in a soft, pale yellow-green, a little dusty, shading to a deeper sage in large patches and
# glowing warm yellow where light comes through the thin tips of the strands. subsurfaceRadius is at tree scale.
format 1

baseColor = (0.4, 0.5, 0.15)
roughness = 0.72
specular = 0.32
subsurfaceColor = (0.68, 0.78, 0.24)
subsurfaceRadius = 0.15
detailStrength = 0.25
detailScale = 0.07
colorVariation = 0.18
wetness = 0
detailStretch = 4
detailAxis = (0, 1, 0)
edgeColor = (0.62, 0.72, 0.24)
edgeThickness = 0.3
variationColor = (0.3, 0.42, 0.14)
variationScale = 0.6
speckleColor = (0.62, 0.68, 0.3)
speckleScale = 0.1
speckleDensity = 0.35
speckleSize = 0.3
