# Birch leaves: a light, fresh spring green, brighter and yellower than the broadleaf canopy, drifting to lime in large patches
# and glowing a sunny yellow-green through the thin edges of the clumps. subsurfaceRadius is at tree scale.
format 1

baseColor = (0.34, 0.56, 0.13)
roughness = 0.7
specular = 0.35
subsurfaceColor = (0.6, 0.86, 0.22)
subsurfaceRadius = 0.15
detailStrength = 0.22
detailScale = 0.07
colorVariation = 0.18
wetness = 0
edgeColor = (0.58, 0.8, 0.2)
edgeThickness = 0.3
variationColor = (0.46, 0.64, 0.14)
variationScale = 0.7
speckleColor = (0.62, 0.8, 0.28)
speckleScale = 0.11
speckleDensity = 0.4
speckleSize = 0.3
