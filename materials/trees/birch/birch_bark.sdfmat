# Birch bark: a chalky warm white, faintly grey in large patches, with the dark lenticel marks of a birch as big, dense speckles
# painted on rather than modelled, so the slender trunk keeps its few triangles. Dry and matte.
format 1

baseColor = (0.86, 0.83, 0.75)
roughness = 0.8
specular = 0.3
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0.25
detailScale = 0.03
colorVariation = 0.12
wetness = 0
detailStretch = 4
detailAxis = (0, 1, 0)
variationColor = (0.68, 0.65, 0.58)
variationScale = 0.35
speckleColor = (0.17, 0.14, 0.12)
speckleScale = 0.1
speckleDensity = 0.55
speckleSize = 0.42
