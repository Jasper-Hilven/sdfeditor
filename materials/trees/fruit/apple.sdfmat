# Apple: a glossy cartoon red, shading to a warmer scarlet in large patches, with a few pale lenticel flecks. No subsurface: at
# 34 cm the glow barely shows, and without it the apple shares a specular-only diffusion profile in Unity instead of taking one
# of HDRP's 15 slots of its own; specular 0.5 matches an existing one.
format 1

baseColor = (0.62, 0.05, 0.04)
roughness = 0.35
specular = 0.5
subsurfaceColor = (0, 0, 0)
subsurfaceRadius = 0
detailStrength = 0.1
detailScale = 0.02
colorVariation = 0.08
wetness = 0
variationColor = (0.7, 0.1, 0.05)
variationScale = 0.08
speckleColor = (0.9, 0.62, 0.4)
speckleScale = 0.025
speckleDensity = 0.25
speckleSize = 0.2
