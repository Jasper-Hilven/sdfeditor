# A fly agaric's glossy scarlet, for the giant game pieces: dice, domino pips, card suits, chips and the hotel's roof. Smooth and
# lacquered like a toy rather than flecked like the scout's cap, as the white spots on the pieces are shapes of their own
format 1

baseColor = (0.74, 0.06, 0.03)
roughness = 0.32
specular = 0.5
subsurfaceColor = (1, 0.3, 0.12)
subsurfaceRadius = 0.12
detailStrength = 0.12
detailScale = 0.06
colorVariation = 0.12
wetness = 0.5
edgeColor = (0.92, 0.32, 0.06)
edgeThickness = 0.08
variationColor = (0.82, 0.14, 0.04)
variationScale = 0.5
