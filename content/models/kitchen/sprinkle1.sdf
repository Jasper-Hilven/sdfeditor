# Sprinkle 1: a mint sugar sprinkle (kitchen_sprinkle_mint), 0.36 m long and 0.1 m thick (60 times life size), a glossy little rod with round ends,
# lying on the worktop. Ground clutter: no collider.
format 1

# A fifth of the vertices its size would give it: a smooth rod
Detail detail=0.2
    Material material=kitchen_sprinkle_mint
        Capsule a=(-0.13, 0.05, 0) b=(0.13, 0.05, 0) radius=0.05
