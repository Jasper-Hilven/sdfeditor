# Cereal loop 0: a honey cereal loop (kitchen_cereal_honey), 0.78 m across and 0.25 m thick (60 times life size), a plain ring, lying flat on the
# worktop. Ground clutter: no collider.
format 1

# A fifth of the vertices its size would give it: a smooth ring
Detail detail=0.05
    Material material=kitchen_cereal_honey
        Translate translation=(0, 0.125, 0)
            Torus innerRadius=0.14 outerRadius=0.39
