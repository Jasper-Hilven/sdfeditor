# Sink 0: a double-depth steel washing-up bowl sunk into the worktop (60 times life size), origin at the middle of the bowl with the rim flush at y = 0. The rim (kitchen_steel)
# is 30 x 25 m outside and 1.5 m wide, so it meets the steel region round the hole; the bowl opening is 27 x 22 m, the size of the hole in the ground (28.1), and the bowl
# goes 13.2 m down (below Match.killDepth, 12 m, so a scout who falls in dies). On the floor 0.45 m of grey water (kitchen_water), a drain (kitchen_black) and a heap of suds
# (kitchen_suds). Mesh collider.
format 1
collider mesh

Detail detail=0.3
    Union
        Material material=kitchen_steel
            Union
                Subtraction
                    Union
                        Translate translation=(0, -0.75, 0)
                            RoundBox size=(15, 0.75, 12.5) roundness=0.3
                        Intersection
                            Translate translation=(0, -6.6, 0)
                                RoundBox size=(14, 10.6, 11.5) roundness=3.5
                            Translate translation=(0, -6.6, 0)
                                Box size=(20, 6.6, 20)
                    Translate translation=(0, 3.3, 0)
                        RoundBox size=(13.5, 16, 11) roundness=3
                Translate translation=(0, -12.68, 2)
                    CappedCylinder radius=1.7 height=0.1
        Material material=kitchen_water
            Translate translation=(0, -12.475, 0)
                RoundedCylinder radius=9.5 roundness=0.2 height=0.225
        Material material=kitchen_black
            Translate translation=(0, -12.55, 2)
                CappedCylinder radius=1.15 height=0.1
        Material material=kitchen_suds
            Intersection
                SmoothUnion smoothness=0.5
                    Translate translation=(-8.5, -12.4, -4.5)
                        Sphere radius=1.7
                    Translate translation=(-6.6, -12.3, -5.9)
                        Sphere radius=1.3
                    Translate translation=(-9.9, -12.5, -2.8)
                        Sphere radius=1.2
                    Translate translation=(-7.3, -11.6, -4)
                        Sphere radius=1.3
                    Translate translation=(-5.7, -12.5, -3.6)
                        Sphere radius=0.9
                    Translate translation=(-9.1, -11.7, -5.6)
                        Sphere radius=0.9
                    Translate translation=(-8, -10.9, -4.7)
                        Sphere radius=0.9
                Translate translation=(0, -7.7, 0)
                    Box size=(20, 5, 20)
