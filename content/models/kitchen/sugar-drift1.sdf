# Sugar drift 1: a low mound of salt crystals (kitchen_salt), 1.5 m across and 0.15 m high (60 times life size), spilled on the worktop, with a few
# bigger crystals on top that catch the light. Ground clutter: no collider.
format 1

# A fifth of the vertices its size would give it: a soft mound, the crystals holding the rest
Detail detail=0.35
    Material material=kitchen_salt
        Union
            Intersection
                Union
                    Translate translation=(0, -1.558, 0)
                        Sphere radius=1.708
                    Translate translation=(-0.2, -0.982, 0.15)
                        Sphere radius=1.102
                # Everything above the worktop (a box, as the bounds finder does not take a plane's infinite half-space well)
                Translate translation=(0, 1, 0)
                    Box size=(1, 1, 0.8)
            Translate translation=(0.05, 0.1, 0)
                Rotate rotation=(0.3, 0.6, 0.2)
                    RoundBox size=(0.04, 0.04, 0.04) roundness=0.01
            Translate translation=(-0.3, 0.1, 0.2)
                Rotate rotation=(0.3, 0.1, 0.2)
                    RoundBox size=(0.035, 0.035, 0.035) roundness=0.01
            Translate translation=(0.3, 0.1, -0.15)
                Rotate rotation=(0.3, 1.3, 0.2)
                    RoundBox size=(0.035, 0.035, 0.035) roundness=0.01
