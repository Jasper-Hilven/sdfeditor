# Rocking horse 0: a small wooden rocking horse (60 times life size), 12 m long along z, 4 m wide and 9 m tall, facing +z: cream painted body and legs, a peach mane,
# forelock and tail, a lilac saddle blanket, ink-bead eyes and two beech rockers (0.8 m thick arcs of a 9 m circle) that the four legs stand on. The belly is at
# y = 4 (a 3.2 m gap under the body between the legs and the rockers: the lane under it is free to run through along x). Landmark; mesh collider.
format 1
collider mesh

body =
    Translate translation=(0, 5.5, -0.5)
        Ellipsoid radii=(1.3, 1.5, 3.2)

# One rocker: an arc of a ring of radius 9 (axis along x) cut to the 12 m of the horse, 0.8 m thick
rocker =
    Intersection
        Subtraction
            Translate translation=(0, 9, 0)
                Rotate rotation=(0, 0, 1.5708)
                    CappedCylinder radius=9 height=0.4
            Translate translation=(0, 9, 0)
                Rotate rotation=(0, 0, 1.5708)
                    CappedCylinder radius=8.2 height=2
        Translate translation=(0, 1.5, 0)
            RoundBox size=(1, 1.7, 5.9) roundness=0.2

Detail detail=0.5
    Union
        Material material=toy_beech
            Union
                Translate translation=(1.6, 0, 0)
                    $rocker
                Translate translation=(-1.6, 0, 0)
                    $rocker
        Material material=toy_paint_cream
            Union
                $body
                Capsule a=(1.5, 1.3, 3.8) b=(1.0, 4.9, 2.4) radius=0.38
                Capsule a=(-1.5, 1.3, 3.8) b=(-1.0, 4.9, 2.4) radius=0.38
                Capsule a=(1.5, 1.3, -4.0) b=(1.0, 4.9, -2.6) radius=0.38
                Capsule a=(-1.5, 1.3, -4.0) b=(-1.0, 4.9, -2.6) radius=0.38
                ArbitraryRoundCone a=(0, 6.2, 2.0) b=(0, 7.4, 3.5) radiusA=1.1 radiusB=0.8
                Translate translation=(0, 7.5, 3.9)
                    Ellipsoid radii=(0.85, 0.95, 1.1)
                ArbitraryRoundCone a=(0, 7.5, 4.0) b=(0, 6.9, 5.4) radiusA=0.75 radiusB=0.5
                SymmetryX
                    Translate translation=(0.5, 8.4, 3.6)
                        Ellipsoid radii=(0.22, 0.5, 0.3)
        Material material=toy_paint_peach
            Union
                Capsule a=(0, 7.0, 1.3) b=(0, 8.1, 3.0) radius=0.36
                Capsule a=(0, 8.2, 3.2) b=(0, 8.7, 4.2) radius=0.26
                Capsule a=(0, 6.6, -3.5) b=(0, 5.2, -5.6) radius=0.35
                Translate translation=(0, 4.6, -5.8)
                    Ellipsoid radii=(0.4, 0.9, 0.4)
        Material material=toy_paint_lilac
            Intersection
                Translate translation=(0, 5.5, -0.5)
                    Ellipsoid radii=(1.45, 1.65, 3.35)
                Translate translation=(0, 6.5, -0.4)
                    Box size=(2, 1, 1.4)
        Material material=toy_bead_black
            SymmetryX
                Translate translation=(0.7, 7.85, 4.3)
                    Sphere radius=0.16
