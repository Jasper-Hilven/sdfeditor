# Toy train wagon: a wooden toy open wagon, 4.2 m long, 1.8 m wide and 1.8 m to the top of its sides (60 times life size): a peach-orange tub (toy_paint_peach) with a
# cream stripe round it, four yellow wheels, a coupler bar with a ball at each end. ORIGIN: the car's centre on the track, wheels' bottoms on y = 0, +z the
# direction of travel. Convex collider.
format 1
collider convex

Detail detail=0.15
    Union
        Material material=toy_paint_peach
            Subtraction
                Translate translation=(0, 1.2, 0)
                    RoundBox size=(0.9, 0.6, 2.1) roundness=0.06
                Translate translation=(0, 1.55, 0)
                    Box size=(0.75, 0.7, 1.95)
        Material material=toy_paint_cream
            Intersection
                Translate translation=(0, 1.2, 0)
                    RoundBox size=(0.9, 0.6, 2.1) roundness=0.06
                Translate translation=(0, 1.35, 0)
                    Box size=(2, 0.1, 3)
        Material material=toy_paint_yellow
            Union
                Translate translation=(-0.8, 0.45, -1.2)
                    Rotate rotation=(0, 0, 1.5708)
                        RoundedCylinder radius=0.45 roundness=0.04 height=0.1
                Translate translation=(-0.8, 0.45, 1.2)
                    Rotate rotation=(0, 0, 1.5708)
                        RoundedCylinder radius=0.45 roundness=0.04 height=0.1
                Translate translation=(0.8, 0.45, -1.2)
                    Rotate rotation=(0, 0, 1.5708)
                        RoundedCylinder radius=0.45 roundness=0.04 height=0.1
                Translate translation=(0.8, 0.45, 1.2)
                    Rotate rotation=(0, 0, 1.5708)
                        RoundedCylinder radius=0.45 roundness=0.04 height=0.1
        Material material=toy_tin
            Union
                Translate translation=(0, 0, 2.1)
                    Union
                        Translate translation=(0, 0.55, 0)
                            ArbitraryCappedCylinder a=(0, 0, 0) b=(0, 0, 0.4) radius=0.07
                        Translate translation=(0, 0.55, 0.4)
                            Sphere radius=0.12
                Translate translation=(0, 0, -2.1)
                    Rotate rotation=(0, 3.1416, 0)
                        Union
                            Translate translation=(0, 0.55, 0)
                                ArbitraryCappedCylinder a=(0, 0, 0) b=(0, 0, 0.4) radius=0.07
                            Translate translation=(0, 0.55, 0.4)
                                Sphere radius=0.12
