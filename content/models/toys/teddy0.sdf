# Teddy 0: a big teddy bear slumped against a wall (60 times life size), 13 m wide, 9 m deep and 16 m tall: sitting with its back to -z (the wall), its legs stuck out in
# front towards +z, the head lolling to one side, one arm in its lap and one hanging at its side. Honey-brown plush with cream plush on the muzzle, belly, paws, soles and
# the insides of the ears, a brown felt nose, mouth and knee patch, glossy black bead eyes (a painted toy face) and a cream button sewn on the tummy. The ear on the
# bear's right (-x) is chewed: a bite and a nibble out of its rim. Landmark; mesh collider.
format 1

# The head in its own frame (origin the middle of the head, face along +z), turned and tipped where it sits
head_honey =
    Union
        Ellipsoid radii=(3.8, 3.3, 3.4)
        Translate translation=(2.7, 2.7, -0.3)
            Ellipsoid radii=(1.2, 1.2, 0.8)
        Subtraction
            Subtraction
                Translate translation=(-2.7, 2.7, -0.3)
                    Ellipsoid radii=(1.2, 1.2, 0.8)
                Translate translation=(-3.5, 3.3, -0.3)
                    Sphere radius=0.7
            Translate translation=(-2.6, 3.8, -0.3)
                Sphere radius=0.4

head_cream =
    Union
        Translate translation=(0, -1.0, 2.5)
            Ellipsoid radii=(1.8, 1.4, 1.5)
        Translate translation=(2.7, 2.7, 0.3)
            Ellipsoid radii=(0.7, 0.7, 0.4)
        Subtraction
            Translate translation=(-2.7, 2.7, 0.3)
                Ellipsoid radii=(0.7, 0.7, 0.4)
            Translate translation=(-3.5, 3.3, 0.3)
                Sphere radius=0.7

head_felt =
    Union
        Translate translation=(0, -0.1, 3.95)
            Ellipsoid radii=(0.65, 0.5, 0.45)
        Capsule a=(0, -0.55, 3.95) b=(0, -1.25, 3.85) radius=0.08
        Capsule a=(0, -1.25, 3.85) b=(-0.7, -1.7, 3.55) radius=0.08
        Capsule a=(0, -1.25, 3.85) b=(0.7, -1.7, 3.55) radius=0.08

head_bead =
    SymmetryX
        Translate translation=(1.5, 1.0, 2.8)
            Sphere radius=0.5

Detail detail=0.5
    Union
        Material material=toy_plush_honey
            SmoothUnion smoothness=0.3
                SmoothUnion smoothness=0.8
                    Translate translation=(0, 3.3, -1.0)
                        Ellipsoid radii=(4.3, 3.3, 3.1)
                    Translate translation=(0, 6.8, -1.7)
                        Ellipsoid radii=(3.9, 4.5, 2.9)
                Capsule a=(3.3, 8.7, -1.5) b=(4.4, 4.4, 1.4) radius=1.3
                Capsule a=(-3.3, 8.2, -1.5) b=(-5.2, 3.0, 0.2) radius=1.3
                Capsule a=(2.5, 2.0, 0.2) b=(3.0, 2.0, 2.6) radius=1.9
                Capsule a=(-2.5, 2.0, 0.2) b=(-3.0, 2.0, 2.6) radius=1.9
        Material material=toy_plush_cream
            Union
                Translate translation=(0, 6.6, 1.0)
                    Ellipsoid radii=(2.4, 2.9, 0.9)
                Translate translation=(4.6, 3.8, 2.2)
                    Sphere radius=1.0
                Translate translation=(-5.6, 2.3, 0.9)
                    Sphere radius=1.0
                Translate translation=(3.0, 2.0, 3.9)
                    Ellipsoid radii=(1.4, 1.6, 0.7)
                Translate translation=(-3.0, 2.0, 3.9)
                    Ellipsoid radii=(1.4, 1.6, 0.7)
        Material material=toy_felt_brown
            Translate translation=(3.0, 2.2, 4.4)
                Ellipsoid radii=(0.8, 0.8, 0.25)
        Material material=toy_button
            Translate translation=(0, 6.0, 1.85)
                Rotate rotation=(1.5708, 0, 0)
                    RoundedCylinder radius=0.75 roundness=0.2 height=0.18
        Material material=toy_bead_black
            Union
                Translate translation=(0, 6.0, 2.1)
                    Union
                        Translate translation=(-0.2, 0.2, 0)
                            Sphere radius=0.1
                        Translate translation=(0.2, 0.2, 0)
                            Sphere radius=0.1
                        Translate translation=(-0.2, -0.2, 0)
                            Sphere radius=0.1
                        Translate translation=(0.2, -0.2, 0)
                            Sphere radius=0.1
        Material material=toy_plush_honey
            Translate translation=(0.6, 11.3, -0.3)
                Rotate rotation=(0.1, 0, 0.2)
                    $head_honey
        Material material=toy_plush_cream
            Translate translation=(0.6, 11.3, -0.3)
                Rotate rotation=(0.1, 0, 0.2)
                    $head_cream
        Material material=toy_felt_brown
            Translate translation=(0.6, 11.3, -0.3)
                Rotate rotation=(0.1, 0, 0.2)
                    $head_felt
        Material material=toy_bead_black
            Translate translation=(0.6, 11.3, -0.3)
                Rotate rotation=(0.1, 0, 0.2)
                    $head_bead
