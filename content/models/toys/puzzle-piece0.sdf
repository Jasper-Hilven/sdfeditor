# Puzzle piece 0: a jigsaw piece 1.2 m across and 12 cm thick (60 times life size), a mint green picture side up, a cream sun disc printed on it, a knob on the east and north edges and a socket on the west and south.
# Card with a grey cut edge. Ground clutter: no collider, scattered on the floor.
format 1

# A shape that sits flat: the card with its knobs and sockets, centred on the origin, the thickness along y
piece =
    Subtraction
        Union
            RoundBox size=(0.47, 0.06, 0.47) roundness=0.02
            Translate translation=(0.49, 0, 0)
                CappedCylinder radius=0.07 height=0.06
            Translate translation=(0.56, 0, 0)
                CappedCylinder radius=0.15 height=0.06
            Translate translation=(0, 0, 0.49)
                CappedCylinder radius=0.07 height=0.06
            Translate translation=(0, 0, 0.56)
                CappedCylinder radius=0.15 height=0.06
        Union
            Translate translation=(-0.38, 0, 0)
                CappedCylinder radius=0.15 height=0.1
            Translate translation=(-0.44, 0, 0)
                Box size=(0.08, 0.1, 0.07)
            Translate translation=(0, 0, -0.38)
                CappedCylinder radius=0.15 height=0.1
            Translate translation=(0, 0, -0.44)
                Box size=(0.07, 0.1, 0.08)

# About a fifth of the vertices its size would give it: a flat piece, a few hundred triangles
Detail detail=0.1
    # Shifted so the knobs and sockets balance round the origin, and so the piece rests on y = 0
    Translate translation=(-0.12, 0.06, -0.12)
        Union
            # The grey card, with the picture's thin layer cut off the printed face
            Material material=toy_card_back
                Subtraction
                    $piece
                    Translate translation=(0, 0.0575, 0)
                        Box size=(2, 0.0125, 2)
            # The printed picture layer
            Material material=toy_card_mint
                Intersection
                    $piece
                    Translate translation=(0, 0.0575, 0)
                        Box size=(2, 0.0125, 2)
            # A cream sun printed on it, flush
            Material material=toy_card_motif
                Intersection
                    $piece
                    CappedCylinder radius=0.2 height=0.1
                    Translate translation=(0, 0.0575, 0)
                        Box size=(2, 0.0125, 2)
