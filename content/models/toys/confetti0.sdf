# Confetti 0: a patch of 9 paper dots and four-point stars in pastel yellow paper (toy_paper_yellow), each about 0.3 m across and 2 cm thick (60 times
# life size), scattered over a patch 1.2 m wide where a party popper went off. One colour. Ground clutter: no collider.
format 1

# A paper dot and a paper star, lying flat: a thin sheet extruded from a 2D shape, 1 cm either side of the floor line
dot =
    Rotate rotation=(1.5707964, 0, 0)
        Extrusion height=0.01
            Circle radius=0.13
star =
    Rotate rotation=(1.5707964, 0, 0)
        Extrusion height=0.01
            Union2D
                Rhombus2D size=(0.16, 0.06)
                Rotate2D angle=1.5707964
                    Rhombus2D size=(0.16, 0.06)

# A fifth of the vertices its size would give it: flat sheets, a few hundred triangles
Detail detail=0.3
    Translate translation=(0, 0.01, 0)
        Material material=toy_paper_yellow
            Union
                Translate translation=(0.13, 0, 0.12)
                    Rotate rotation=(0, 2.54, 0)
                        $dot
                Translate translation=(-0.13, 0, -0.19)
                    Rotate rotation=(0, 3.08, 0)
                        $star
                Translate translation=(-0.41, 0, -0.44)
                    Rotate rotation=(0, 1.93, 0)
                        $dot
                Translate translation=(-0.48, 0, -0.19)
                    Rotate rotation=(0, 1.66, 0)
                        $dot
                Translate translation=(0.11, 0, -0.17)
                    Rotate rotation=(0, 0.76, 0)
                        $star
                Translate translation=(-0.19, 0, -0.45)
                    Rotate rotation=(0, 1.38, 0)
                        $dot
                Translate translation=(-0.12, 0, 0.15)
                    Rotate rotation=(0, 2.01, 0)
                        $dot
                Translate translation=(-0.45, 0, 0.16)
                    Rotate rotation=(0, 1.44, 0)
                        $star
                Translate translation=(-0.47, 0, 0.49)
                    Rotate rotation=(0, 3.13, 0)
                        $dot
