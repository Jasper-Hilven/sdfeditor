# Brick 0: a 2 x 4 toy brick of pastel yellow plastic (toy_plastic_yellow), 1.92 m long, 0.96 m wide and 0.68 m tall including its eight round studs
# (60 times life size), lying on the floor along x. Knee cover: jump on it or go round; convex collider.
format 1

stud =
    RoundedCylinder radius=0.145 roundness=0.02 height=0.05

# An eighth of the vertices its size would give it: a plain block with eight studs
Detail detail=0.63
    Material material=toy_plastic_yellow
        Union
            Translate translation=(0, 0.29, 0)
                RoundBox size=(0.96, 0.29, 0.48) roundness=0.03
            # The studs, two rows of four
            SymmetryXZ
                Union
                    Translate translation=(0.24, 0.63, 0.24)
                        $stud
                    Translate translation=(0.72, 0.63, 0.24)
                        $stud
