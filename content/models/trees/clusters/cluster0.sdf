# Crest cluster 0: a mound of broadleaf crowns, six crowns of the broadleaf trees (canopy, canopy_tall, canopy_wide) grown
# together over three short, stout trunks into one soft blob mass, about 9 m across and 7 m tall.
# Drawn instanced behind the hills' crest, seen from 30 m and more, so it needs no detail finer than its clumps. Its trunks
# reach 1.5 m below its base, so it stands on a slope without showing its foot.
format 1
collider capsule

# Fewer vertices than its size would give it: a big, simple form seen from far away
Detail detail=0.35
    # Only what is above 1.5 m below its base. Inside an intersection the crowns stay in one mesh with the trunks rather than
    # being meshes of their own, so the whole cluster is one draw per level of detail
    Intersection
        Translate translation=(0, 10, 0)
            Box size=(12, 11.5, 12)
        SmoothUnion smoothness=0.4
            Material material=tree_bark
                SmoothUnion smoothness=0.3
                    ArbitraryRoundCone a=(-1.6, -1.5, 0.3) b=(-1.3, 3, 0.2) radiusA=0.55 radiusB=0.35
                    ArbitraryRoundCone a=(1.5, -1.5, -0.4) b=(1.2, 3.2, -0.2) radiusA=0.5 radiusB=0.3
                    ArbitraryRoundCone a=(0.2, -1.5, 1.4) b=(0.1, 2.6, 1.1) radiusA=0.45 radiusB=0.3
            Material material=tree_foliage
                SmoothUnion smoothness=0.4
                    Translate translation=(-1.8, 4, 0.2)
                        Scale scale=(1.5, 1.5, 1.5)
                            Part part=canopy
                    Translate translation=(1.7, 4.6, -0.5)
                        Scale scale=(1.4, 1.4, 1.4)
                            Part part=canopy_tall
                    Translate translation=(0.1, 3.4, 1.6)
                        Scale scale=(1.2, 1.2, 1.2)
                            Part part=canopy_wide
                    Translate translation=(0.2, 5.6, -0.2)
                        Scale scale=(1.3, 1.3, 1.3)
                            Part part=canopy
                    Translate translation=(-3, 3, -1.2)
                        Scale scale=(1.1, 1.1, 1.1)
                            Part part=canopy
                    Translate translation=(3.1, 3.1, 1)
                        Scale scale=(1.1, 1.1, 1.1)
                            Part part=canopy_tall
