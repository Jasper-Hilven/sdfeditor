# Crest cluster 3: a knot of old trees, five flat cloud-pad crowns (old_canopy, old_canopy_tall, old_canopy_windswept) stepping up
# over three thick, leaning trunks into one layered mass, the oldest part of the woods, about 10 m across and 6 m tall.
# Drawn instanced behind the hills' crest, seen from 30 m and more, so it needs no detail finer than its clumps. Its trunks
# reach 1.5 m below its base, so it stands on a slope without showing its foot.
format 1
collider capsule

# Fewer vertices than its size would give it: a big, simple form seen from far away
Detail detail=0.35
    # Only what is above 1.5 m below its base. Inside an intersection the crowns stay in one mesh with the trunks rather than
    # being meshes of their own, so the whole cluster is one draw per level of detail
    Intersection
        Translate translation=(0, 10, 0)
            Box size=(12, 11.5, 12)
        SmoothUnion smoothness=0.3
            Material material=old_bark
                SmoothUnion smoothness=0.3
                    ArbitraryRoundCone a=(-1.5, -1.5, 0) b=(-1, 3.4, 0.2) radiusA=0.65 radiusB=0.4
                    ArbitraryRoundCone a=(2, -1.5, 0.8) b=(2.4, 3, 0.5) radiusA=0.55 radiusB=0.35
                    ArbitraryRoundCone a=(0.5, -1.5, -1.8) b=(0.3, 2.8, -1.5) radiusA=0.5 radiusB=0.32
            Material material=old_foliage
                SmoothUnion smoothness=0.3
                    Translate translation=(-1.2, 3.9, 0.3)
                        Scale scale=(1.35, 1.35, 1.35)
                            Part part=old_canopy
                    Translate translation=(2.3, 4.2, 0.5)
                        Scale scale=(1.25, 1.25, 1.25)
                            Part part=old_canopy_tall
                    Translate translation=(0.2, 3.3, -1.7)
                        Scale scale=(1.3, 1.3, 1.3)
                            Part part=old_canopy_windswept
                    Translate translation=(0.6, 5.2, -0.2)
                        Scale scale=(1, 1, 1)
                            Part part=old_canopy
                    Translate translation=(-3.1, 2.8, -0.8)
                        Scale scale=(1, 1, 1)
                            Part part=old_canopy_windswept
