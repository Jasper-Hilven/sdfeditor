# Crest cluster 6: a birch grove, six tall, narrow birch crowns (birch_crown, birch_crown_young) side by side on six white trunks,
# packed into one bumpy wall of leaves, about 8 m across and 8 m tall.
# Drawn instanced behind the hills' crest, seen from 30 m and more, so it needs no detail finer than its clumps. Its trunks
# reach 1.5 m below its base, so it stands on a slope without showing its foot.
format 1
collider capsule

# Fewer vertices than its size would give it: a big, simple form seen from far away
Detail detail=0.35
    # Only what is above 1.5 m below its base. Inside an intersection the crowns stay in one mesh with the trunks rather than
    # being meshes of their own, so the whole cluster is one draw per level of detail
    Intersection
        Translate translation=(0, 10, 0)
            Box size=(12, 11.5, 12)
        SmoothUnion smoothness=0.35
            Material material=birch_bark
                SmoothUnion smoothness=0.3
                    ArbitraryRoundCone a=(-2.4, -1.5, 0.3) b=(-2.4, 3.6, 0.3) radiusA=0.3 radiusB=0.2
                    ArbitraryRoundCone a=(-0.8, -1.5, -0.8) b=(-0.8, 4, -0.8) radiusA=0.3 radiusB=0.2
                    ArbitraryRoundCone a=(0.9, -1.5, 0.6) b=(0.9, 3.8, 0.6) radiusA=0.3 radiusB=0.2
                    ArbitraryRoundCone a=(2.5, -1.5, -0.4) b=(2.5, 3.4, -0.4) radiusA=0.28 radiusB=0.18
                    ArbitraryRoundCone a=(0, -1.5, 2) b=(0, 3, 2) radiusA=0.26 radiusB=0.18
                    ArbitraryRoundCone a=(-1.6, -1.5, -2.2) b=(-1.6, 3, -2.2) radiusA=0.26 radiusB=0.18
            Material material=birch_leaves
                SmoothUnion smoothness=0.35
                    Translate translation=(-2.4, 4.6, 0.3)
                        Scale scale=(1.3, 1.3, 1.3)
                            Part part=birch_crown
                    Translate translation=(-0.8, 5.2, -0.8)
                        Scale scale=(1.4, 1.4, 1.4)
                            Part part=birch_crown
                    Translate translation=(0.9, 5, 0.6)
                        Scale scale=(1.35, 1.35, 1.35)
                            Part part=birch_crown
                    Translate translation=(2.5, 4.4, -0.4)
                        Scale scale=(1.3, 1.3, 1.3)
                            Part part=birch_crown_young
                    Translate translation=(0, 4, 2)
                        Scale scale=(1.25, 1.25, 1.25)
                            Part part=birch_crown_young
                    Translate translation=(-1.6, 4, -2.2)
                        Scale scale=(1.2, 1.2, 1.2)
                            Part part=birch_crown_young
