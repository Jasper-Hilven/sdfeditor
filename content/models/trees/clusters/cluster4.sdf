# Crest cluster 4: a mixed copse, three broadleaf crowns (canopy, canopy_tall) round two spruces (pine_canopy_tall, pine_canopy)
# over five trunks, the spruces' spires standing out of the round mass, about 10 m across and 9 m tall.
# Drawn instanced behind the hills' crest, seen from 30 m and more, so it needs no detail finer than its clumps. Its trunks
# reach 1.5 m below its base, so it stands on a slope without showing its foot.
format 1
collider capsule

# Fewer vertices than its size would give it: a big, simple form seen from far away
Detail detail=0.3
    # Only what is above 1.5 m below its base. Inside an intersection the crowns stay in one mesh with the trunks rather than
    # being meshes of their own, so the whole cluster is one draw per level of detail
    Intersection
        Translate translation=(0, 10, 0)
            Box size=(12, 11.5, 12)
        SmoothUnion smoothness=0.35
            Material material=tree_bark
                SmoothUnion smoothness=0.3
                    ArbitraryRoundCone a=(-2.4, -1.5, 0.4) b=(-2.2, 3, 0.3) radiusA=0.5 radiusB=0.32
                    ArbitraryRoundCone a=(2.6, -1.5, -0.2) b=(2.4, 3.2, -0.1) radiusA=0.48 radiusB=0.3
                    ArbitraryRoundCone a=(0, -1.5, 1.8) b=(0, 2.6, 1.6) radiusA=0.42 radiusB=0.28
                    ArbitraryRoundCone a=(0.4, -1.5, -1.2) b=(0.4, 2, -1.2) radiusA=0.32 radiusB=0.22
                    ArbitraryRoundCone a=(-0.9, -1.5, 0.2) b=(-0.9, 2, 0.2) radiusA=0.3 radiusB=0.2
            Material material=tree_foliage
                SmoothUnion smoothness=0.35
                    Translate translation=(-2.4, 4.2, 0.3)
                        Scale scale=(1.4, 1.4, 1.4)
                            Part part=canopy
                    Translate translation=(2.5, 4.6, -0.1)
                        Scale scale=(1.3, 1.3, 1.3)
                            Part part=canopy_tall
                    Translate translation=(0, 3.6, 1.7)
                        Scale scale=(1.2, 1.2, 1.2)
                            Part part=canopy
            Material material=pine_needles
                SmoothUnion smoothness=0.2
                    Translate translation=(0.4, 1.4, -1.2)
                        Scale scale=(1.05, 1.05, 1.05)
                            Part part=pine_canopy_tall
                    Translate translation=(-0.9, 1.6, 0.2)
                        Scale scale=(1, 1, 1)
                            Part part=pine_canopy
