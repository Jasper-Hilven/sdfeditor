# Crest cluster 5: a curtain of willows, a double willow crown (willow_crown_double) and two single ones (willow_crown,
# willow_crown_tall) over four trunks, their hanging curtains run together into one drooping mass, about 10 m across and 6 m tall.
# Drawn instanced behind the hills' crest, seen from 30 m and more, so it needs no detail finer than its clumps. Its trunks
# reach 1.5 m below its base, so it stands on a slope without showing its foot.
format 1
collider capsule

# Fewer vertices than its size would give it: a big, simple form seen from far away
Detail detail=0.2
    # Only what is above 1.5 m below its base. Inside an intersection the crowns stay in one mesh with the trunks rather than
    # being meshes of their own, so the whole cluster is one draw per level of detail
    Intersection
        Translate translation=(0, 10, 0)
            Box size=(12, 11.5, 12)
        SmoothUnion smoothness=0.3
            Material material=tree_bark
                SmoothUnion smoothness=0.3
                    ArbitraryRoundCone a=(-2, -1.5, 0) b=(-2, 3.8, 0.1) radiusA=0.5 radiusB=0.32
                    ArbitraryRoundCone a=(2.3, -1.5, 0.5) b=(2.2, 4, 0.4) radiusA=0.48 radiusB=0.3
                    ArbitraryRoundCone a=(0.3, -1.5, -1.6) b=(0.3, 4.2, -1.4) radiusA=0.45 radiusB=0.3
                    ArbitraryRoundCone a=(-0.2, -1.5, 1.4) b=(-0.2, 3.4, 1.2) radiusA=0.4 radiusB=0.28
            Material material=willow_leaves
                SmoothUnion smoothness=0.3
                    Translate translation=(-0.6, 4.4, 0.4)
                        Scale scale=(1.25, 1.25, 1.25)
                            Part part=willow_crown_double
                    Translate translation=(2.6, 4.6, -0.6)
                        Scale scale=(1.15, 1.15, 1.15)
                            Part part=willow_crown
                    Translate translation=(0.4, 5.2, -1.6)
                        Scale scale=(1.1, 1.1, 1.1)
                            Part part=willow_crown_tall
                    Translate translation=(-3, 4, -1.2)
                        Scale scale=(0.95, 0.95, 0.95)
                            Part part=willow_crown
