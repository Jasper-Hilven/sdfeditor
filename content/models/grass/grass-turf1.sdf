# Grass turf 1: a wide, low patch of lawn-like sod about 1.1 m across and 0.25 m tall, a flat cushion of dark earth with a mat of
# green over its top, bristling with a hundred and twenty short, stubby blades. A ground cover to scatter at the feet of trees and rocks.
format 1

# The sod, used twice: as the earth, and grown a little for the green mat over its top
sod =
    Distort amount=0.012 frequency=6
        Intersection
            Ellipsoid radii=(0.56, 0.08, 0.46)
            # The ground: only what is above it
            Translate translation=(0, 0.2, 0)
                Box size=(0.7, 0.2, 0.6)

# Four times the vertices its size would give it: the blades are small next to the patch's size
Detail detail=4
    Union
        Material material=grass_soil
            $sod
        # The green mat: the sod grown by a centimetre, kept only above a wavy line near its top, so earth shows round the rim
        Material material=grass_blade
            Union
                Intersection
                    Round radius=0.01
                        $sod
                    Distort amount=0.01 frequency=8
                        Plane normal=(0, -1, 0) height=0.045
                # The short blades, standing up out of the mat
                ArbitraryRoundCone a=(0.203, 0.05, 0.274) b=(0.209, 0.123, 0.289) radiusA=0.022 radiusB=0.014
                ArbitraryRoundCone a=(0.209, 0.123, 0.289) b=(0.22, 0.19, 0.319) radiusA=0.014 radiusB=0.006
