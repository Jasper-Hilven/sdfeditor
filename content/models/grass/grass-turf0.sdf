# Grass turf 0: a round, springy tuft of meadow grass about 0.45 m tall and 0.5 m across, fourteen fat, leaf-shaped blades fanning
# up and out of a small mound of dark earth, five tall ones standing in the middle and nine round them leaning furthest out, so it
# reads as a fountain of green. Few, chunky blades rather than many thin ones, so it stays light enough to scatter by the hundreds.
format 1

# Three quarters of the vertices its size would give it: the blades are fat enough to keep their shape on the coarser grid
Detail detail=0.75
    Union
        # The mound of earth the blades grow out of, cut flat at the ground
        Material material=grass_soil
            Distort amount=0.008 frequency=12
                Intersection
                    Ellipsoid radii=(0.15, 0.05, 0.14)
                    Translate translation=(0, 0.1, 0)
                        Box size=(0.2, 0.1, 0.2)
        # The blades, each a round stem with a fat, pointed leaf leaning further out above it, a plain union so each keeps its own
        # outline; they start inside the mound
        Material material=grass_blade
            SmoothUnion smoothness=0.006
                ArbitraryRoundCone a=(0.025, 0.03, 0.004) b=(0.045, 0.221, 0.008) radiusA=0.022 radiusB=0.017
                VesicaSegment a=(0.039, 0.183, 0.007) b=(0.086, 0.412, 0.015) width=0.019
                ArbitraryRoundCone a=(-0.001, 0.03, 0.025) b=(-0.002, 0.212, 0.046) radiusA=0.022 radiusB=0.017
                VesicaSegment a=(-0.002, 0.176, 0.04) b=(-0.003, 0.394, 0.09) width=0.019
                ArbitraryRoundCone a=(-0.021, 0.03, 0.014) b=(-0.041, 0.218, 0.027) radiusA=0.022 radiusB=0.017
                VesicaSegment a=(-0.035, 0.18, 0.023) b=(-0.083, 0.406, 0.053) width=0.019
                ArbitraryRoundCone a=(-0.017, 0.03, -0.018) b=(-0.036, 0.224, -0.037) radiusA=0.022 radiusB=0.017
                VesicaSegment a=(-0.03, 0.185, -0.031) b=(-0.073, 0.418, -0.075) width=0.019
                ArbitraryRoundCone a=(0.018, 0.03, -0.018) b=(0.031, 0.229, -0.032) radiusA=0.022 radiusB=0.017
                VesicaSegment a=(0.027, 0.189, -0.027) b=(0.059, 0.428, -0.06) width=0.019
                ArbitraryRoundCone a=(0.06, 0.03, -0.006) b=(0.13, 0.177, -0.014) radiusA=0.022 radiusB=0.016
                VesicaSegment a=(0.109, 0.148, -0.011) b=(0.273, 0.301, -0.029) width=0.018
                ArbitraryRoundCone a=(0.046, 0.03, 0.039) b=(0.101, 0.17, 0.086) radiusA=0.022 radiusB=0.016
                VesicaSegment a=(0.085, 0.143, 0.072) b=(0.215, 0.287, 0.183) width=0.018
                ArbitraryRoundCone a=(0.018, 0.03, 0.057) b=(0.04, 0.167, 0.127) radiusA=0.022 radiusB=0.016
                VesicaSegment a=(0.034, 0.141, 0.106) b=(0.085, 0.281, 0.27) width=0.018
                ArbitraryRoundCone a=(-0.027, 0.03, 0.054) b=(-0.052, 0.177, 0.104) radiusA=0.022 radiusB=0.016
                VesicaSegment a=(-0.045, 0.148, 0.089) b=(-0.104, 0.301, 0.208) width=0.018
                ArbitraryRoundCone a=(-0.056, 0.03, 0.021) b=(-0.124, 0.177, 0.046) radiusA=0.022 radiusB=0.016
                VesicaSegment a=(-0.104, 0.149, 0.039) b=(-0.263, 0.302, 0.098) width=0.018
                ArbitraryRoundCone a=(-0.055, 0.03, -0.024) b=(-0.126, 0.16, -0.055) radiusA=0.022 radiusB=0.016
                VesicaSegment a=(-0.105, 0.135, -0.046) b=(-0.27, 0.268, -0.118) width=0.018
                ArbitraryRoundCone a=(-0.025, 0.03, -0.054) b=(-0.053, 0.179, -0.115) radiusA=0.022 radiusB=0.016
                VesicaSegment a=(-0.045, 0.15, -0.097) b=(-0.11, 0.305, -0.237) width=0.018
                ArbitraryRoundCone a=(0.017, 0.03, -0.058) b=(0.034, 0.151, -0.113) radiusA=0.022 radiusB=0.016
                VesicaSegment a=(0.029, 0.128, -0.097) b=(0.067, 0.25, -0.227) width=0.018
                ArbitraryRoundCone a=(0.043, 0.03, -0.042) b=(0.098, 0.162, -0.098) radiusA=0.022 radiusB=0.016
                VesicaSegment a=(0.081, 0.136, -0.081) b=(0.211, 0.271, -0.21) width=0.018
