# Grass turf 0: a round, springy tuft of meadow grass about 0.45 m tall and 0.5 m across, over thirty chunky, tapering blades
# fanning up and out of a small mound of dark earth, the outer ones leaning furthest, so it reads as a fountain of green.
format 1

# Three times the vertices its size would give it: the blades are thin next to the tuft's size
Detail detail=3
    Union
        # The mound of earth the blades grow out of, cut flat at the ground
        Material material=grass_soil
            Distort amount=0.008 frequency=12
                Intersection
                    Ellipsoid radii=(0.15, 0.05, 0.14)
                    Translate translation=(0, 0.1, 0)
                        Box size=(0.2, 0.1, 0.2)
        # The blades, each in two lengths that lean further out towards the tip, a plain union so each keeps its own outline
        Material material=grass_blade
            Union
                ArbitraryRoundCone a=(-0.071, 0.02, 0.022) b=(-0.118, 0.189, 0.012) radiusA=0.027 radiusB=0.017
                ArbitraryRoundCone a=(-0.118, 0.189, 0.012) b=(-0.212, 0.338, -0.008) radiusA=0.017 radiusB=0.007
                ArbitraryRoundCone a=(-0.079, 0.02, -0.006) b=(-0.11, 0.154, -0.02) radiusA=0.023 radiusB=0.015
