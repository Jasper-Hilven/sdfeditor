# Grass turf 4: a low, round clover turf about 0.65 m across and 0.25 m tall, a mound of earth under a mat of green and short grass blades, with
# nine clover plants, each three round leaves on a short stalk, with six white clover blossoms standing just above them on thin
# stems. A flowering patch to break up the plain turfs.
format 1

# The mound of earth, cut flat at the ground, used twice: as the earth, and grown a little for the green mat over its top
mound =
    Distort amount=0.008 frequency=10
        Intersection
            Ellipsoid radii=(0.3, 0.06, 0.28)
            Translate translation=(0, 0.1, 0)
                Box size=(0.35, 0.1, 0.35)

# Four times the vertices its size would give it: the stalks and leaves are small next to the turf's size
Detail detail=4
    Union
        # The mound of earth
        Material material=grass_soil
            $mound
        Material material=grass_blade
            Union
                # A mat of green over the top of the mound: the mound grown by a centimetre, kept only above a wavy line
                Intersection
                    Round radius=0.01
                        $mound
                    Distort amount=0.008 frequency=9
                        Plane normal=(0, -1, 0) height=0.03
                # The short blades over the mound
                ArbitraryRoundCone a=(0.008, 0.04, 0.191) b=(0.014, 0.112, 0.204) radiusA=0.017 radiusB=0.011
                ArbitraryRoundCone a=(0.014, 0.112, 0.204) b=(0.026, 0.177, 0.23) radiusA=0.011 radiusB=0.005
