# Grass turf 4: a low, round clover turf about 0.65 m across and 0.25 m tall, a mound of earth under a mat of green with six little
# tufts of three fat grass blades, six clover plants of three round, plump leaves each on a short stalk, and four white clover
# blossoms standing above them on stems. A flowering patch to break up the plain turfs. Few, chunky shapes rather than a bristle of
# thin blades, so it stays light enough to scatter by the hundreds.
format 1

# The mound of earth, cut flat at the ground, used twice: as the earth, and grown a little for the green mat over its top
mound =
    Distort amount=0.008 frequency=10
        Intersection
            Ellipsoid radii=(0.3, 0.06, 0.28)
            Translate translation=(0, 0.1, 0)
                Box size=(0.35, 0.1, 0.35)

# Eight tenths of the vertices its size would give it: the leaves, blades and stems are fat enough to keep their shape on the
# coarser grid
Detail detail=0.8
    Union
        # The mound of earth
        Material material=grass_soil
            $mound
        Material material=grass_blade
            Union
                # A mat of green over the top of the mound: the mound grown by a centimetre, kept only above a wavy line
                Intersection
                    Round radius=0.01
                        $mound
                    Distort amount=0.008 frequency=9
                        Plane normal=(0, -1, 0) height=0.03
                # The grass tufts, each three short, fat blades fanning out of the mat from one spot
                Union
                    SmoothUnion smoothness=0.006
                        VesicaSegment a=(0.112, 0.048, 0.083) b=(0.156, 0.168, 0.061) width=0.022
                        VesicaSegment a=(0.112, 0.048, 0.083) b=(0.126, 0.151, 0.123) width=0.022
                        VesicaSegment a=(0.112, 0.048, 0.083) b=(0.073, 0.156, 0.083) width=0.022
                    SmoothUnion smoothness=0.006
                        VesicaSegment a=(-0.017, 0.035, 0.209) b=(-0.059, 0.136, 0.187) width=0.022
                        VesicaSegment a=(-0.017, 0.035, 0.209) b=(0.026, 0.173, 0.188) width=0.022
                        VesicaSegment a=(-0.017, 0.035, 0.209) b=(-0.021, 0.153, 0.249) width=0.022
                    SmoothUnion smoothness=0.006
                        VesicaSegment a=(-0.097, 0.051, 0.053) b=(-0.122, 0.173, 0.018) width=0.022
                        VesicaSegment a=(-0.097, 0.051, 0.053) b=(-0.059, 0.171, 0.058) width=0.022
                        VesicaSegment a=(-0.097, 0.051, 0.053) b=(-0.115, 0.16, 0.085) width=0.022
                    SmoothUnion smoothness=0.006
                        VesicaSegment a=(-0.206, 0.034, -0.091) b=(-0.176, 0.156, -0.094) width=0.022
                        VesicaSegment a=(-0.206, 0.034, -0.091) b=(-0.216, 0.157, -0.062) width=0.022
                        VesicaSegment a=(-0.206, 0.034, -0.091) b=(-0.224, 0.159, -0.117) width=0.022
                    SmoothUnion smoothness=0.006
                        VesicaSegment a=(-0.011, 0.049, -0.117) b=(-0.038, 0.177, -0.143) width=0.022
                        VesicaSegment a=(-0.011, 0.049, -0.117) b=(0.019, 0.179, -0.121) width=0.022
                        VesicaSegment a=(-0.011, 0.049, -0.117) b=(-0.012, 0.177, -0.068) width=0.022
                    SmoothUnion smoothness=0.006
                        VesicaSegment a=(0.168, 0.041, -0.085) b=(0.169, 0.165, -0.049) width=0.022
                        VesicaSegment a=(0.168, 0.041, -0.085) b=(0.134, 0.154, -0.101) width=0.022
                        VesicaSegment a=(0.168, 0.041, -0.085) b=(0.202, 0.153, -0.102) width=0.022
                # The clover plants, each three round, plump leaflets on top of a short leaf stalk
                Union
                    Capsule a=(0.173, 0.046, 0.015) b=(0.173, 0.086, 0.015) radius=0.01
                    Translate translation=(0.151, 0.086, 0.035)
                        Ellipsoid radii=(0.03, 0.012, 0.03)
                    Translate translation=(0.167, 0.086, -0.014)
                        Ellipsoid radii=(0.03, 0.012, 0.03)
                    Translate translation=(0.202, 0.086, 0.025)
                        Ellipsoid radii=(0.03, 0.012, 0.03)
                    Capsule a=(0.095, 0.038, 0.173) b=(0.095, 0.078, 0.173) radius=0.01
                    Translate translation=(0.069, 0.078, 0.158)
                        Ellipsoid radii=(0.03, 0.012, 0.03)
                    Translate translation=(0.121, 0.078, 0.158)
                        Ellipsoid radii=(0.03, 0.012, 0.03)
                    Translate translation=(0.094, 0.078, 0.203)
                        Ellipsoid radii=(0.03, 0.012, 0.03)
                    Capsule a=(-0.114, 0.04, 0.171) b=(-0.114, 0.08, 0.171) radius=0.01
                    Translate translation=(-0.089, 0.08, 0.154)
                        Ellipsoid radii=(0.03, 0.012, 0.03)
                    Translate translation=(-0.111, 0.08, 0.201)
                        Ellipsoid radii=(0.03, 0.012, 0.03)
                    Translate translation=(-0.141, 0.08, 0.159)
                        Ellipsoid radii=(0.03, 0.012, 0.03)
                    Capsule a=(-0.201, 0.045, 0.003) b=(-0.201, 0.085, 0.003) radius=0.01
                    Translate translation=(-0.174, 0.085, -0.01)
                        Ellipsoid radii=(0.03, 0.012, 0.03)
                    Translate translation=(-0.204, 0.085, 0.033)
                        Ellipsoid radii=(0.03, 0.012, 0.03)
                    Translate translation=(-0.226, 0.085, -0.014)
                        Ellipsoid radii=(0.03, 0.012, 0.03)
                    Capsule a=(-0.07, 0.052, -0.145) b=(-0.07, 0.092, -0.145) radius=0.01
                    Translate translation=(-0.04, 0.092, -0.146)
                        Ellipsoid radii=(0.03, 0.012, 0.03)
                    Translate translation=(-0.083, 0.092, -0.118)
                        Ellipsoid radii=(0.03, 0.012, 0.03)
                    Translate translation=(-0.086, 0.092, -0.17)
                        Ellipsoid radii=(0.03, 0.012, 0.03)
                    Capsule a=(0.115, 0.044, -0.154) b=(0.115, 0.084, -0.154) radius=0.01
                    Translate translation=(0.131, 0.084, -0.129)
                        Ellipsoid radii=(0.03, 0.012, 0.03)
                    Translate translation=(0.085, 0.084, -0.154)
                        Ellipsoid radii=(0.03, 0.012, 0.03)
                    Translate translation=(0.13, 0.084, -0.181)
                        Ellipsoid radii=(0.03, 0.012, 0.03)
                # The stems of the blossoms
                Union
                    Capsule a=(0.059, 0.059, 0.019) b=(0.076, 0.214, 0.025) radius=0.01
                    Capsule a=(-0.025, 0.058, 0.064) b=(-0.033, 0.223, 0.083) radius=0.01
                    Capsule a=(-0.055, 0.058, -0.038) b=(-0.071, 0.209, -0.05) radius=0.01
                    Capsule a=(0.034, 0.059, -0.049) b=(0.044, 0.218, -0.064) radius=0.01
        # The blossoms, round, ribbed heads on top of their stems
        Material material=grass_clover_blossom
            Union
                Translate translation=(0.076, 0.236, 0.025)
                    RadialWave amount=0.15 count=8
                        Ellipsoid radii=(0.034, 0.036, 0.034)
                Translate translation=(-0.033, 0.245, 0.083)
                    RadialWave amount=0.15 count=8
                        Ellipsoid radii=(0.034, 0.036, 0.034)
                Translate translation=(-0.071, 0.231, -0.05)
                    RadialWave amount=0.15 count=8
                        Ellipsoid radii=(0.034, 0.036, 0.034)
                Translate translation=(0.044, 0.24, -0.064)
                    RadialWave amount=0.15 count=8
                        Ellipsoid radii=(0.034, 0.036, 0.034)
