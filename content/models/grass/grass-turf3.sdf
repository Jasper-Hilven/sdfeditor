# Grass turf 3: a messy tuft of dry, sun-bleached straw about 0.5 m tall and 0.8 m across, three dozen wheat-gold blades sprawling out
# from a mound of earth in all directions, many of them flopping over and drooping back down at their tips. Late summer to the
# other turfs' spring.
format 1

# Three times the vertices its size would give it: the blades are thin next to the tuft's size
Detail detail=3
    Union
        # The mound of earth the tuft grows out of, cut flat at the ground
        Material material=grass_soil
            Distort amount=0.008 frequency=12
                Intersection
                    Ellipsoid radii=(0.18, 0.06, 0.17)
                    Translate translation=(0, 0.1, 0)
                        Box size=(0.25, 0.1, 0.25)
        # The straw blades, in three lengths that sprawl out and droop
        Material material=grass_dry
