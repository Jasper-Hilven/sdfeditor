                ArbitraryRoundCone a=(-0.068, 0.194, 0.06) b=(-0.142, 0.257, 0.124) radiusA=0.02 radiusB=0.017
                VesicaSegment a=(-0.142, 0.257, 0.124) b=(-0.299, 0.203, 0.262) width=0.018
