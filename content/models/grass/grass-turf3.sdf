# Grass turf 3: a messy tuft of dry, sun-bleached straw about 0.5 m tall and 0.8 m across, thirteen fat, wheat-gold blades sprawling
# out from a mound of earth in all directions, most of them bending over and flopping back down at their pointed tips, every third
# one standing stiffer and taller. Late summer to the other turfs' spring. Few, chunky blades rather than many thin ones, so it
# stays light enough to scatter by the hundreds.
format 1

# Three quarters of the vertices its size would give it: the blades are fat enough to keep their shape on the coarser grid
Detail detail=0.75
    Union
        # The mound of earth the tuft grows out of, cut flat at the ground
        Material material=grass_soil
            Distort amount=0.008 frequency=12
                Intersection
                    Ellipsoid radii=(0.18, 0.06, 0.17)
                    Translate translation=(0, 0.1, 0)
                        Box size=(0.25, 0.1, 0.25)
        # The straw blades, each rising out of the mound, bending at a knee and ending in a pointed tip
        Material material=grass_dry
            SmoothUnion smoothness=0.006
                ArbitraryRoundCone a=(0.024, 0.03, -0.003) b=(0.062, 0.209, -0.008) radiusA=0.025 radiusB=0.02
                ArbitraryRoundCone a=(0.062, 0.209, -0.008) b=(0.103, 0.345, -0.014) radiusA=0.02 radiusB=0.017
                VesicaSegment a=(0.103, 0.345, -0.014) b=(0.199, 0.417, -0.026) width=0.018
                ArbitraryRoundCone a=(0.024, 0.03, 0.017) b=(0.066, 0.182, 0.046) radiusA=0.025 radiusB=0.02
                ArbitraryRoundCone a=(0.066, 0.182, 0.046) b=(0.146, 0.236, 0.103) radiusA=0.02 radiusB=0.017
                VesicaSegment a=(0.146, 0.236, 0.103) b=(0.287, 0.112, 0.203) width=0.018
                ArbitraryRoundCone a=(0.022, 0.03, 0.047) b=(0.049, 0.175, 0.103) radiusA=0.025 radiusB=0.02
                ArbitraryRoundCone a=(0.049, 0.175, 0.103) b=(0.094, 0.251, 0.199) radiusA=0.02 radiusB=0.017
                VesicaSegment a=(0.094, 0.251, 0.199) b=(0.18, 0.132, 0.383) width=0.018
                ArbitraryRoundCone a=(-0.002, 0.03, 0.023) b=(-0.005, 0.24, 0.065) radiusA=0.025 radiusB=0.02
                ArbitraryRoundCone a=(-0.005, 0.24, 0.065) b=(-0.008, 0.367, 0.12) radiusA=0.02 radiusB=0.017
                VesicaSegment a=(-0.008, 0.367, 0.12) b=(-0.014, 0.411, 0.199) width=0.018
