# Grass turf 2: a tall clump of wild meadow grass about 1 m tall, twenty-six long blades arching up and over in three lengths each,
# round five thin stalks that stand clear above them carrying plump, oat-coloured seed heads. The tallest of the turfs.
format 1

# Three times the vertices its size would give it: the blades and stalks are thin next to the clump's height
Detail detail=3
    Union
        # The mound of earth the clump grows out of, cut flat at the ground
        Material material=grass_soil
            Distort amount=0.008 frequency=12
                Intersection
                    Ellipsoid radii=(0.14, 0.05, 0.13)
                    Translate translation=(0, 0.1, 0)
                        Box size=(0.2, 0.1, 0.2)
        Material material=grass_blade
