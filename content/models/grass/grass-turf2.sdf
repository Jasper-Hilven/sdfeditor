# Grass turf 2: a tall clump of wild meadow grass about 1 m tall, ten long, fat blades arching up and over in two lengths, round
# four stalks that stand clear above them carrying plump, oat-coloured seed heads. The tallest of the turfs. Few, chunky blades
# rather than many thin ones, so it stays light enough to scatter by the hundreds.
format 1

# A little over a third of the vertices its size would give it: the blades and stalks are fat enough to keep their shape on the coarser grid, and the
# turf is scattered by the thousand, so it stays at about 2k triangles
Detail detail=0.36
    Union
        # The mound of earth the clump grows out of, cut flat at the ground
        Material material=grass_soil
            Distort amount=0.008 frequency=12
                Intersection
                    Ellipsoid radii=(0.14, 0.05, 0.13)
                    Translate translation=(0, 0.1, 0)
                        Box size=(0.2, 0.1, 0.2)
        Material material=grass_blade
            SmoothUnion smoothness=0.006
                # The long blades, each a round cone rising from the mound and a fat, pointed leaf arching out and down from it
                ArbitraryRoundCone a=(0.03, 0.03, -0.002) b=(0.127, 0.399, -0.009) radiusA=0.026 radiusB=0.02
                VesicaSegment a=(0.089, 0.335, -0.006) b=(0.328, 0.542, -0.023) width=0.021
                ArbitraryRoundCone a=(0.027, 0.03, 0.013) b=(0.127, 0.325, 0.062) radiusA=0.026 radiusB=0.02
                VesicaSegment a=(0.088, 0.275, 0.043) b=(0.334, 0.433, 0.164) width=0.021
                ArbitraryRoundCone a=(0.014, 0.03, 0.026) b=(0.054, 0.416, 0.102) radiusA=0.026 radiusB=0.02
                VesicaSegment a=(0.039, 0.349, 0.072) b=(0.138, 0.571, 0.258) width=0.021
                ArbitraryRoundCone a=(-0.009, 0.03, 0.029) b=(-0.039, 0.303, 0.13) radiusA=0.026 radiusB=0.02
                VesicaSegment a=(-0.027, 0.257, 0.091) b=(-0.101, 0.396, 0.341) width=0.021
                ArbitraryRoundCone a=(-0.024, 0.03, 0.018) b=(-0.092, 0.431, 0.072) radiusA=0.026 radiusB=0.02
                VesicaSegment a=(-0.066, 0.361, 0.051) b=(-0.235, 0.596, 0.182) width=0.021
                ArbitraryRoundCone a=(-0.03, 0.03, 0.003) b=(-0.152, 0.33, 0.017) radiusA=0.026 radiusB=0.02
                VesicaSegment a=(-0.104, 0.279, 0.012) b=(-0.404, 0.44, 0.045) width=0.021
                ArbitraryRoundCone a=(-0.024, 0.03, -0.018) b=(-0.106, 0.41, -0.082) radiusA=0.026 radiusB=0.02
                VesicaSegment a=(-0.074, 0.344, -0.057) b=(-0.276, 0.562, -0.213) width=0.021
                ArbitraryRoundCone a=(-0.014, 0.03, -0.026) b=(-0.066, 0.341, -0.123) radiusA=0.026 radiusB=0.02
                VesicaSegment a=(-0.046, 0.287, -0.085) b=(-0.175, 0.459, -0.323) width=0.021
                ArbitraryRoundCone a=(0.005, 0.03, -0.03) b=(0.021, 0.397, -0.119) radiusA=0.026 radiusB=0.02
                VesicaSegment a=(0.015, 0.334, -0.084) b=(0.053, 0.539, -0.304) width=0.021
                ArbitraryRoundCone a=(0.026, 0.03, -0.014) b=(0.127, 0.308, -0.07) radiusA=0.026 radiusB=0.02
                VesicaSegment a=(0.088, 0.261, -0.048) b=(0.337, 0.404, -0.185) width=0.021
                # The stalks, standing above the blades
                Capsule a=(0.019, 0.03, 0.006) b=(0.096, 0.8, 0.03) radius=0.015
                Capsule a=(-0.006, 0.03, 0.019) b=(-0.039, 0.76, 0.114) radius=0.015
                Capsule a=(-0.019, 0.03, -0.007) b=(-0.084, 0.84, -0.032) radius=0.015
                Capsule a=(0.006, 0.03, -0.019) b=(0.037, 0.79, -0.125) radius=0.015
        # The seed heads, plump and pointed, at the top of each stalk
        Material material=grass_seed
            Union
                VesicaSegment a=(0.093, 0.77, 0.029) b=(0.11, 0.949, 0.034) width=0.032
                VesicaSegment a=(-0.037, 0.73, 0.11) b=(-0.045, 0.909, 0.133) width=0.032
                VesicaSegment a=(-0.082, 0.81, -0.031) b=(-0.096, 0.989, -0.036) width=0.032
                VesicaSegment a=(0.036, 0.76, -0.121) b=(0.043, 0.938, -0.145) width=0.032
