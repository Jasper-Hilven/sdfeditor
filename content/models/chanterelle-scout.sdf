# Chanterelle scout: a slender golden mushroom with a wavy funnel cap, ridges running down under it, wide eyes and small hands.
format 1

Union
    # Body and cap grow into each other
    SmoothUnion smoothness=0.1
        Material material=chanterelle_flesh
            SmoothUnion smoothness=0.12
                Translate translation=(0, 0.62, 0)
                    CappedCone height=0.62 bottomRadius=0.2 topRadius=0.15
                Translate translation=(0, 0.1, 0)
                    Ellipsoid radii=(0.26, 0.12, 0.26)
        # Cap with its false gills: twelve ridges, three per quarter, only slightly blended so they stay underneath
        SmoothUnion smoothness=0.015
            Material material=chanterelle_cap
                Distort amount=0.012 frequency=2.5
                    Union
                        # Funnel: a thick sloped line, spun around the y axis
                        Revolution offset=0
                            Round2D radius=0.045
                                OrientedBox2D a=(0.12, 1.3) b=(0.68, 1.6) thickness=0.07
                        Translate translation=(0, 1.31, 0)
                            Ellipsoid radii=(0.2, 0.06, 0.2)
            Material material=chanterelle_ridges
                SymmetryXZ
                    Union
                        Capsule a=(0.164, 1.22, 0.044) b=(0.58, 1.48, 0.155) radius=0.022
                        Capsule a=(0.12, 1.22, 0.12) b=(0.424, 1.48, 0.424) radius=0.022
                        Capsule a=(0.044, 1.22, 0.164) b=(0.155, 1.48, 0.58) radius=0.022

    # Wide eyes, mirrored
    SymmetryX
        Translate translation=(0.1, 0.86, 0.13)
            Union
                Material material=eye_white
                    Sphere radius=0.12
                Translate translation=(0, 0, 0.09)
                    Material material=eye_iris
                        Ellipsoid radii=(0.065, 0.065, 0.035)
                Translate translation=(0, 0, 0.117)
                    Material material=eye_pupil
                        Ellipsoid radii=(0.035, 0.035, 0.014)

    # Floating hands, mirrored
    SymmetryX
        Translate translation=(0.29, 0.55, 0.1)
            Material material=chanterelle_flesh
                Union
                    Ellipsoid radii=(0.07, 0.11, 0.09)
                    Capsule a=(0, -0.07, 0.06) b=(0, -0.07, 0.18) radius=0.034
                    Capsule a=(0, 0, 0.06) b=(0, 0, 0.19) radius=0.034
                    Capsule a=(0, 0.07, 0.06) b=(0, 0.07, 0.18) radius=0.034
                    Capsule a=(-0.04, 0.05, 0.02) b=(-0.015, 0.085, -0.06) radius=0.035
