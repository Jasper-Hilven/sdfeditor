# Team blue clump 0 (ticket 19): a clump of seven mushrooms 0.3 to 1.2 m tall, about 2 m across, for the foot of the castle's
# walls and towers. In the east side's colours, bluish: cobalt caps glowing a little; the same layout as team-red-clump0 in the
# other side's. Only uses of the team_blue_* parts, so each mushroom is meshed once and the level draws them instanced with the
# castle's parts. Small and decorative: no collider.
format 1
collider none

# Half the cells their size would give them, as the fairy rings have it: small, simple forms, and many stand round each castle
Detail detail=0.5
    Union
        Translate translation=(0, 0, 0)
            Rotate rotation=(0, 0, 0)
                Scale scale=(2.2, 2.2, 2.2)
                    Part part=team_blue_dome
        Translate translation=(0.55, 0, 0.25)
            Rotate rotation=(0, 1.3, 0)
                Scale scale=(2, 2, 2)
                    Part part=team_blue_bell
        Translate translation=(-0.5, 0, 0.4)
            Rotate rotation=(0, 2.6, 0)
                Scale scale=(1.5, 1.5, 1.5)
                    Part part=team_blue_dome
        Translate translation=(0.3, 0, -0.55)
            Rotate rotation=(0, 3.1, 0)
                Scale scale=(1.8, 1.8, 1.8)
                    Part part=team_blue_button
        Translate translation=(-0.35, 0, -0.5)
            Rotate rotation=(0, 4.4, 0)
                Scale scale=(1.4, 1.4, 1.4)
                    Part part=team_blue_bell
        Translate translation=(0.85, 0, -0.2)
            Rotate rotation=(0, 5, 0)
                Scale scale=(1.2, 1.2, 1.2)
                    Part part=team_blue_button
        Translate translation=(-0.8, 0, -0.05)
            Rotate rotation=(0, 0.7, 0)
                Scale scale=(1, 1, 1)
                    Part part=team_blue_button
