# Team red crown 0 (ticket 19): a crown of six mushrooms 0.9 to 2.1 m tall, about 3 m across, for the top of a tower's or the
# keep's cap, where it reads from across the field. The outer ones stand a little lower and lean out, following the dome they grow
# on. In the west side's colours, reddish: warm coral-scarlet caps with cream flecks; the same layout as team-blue-crown0 in the
# other side's. Only uses of the team_red_* parts, so each mushroom is meshed once and the level draws them instanced with the
# castle's parts. Small and decorative: no collider.
format 1
collider none

# Half the cells their size would give them, as the fairy rings have it: small, simple forms, and many stand round each castle
Detail detail=0.5
    Union
        Translate translation=(0, 0, 0)
            Rotate rotation=(0, 0.3, 0)
                Scale scale=(3.8, 3.8, 3.8)
                    Part part=team_red_dome
        Translate translation=(1.3, -0.1, 0.4)
            Rotate rotation=(0.033, 0, -0.115)
                Rotate rotation=(0, 1.1, 0)
                    Scale scale=(3.4, 3.4, 3.4)
                        Part part=team_red_bell
        Translate translation=(-0.85, -0.1, 0.75)
            Rotate rotation=(0.079, 0, 0.090)
                Rotate rotation=(0, 2, 0)
                    Scale scale=(2.6, 2.6, 2.6)
                        Part part=team_red_dome
        Translate translation=(-0.55, -0.1, -1)
            Rotate rotation=(-0.105, 0, 0.058)
                Rotate rotation=(0, 4, 0)
                    Scale scale=(2.5, 2.5, 2.5)
                        Part part=team_red_bell
        Translate translation=(0.55, -0.1, -0.95)
            Rotate rotation=(-0.104, 0, -0.060)
                Rotate rotation=(0, 5.2, 0)
                    Scale scale=(3.4, 3.4, 3.4)
                        Part part=team_red_button
        Translate translation=(-1.2, -0.12, -0.1)
            Rotate rotation=(-0.010, 0, 0.120)
                Rotate rotation=(0, 0.8, 0)
                    Scale scale=(2.6, 2.6, 2.6)
                        Part part=team_red_button
