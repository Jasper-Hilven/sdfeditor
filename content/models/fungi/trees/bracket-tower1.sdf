# Bracket tower 1: a squat dead trunk 8 m tall, leaning a little, broken off short and wrapped in four broad tiers of cream and orange
# shelf fungi (the part fungi_bracket_tiers_squat): the pine's squat cousin. The trunk is the collider's.
format 1
collider capsule

Detail detail=0.1
    Union
        Material material=ftree_deadwood
            Distort amount=0.03 frequency=2.5
                SmoothUnion smoothness=0.2
                    Intersection
                        Ellipsoid radii=(1.1, 0.6, 1.1)
                        Translate translation=(0, 0.5, 0)
                            Box size=(2.6, 0.5, 2.6)
                    ArbitraryRoundCone a=(0, 0.2, 0) b=(0.5, 7.6, 0.2) radiusA=0.8 radiusB=0.2
                    # A snapped limb at the top
                    ArbitraryRoundCone a=(0.45, 7.0, 0.2) b=(1.2, 8.0, 0.5) radiusA=0.2 radiusB=0.1
        Translate translation=(0.1, 1.3, 0.04)
            Part part=fungi_bracket_tiers_squat
