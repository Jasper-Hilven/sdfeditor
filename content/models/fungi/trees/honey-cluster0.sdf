# Honey cluster: a clump of honey fungus 7.5 m tall (the stems and caps drawn at 0.85), eight tan stems fanning out of one mossy base, the tallest in the middle, each
# carrying a honey-amber dome of a cap (the part fungi_honey_caps, whose caps stand at the tops of these stems). The stems are the
# trunk of the collider.
format 1
collider capsule

# Fewer vertices than its height would give it: thin stems and big smooth caps
Detail detail=0.12
    Scale scale=(0.85, 0.85, 0.85)
        Union
            Material material=ftree_honey_stem
                Distort amount=0.02 frequency=3
                    SmoothUnion smoothness=0.3
                        # The shared base, flat on the ground
                        Intersection
                            Ellipsoid radii=(1.3, 0.7, 1.3)
                            Translate translation=(0, 0.5, 0)
                                Box size=(3, 0.5, 3)
                        ArbitraryRoundCone a=(0, 0.1, 0) b=(0.2, 6.2, 0.1) radiusA=0.42 radiusB=0.2
                        ArbitraryRoundCone a=(0.1, 0.1, 0) b=(1.8, 5.0, 0.6) radiusA=0.34 radiusB=0.17
                        ArbitraryRoundCone a=(-0.1, 0.1, 0.1) b=(-1.7, 5.2, 0.8) radiusA=0.34 radiusB=0.17
                        ArbitraryRoundCone a=(0.1, 0.1, -0.1) b=(0.7, 4.4, -1.9) radiusA=0.32 radiusB=0.16
                        ArbitraryRoundCone a=(-0.1, 0.1, -0.1) b=(-1.1, 4.0, -1.7) radiusA=0.3 radiusB=0.15
                        ArbitraryRoundCone a=(0.2, 0.1, 0) b=(2.8, 3.4, -0.4) radiusA=0.3 radiusB=0.15
                        ArbitraryRoundCone a=(-0.2, 0.1, 0) b=(-2.7, 3.5, -0.6) radiusA=0.3 radiusB=0.15
                        ArbitraryRoundCone a=(0.1, 0.1, 0.2) b=(0.9, 3.3, 2.4) radiusA=0.3 radiusB=0.15
            Part part=fungi_honey_caps
