                    ArbitraryRoundCone a=(-0.60, -1.5, 0.28) b=(-3.02, 4.42, 1.42) radiusA=0.57 radiusB=0.26
                    ArbitraryRoundCone a=(-0.59, -1.5, -0.12) b=(-2.96, 5.23, -0.60) radiusA=0.57 radiusB=0.26
                    ArbitraryRoundCone a=(-0.09, -1.5, -0.47) b=(-0.47, 5.88, -2.34) radiusA=0.57 radiusB=0.26
                    ArbitraryRoundCone a=(0.16, -1.5, -0.36) b=(0.79, 4.20, -1.79) radiusA=0.57 radiusB=0.26
            Material material=ftree_bracket_cream
