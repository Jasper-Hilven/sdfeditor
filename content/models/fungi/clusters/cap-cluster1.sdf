                    ArbitraryRoundCone a=(-0.39, -1.5, 0.22) b=(-1.96, 4.22, 1.12) radiusA=0.57 radiusB=0.26
                    ArbitraryRoundCone a=(-0.59, -1.5, -0.14) b=(-2.95, 5.65, -0.69) radiusA=0.57 radiusB=0.26
                    ArbitraryRoundCone a=(-0.20, -1.5, -0.35) b=(-1.00, 6.02, -1.75) radiusA=0.57 radiusB=0.26
                    ArbitraryRoundCone a=(0.29, -1.5, -0.45) b=(1.43, 3.51, -2.27) radiusA=0.57 radiusB=0.26
            Material material=ftree_parasol_cap
