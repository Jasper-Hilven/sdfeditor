                    ArbitraryRoundCone a=(-0.28, -1.5, 0.23) b=(-1.41, 5.02, 1.17) radiusA=0.57 radiusB=0.26
                    ArbitraryRoundCone a=(-0.62, -1.5, -0.24) b=(-3.11, 3.33, -1.20) radiusA=0.57 radiusB=0.26
                    ArbitraryRoundCone a=(0.03, -1.5, -0.63) b=(0.15, 4.27, -3.14) radiusA=0.57 radiusB=0.26
                    ArbitraryRoundCone a=(0.23, -1.5, -0.55) b=(1.14, 4.81, -2.75) radiusA=0.57 radiusB=0.26
