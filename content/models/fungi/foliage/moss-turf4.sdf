# Moss turf 4: a low, round cushion of moss about 0.65 m across and 0.25 m tall, a mound of dark humus under a mat of olive moss
# with a bright crown, and six tiny glowing mycena bonnets standing on top of it on glassy stems. A flowering patch to break up the
# plain moss turfs, the counterpart of grass-turf4; the one place the moss carries the level's cyan-green glow.
# Few, chunky shapes rather than a bristle of fine ones, so it stays light enough to scatter by the hundreds.
format 1

# Detail as the grass and flowers have it: the fine stalks and thin stems are small next to the model's size
Detail detail=0.7
    Intersection
        Union
            Material material=moss_soil
                Translate translation=(0, 0, 0)
                    Distort amount=0.002 frequency=12
                        Intersection
                            Ellipsoid radii=(0.41, 0.06, 0.4)
                            Translate translation=(0, 0.06, 0)
                                Box size=(0.46, 0.06, 0.45)
            Material material=moss_cushion
                Translate translation=(0, 0, 0)
                    Distort amount=0.004 frequency=8
                        Intersection
                            Ellipsoid radii=(0.33, 0.15, 0.32)
                            Translate translation=(0, 0.15, 0)
                                Box size=(0.38, 0.15, 0.37)
            Material material=moss_bright
                Translate translation=(0, 0.03, 0)
                    Distort amount=0.004 frequency=10
                        Intersection
                            Ellipsoid radii=(0.2, 0.13, 0.2)
                            Translate translation=(0, 0.13, 0)
                                Box size=(0.25, 0.13, 0.25)
            Material material=tuft_mycena_stem
                Union
                    ArbitraryRoundCone a=(0, 0.1, 0) b=(0.01, 0.18, 0) radiusA=0.012 radiusB=0.009
                    ArbitraryRoundCone a=(0.13, 0.1, 0.08) b=(0.14, 0.165, 0.08) radiusA=0.012 radiusB=0.009
                    ArbitraryRoundCone a=(-0.12, 0.1, 0.1) b=(-0.11, 0.168, 0.1) radiusA=0.012 radiusB=0.009
                    ArbitraryRoundCone a=(0.04, 0.1, -0.13) b=(0.05, 0.162, -0.13) radiusA=0.012 radiusB=0.009
                    ArbitraryRoundCone a=(-0.1, 0.1, -0.1) b=(-0.09, 0.159, -0.1) radiusA=0.012 radiusB=0.009
                    ArbitraryRoundCone a=(0.15, 0.1, -0.06) b=(0.16, 0.156, -0.06) radiusA=0.012 radiusB=0.009
            Material material=tuft_mycena_cap
                Union
                    Translate translation=(0.01, 0.18, 0)
                        Intersection
                            Ellipsoid radii=(0.05, 0.06, 0.05)
                            Translate translation=(0, 0.1, 0)
                                Box size=(0.15, 0.1, 0.15)
                    Translate translation=(0.14, 0.165, 0.08)
                        Intersection
                            Ellipsoid radii=(0.04, 0.048, 0.04)
                            Translate translation=(0, 0.1, 0)
                                Box size=(0.15, 0.1, 0.15)
                    Translate translation=(-0.11, 0.168, 0.1)
                        Intersection
                            Ellipsoid radii=(0.042, 0.05, 0.042)
                            Translate translation=(0, 0.1, 0)
                                Box size=(0.15, 0.1, 0.15)
                    Translate translation=(0.05, 0.162, -0.13)
                        Intersection
                            Ellipsoid radii=(0.038, 0.045, 0.038)
                            Translate translation=(0, 0.1, 0)
                                Box size=(0.15, 0.1, 0.15)
                    Translate translation=(-0.09, 0.159, -0.1)
                        Intersection
                            Ellipsoid radii=(0.036, 0.043, 0.036)
                            Translate translation=(0, 0.1, 0)
                                Box size=(0.15, 0.1, 0.15)
                    Translate translation=(0.16, 0.156, -0.06)
