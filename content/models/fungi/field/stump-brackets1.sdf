# Stump with brackets 1: a squat, wide stump 1.3 m tall and 1.5 m across, rotten and hollow-topped, with turkey tails shingled up
# its sides in four overlapping tiers of thin shelves. Convex collider.
format 1
collider convex

Detail detail=0.4
    Union
        Material material=field_wood
            Distort amount=0.03 frequency=3
                Subtraction
                    Subtraction
                        Subtraction
                            SmoothUnion smoothness=0.3
                                Translate translation=(0, 0.6, 0)
                                    CappedCone height=1.2 bottomRadius=0.78 topRadius=0.62
                                Translate translation=(0.6, 0.12, -0.3)
                                    Ellipsoid radii=(0.5, 0.22, 0.35)
                                Translate translation=(-0.55, 0.12, 0.35)
                                    Ellipsoid radii=(0.5, 0.2, 0.3)
                            # The rotten hollow in the top
                            Translate translation=(0.05, 1.3, 0)
                                Ellipsoid radii=(0.38, 0.35, 0.36)
                        # Flat on the ground
                        Plane normal=(0, 1, 0) height=0
                    # Broken off aslant: everything above this plane goes
                    Plane normal=(0.2, -0.95, -0.15) height=1.12
        # The pale rotten wood showing in the hollow
        Material material=field_wood_broken
            Translate translation=(0.05, 0.98, 0)
                Ellipsoid radii=(0.3, 0.2, 0.28)
        Material material=field_turkey_tail
