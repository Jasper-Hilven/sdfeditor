# Log with fungi 0: a fallen log 6 m long and about 0.5 m high, grey bark going soft and mossy, one end splintered where it
# broke, half sunk in the ground, with oyster mushrooms shelved along its sides and a few on top. Low enough to step onto. Mesh
# collider.
format 1
collider mesh

Detail detail=0.5
    Union
        Material material=field_wood
            Distort amount=0.025 frequency=3
                Subtraction
                    SmoothUnion smoothness=0.15
                        # The trunk lying along x
                        Translate translation=(0, 0.22, 0)
                            Rotate rotation=(0, 0, 1.5707964)
                                CappedCylinder radius=0.29 height=3.0
                        # The stub of a broken branch
                        Translate translation=(1.1, 0.4, 0.3)
                            Rotate rotation=(0.9, 0, 0)
                                CappedCone height=0.5 bottomRadius=0.1 topRadius=0.06
                    # Flat on the ground
                    Plane normal=(0, 1, 0) height=0
        # The splintered end
