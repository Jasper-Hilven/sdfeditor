# Fairy ring 0: a ring of 24 champignons about 7 m across, 0.3 to 0.8 m tall, on a darker circle of moss, in the open field. Knee-
# high, so no collider. Each of the two mushroom kinds is a part, meshed once and drawn per use.
format 1
collider none

# Half the vertices its size would give it: big, simple forms, and a few dozen of these lie in the field
Detail detail=0.5
    Union
        # The darker circle of moss the mushrooms grow from, a low band 1.8 m wide
        Material material=field_ring_moss
            Distort amount=0.03 frequency=2.5
                Intersection
                    Scale scale=(1, 0.09, 1)
                        Torus innerRadius=2.60 outerRadius=4.40
                    Plane normal=(0, -1, 0) height=0
        # 24 mushrooms round it, a little out of line, turned and sized each their own way
        Translate translation=(3.81, 0, -0.22)
            Rotate rotation=(0, 1.60, 0)
                Scale scale=(1.41, 1.41, 1.41)
                    Part part=field_champignon
        Translate translation=(3.34, 0, 0.89)
            Rotate rotation=(0, 4.95, 0)
                Scale scale=(1.32, 1.32, 1.32)
                    Part part=field_champignon_bud
        Translate translation=(2.76, 0, 1.36)
            Rotate rotation=(0, 2.72, 0)
                Scale scale=(1.47, 1.47, 1.47)
                    Part part=field_champignon
        Translate translation=(2.07, 0, 2.25)
            Rotate rotation=(0, 4.53, 0)
                Scale scale=(1.16, 1.16, 1.16)
                    Part part=field_champignon
        Translate translation=(2.10, 0, 3.29)
            Rotate rotation=(0, 0.19, 0)
                Scale scale=(1.52, 1.52, 1.52)
                    Part part=field_champignon_bud
        Translate translation=(1.17, 0, 3.34)
            Rotate rotation=(0, 2.39, 0)
                Scale scale=(1.55, 1.55, 1.55)
