# Fairy ring 1: a wider ring of 30 champignons about 9.4 m across, 0.3 to 0.8 m tall, on a low band of the ground's dirt, in the open field.
# Knee-high, so no collider. Each of the two mushroom kinds is a part, meshed once and drawn per use.
format 1
collider none

# Half the vertices its size would give it: big, simple forms, and a few dozen of these lie in the field
Detail detail=0.5
    Union
        # The low band of dirt the mushrooms grow from, 1.8 m wide, in the ground's colour
        Material material=field_ring_dirt
            Distort amount=0.03 frequency=2.5
                Intersection
                    Scale scale=(1, 0.09, 1)
                        Torus innerRadius=3.80 outerRadius=5.60
                    Plane normal=(0, -1, 0) height=0
        # 30 mushrooms round it, a little out of line, turned and sized each their own way
        Translate translation=(5.09, 0, 0.37)
            Rotate rotation=(0, 0.53, 0)
                Scale scale=(0.85, 0.85, 0.85)
                    Part part=field_champignon
        Translate translation=(4.74, 0, 1.28)
            Rotate rotation=(0, 1.94, 0)
                Scale scale=(1.34, 1.34, 1.34)
                    Part part=field_champignon_bud
        Translate translation=(4.35, 0, 2.02)
            Rotate rotation=(0, 0.99, 0)
                Scale scale=(1.26, 1.26, 1.26)
                    Part part=field_champignon
        Translate translation=(3.75, 0, 2.66)
            Rotate rotation=(0, 6.25, 0)
                Scale scale=(1.38, 1.38, 1.38)
                    Part part=field_champignon
