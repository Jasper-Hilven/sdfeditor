# Game box stack: four closed board-game boxes blown up to the board's scale and piled flat one on another, some 9.6 m tall, a
# little askew as a stack on a cupboard shelf: a plum purple box 12 x 9 m and 2.4 m deep at the bottom, a tangerine one 11 x 8 m on
# it, a mustard one 10 x 7.5 m on that and a bottle-green one 6.5 m square on top, each turned and shifted a little off the one
# below but hardly past its edge. Each lid covers the top 1.7 m of its box; under it a band of the plain cardboard tray shows.
# Too tall to climb, nothing to see through: a solid block of cover.
format 1
collider convex

# An eighth of the vertices its size would give it: big plain slabs with nothing printed on them, seen from afar
Detail detail=0.12
    Union
        # The bottom box, plum: its tray, then its lid over the top
        Translate translation=(0, 1.2, 0)
            Union
                Material material=game_box_inside
                    RoundBox size=(5.9, 1.15, 4.4) roundness=0.1
                Material material=game_box_purple
                    Translate translation=(0, 0.35, 0)
                        RoundBox size=(6, 0.85, 4.5) roundness=0.15
        # The tangerine box, turned a little and shifted towards +x
        Translate translation=(0.3, 3.7, -0.2)
            Rotate rotation=(0, 0.12, 0)
                Union
                    Material material=game_box_inside
                        RoundBox size=(5.4, 1.25, 3.9) roundness=0.1
                    Material material=game_box_orange
                        Translate translation=(0, 0.4, 0)
                            RoundBox size=(5.5, 0.9, 4) roundness=0.15
        # The mustard box, turned back the other way
        Translate translation=(-0.3, 6.1, 0.2)
            Rotate rotation=(0, -0.08, 0)
                Union
                    Material material=game_box_inside
                        RoundBox size=(4.9, 1.05, 3.65) roundness=0.1
                    Material material=game_box_yellow
                        Translate translation=(0, 0.3, 0)
                            RoundBox size=(5, 0.8, 3.75) roundness=0.15
        # The green box on top, square, turned further
        Translate translation=(0, 8.4, 0)
            Rotate rotation=(0, 0.3, 0)
                Union
                    Material material=game_box_inside
                        RoundBox size=(3.15, 1.15, 3.15) roundness=0.1
                    Material material=game_box_green
                        Translate translation=(0, 0.35, 0)
                            RoundBox size=(3.25, 0.85, 3.25) roundness=0.15
