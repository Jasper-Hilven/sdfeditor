# Card, face down: a giant playing card (card_king), 3 m wide and 4.2 m long, lying flat on the board face down, so only its back
# shows: a blue lattice with a round medallion.
format 1
collider mesh

# Half the vertices its size would give it, and its parts half too: big, simple forms, and dozens of game pieces lie on the
# board
Detail detail=0.5
    Translate translation=(0, 0.065, 0)
        # A quarter turn about x the other way lays the face down
        Rotate rotation=(1.5707964, 0, 0)
            Part part=card_king
