# Card, three lying: the giant three of diamonds (card_three), 3 m wide and 4.2 m long, lying flat on the board face up.
format 1
collider mesh

# 0.8 of the vertices its size would give it, and its parts 0.8 too: big, simple forms, but the printed marks blurred at half
Detail detail=0.8
    Translate translation=(0, 0.065, 0)
        # A quarter turn about x lays the face (+z) up
        Rotate rotation=(-1.5707964, 0, 0)
            Part part=card_three
