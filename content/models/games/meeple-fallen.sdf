# Meeple, fallen: the giant wooden meeple (meeple) knocked over onto its back, lying 2.65 m long with its feet towards +z. It
# rests on its heels and on its head, so it lies a little tipped.
format 1
collider mesh

# Half the vertices its size would give it, and its parts half too: big, simple forms, and dozens of game pieces lie on the
# board
Detail detail=0.5
    Translate translation=(0, 0.43, 1.3)
        # Laid on its back (a quarter turn about x brings its front, +z, up), a little less so it lies on its heels and its head
        Rotate rotation=(-1.516, 0, 0)
            Part part=meeple
