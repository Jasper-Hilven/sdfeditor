# Amanita die, tumbled: the red die of die-amanita caught mid-roll and slammed into the board, balanced on one edge and tipped
# over in two directions, its lowest edge sunk a little into the ground so it stays put. Three faces show from above.
format 1
collider convex

Translate translation=(0, 1.25, 0)
    Rotate rotation=(0.42, 0.3, 0.55)
        SmoothUnion smoothness=0.03
            Material material=game_cap_red
                RoundBox size=(1.1, 1.1, 1.1) roundness=0.22
            Material material=game_wart_white
                Part part=die_pips
