# Money note 1: a giant pale yellow Monopoly note (game_paper_yellow) 2 m long and 1 m wide, folded across the middle into a tent,
# its ridge 0.25 m high along z and its two halves resting on their outer edges. Plain paper, no print. Ground clutter: no collider,
# scattered between the pieces.
format 1

# A third of the vertices its size would give it: fine enough for the thin sheet to stay whole
Detail detail=0.3
    Material material=game_paper_yellow
        # One half, sloping down from the ridge to +x, mirrored to -x
        SymmetryX
            Translate translation=(0.49, 0.13, 0)
                Rotate rotation=(0, 0, -0.2)
                    RoundBox size=(0.5, 0.025, 0.5) roundness=0.012
