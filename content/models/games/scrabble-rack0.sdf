# Scrabble rack: a giant wooden Scrabble tile rack 6 m long (along x) and 1.3 m deep, in light varnished wood (meeple_wood), its
# front to +z. A low base with a lip along the front, a groove behind it, and a solid back whose front face leans back 20 degrees.
# Four ivory tiles (game_ivory), 0.9 m wide and 0.94 m tall, stand in the groove leaning against the back, their tops 1.1 m up,
# with a gap where a fifth was played: T, I, L, E, each a bold block letter painted flush on the tile's face in black
# (game_pip_black), as thick strokes hold their shape in few triangles. Long, knee-to-waist-high cover.
format 1
collider convex

# A quarter of the vertices its size would give it, about 2,100 triangles: a long plain rack, and bold letters that hold
# their shape coarsely, scattered cover
Detail detail=0.25
    Union
        # The rack: its profile (depth against height, front to the left) drawn in 2D, extruded 3 m each way and turned so the
        # extrusion runs along x and the front faces +z
        Material material=meeple_wood
            Rotate rotation=(0, 1.5707964, 0)
                Round radius=0.04
                    Extrusion height=2.96
                        Union2D
                            # The base
                            Translate2D offset=(0, 0.1)
                                Box2D size=(0.61, 0.06)
                            # The lip along the front
                            Translate2D offset=(-0.57, 0.2)
                                Box2D size=(0.04, 0.08)
                            # The back, its front face leaning back
                            Triangle2D a=(-0.21, 0.16) b=(0.61, 0.16) c=(0.61, 0.71)
                            Triangle2D a=(-0.21, 0.16) b=(0.61, 0.71) c=(-0.01, 0.71)
        # The tiles
        Union
            # T
            Translate translation=(-2.05, 0.64, 0.192)
                Rotate rotation=(-0.35, 0.04, 0)
                    Union
                        Material material=game_ivory
                            RoundBox size=(0.45, 0.47, 0.11) roundness=0.05
                        Material material=game_pip_black
                            Intersection
                                RoundBox size=(0.45, 0.47, 0.11) roundness=0.05
                                Union
                                    Translate translation=(-0.030, 0.250, 0.11)
                                        Box size=(0.2, 0.06, 0.05)
                                    Translate translation=(-0.030, -0.010, 0.11)
                                        Box size=(0.06, 0.24, 0.05)
            # I
            Translate translation=(-0.95, 0.64, 0.192)
                Rotate rotation=(-0.35, -0.03, 0)
                    Union
                        Material material=game_ivory
                            RoundBox size=(0.45, 0.47, 0.11) roundness=0.05
                        Material material=game_pip_black
                            Intersection
                                RoundBox size=(0.45, 0.47, 0.11) roundness=0.05
                                Union
                                    Translate translation=(-0.030, 0.030, 0.11)
                                        Box size=(0.06, 0.28, 0.05)
            # L
            Translate translation=(0.15, 0.64, 0.192)
                Rotate rotation=(-0.35, 0.05, 0)
                    Union
                        Material material=game_ivory
                            RoundBox size=(0.45, 0.47, 0.11) roundness=0.05
                        Material material=game_pip_black
                            Intersection
                                RoundBox size=(0.45, 0.47, 0.11) roundness=0.05
                                Union
                                    Translate translation=(-0.140, 0.030, 0.11)
                                        Box size=(0.06, 0.28, 0.05)
                                    Translate translation=(-0.020, -0.190, 0.11)
                                        Box size=(0.18, 0.06, 0.05)
            # E
            Translate translation=(1.3, 0.64, 0.192)
                Rotate rotation=(-0.35, -0.06, 0)
                    Union
                        Material material=game_ivory
                            RoundBox size=(0.45, 0.47, 0.11) roundness=0.05
                        Material material=game_pip_black
                            Intersection
                                RoundBox size=(0.45, 0.47, 0.11) roundness=0.05
                                Union
                                    Translate translation=(-0.140, 0.030, 0.11)
                                        Box size=(0.06, 0.28, 0.05)
                                    Translate translation=(-0.020, -0.190, 0.11)
                                        Box size=(0.18, 0.06, 0.05)
                                    Translate translation=(-0.020, 0.250, 0.11)
                                        Box size=(0.18, 0.06, 0.05)
                                    Translate translation=(-0.040, 0.030, 0.11)
                                        Box size=(0.14, 0.055, 0.05)
