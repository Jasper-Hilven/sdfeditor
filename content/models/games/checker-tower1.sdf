                Rotate rotation=(-0.044, 0, -0.035)
                    Part part=draught
        Material material=game_ivory
            Translate translation=(0.230, 3.730, -0.193)
                Rotate rotation=(-0.057, 0, -0.045)
                    Part part=draught
        Material material=game_ivory
            Translate translation=(0.179, 4.085, -0.280)
                Rotate rotation=(-0.045, 0, -0.036)
                    Part part=draught
