# Domino 6-3, lying: the giant 6-3 domino (domino_6_3) knocked flat on its back, face up, 2 m wide, 4 m long and 0.64 m high: low
# enough to climb onto, its six end towards -z.
format 1
collider mesh

Translate translation=(0, 0.32, 0)
    # A quarter turn about x lays the face (+z) up
    Rotate rotation=(-1.5707964, 0, 0)
        Part part=domino_6_3
