# Checker tower 2: twenty giant draughts stacked 7.2 m high, a red and black game below and an ivory and black one piled on
# top, the tower leaning and sagging over to -x, each draught pushed a little off the one below. Each draught (the draught part) is 1.8 m across and 0.36 m thick, tipped a
# touch along the lean, in glossy red (game_die_red), black (game_domino_black) or ivory (game_ivory). Cover to hide behind.
format 1
collider convex

# A twelfth of the vertices its size would give it, its draughts too, about 360 triangles a draught: plain discs, and
# a tower is scattered cover
Detail detail=0.08
    Union
        Material material=game_die_red
            Translate translation=(0.000, 0.180, 0.000)
                Rotate rotation=(0.000, 0, -0.000)
                    Part part=draught
        Material material=game_domino_black
            Translate translation=(-0.030, 0.535, 0.038)
                Rotate rotation=(0.005, 0, 0.020)
                    Part part=draught
        Material material=game_domino_black
            Translate translation=(-0.047, 0.890, -0.000)
                Rotate rotation=(0.011, 0, 0.043)
                    Part part=draught
