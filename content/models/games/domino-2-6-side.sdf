# Domino 2-6, lying: the giant 2-6 domino (domino_2_6) fallen flat on its face, so only its plain ivory back shows from above and
# the edges of its red pips peep out underneath, 2 m wide, 4 m long and 0.64 m high, with one end propped up on a pip.
format 1
collider mesh

# Half the vertices its size would give it, and its parts half too: big, simple forms, and dozens of game pieces lie on the
# board
Detail detail=0.5
    Translate translation=(0, 0.36, 0)
        # A quarter turn about x the other way lays the face down, and a little tilt rests it on its pips at one end
        Rotate rotation=(1.5307964, 0, 0)
            Part part=domino_2_6
