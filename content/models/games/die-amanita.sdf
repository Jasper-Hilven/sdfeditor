# Amanita die: a giant six-sided die 2.2 m on a side, lacquered fly-agaric red with soft rounded edges, its pips the agaric's
# white warts (die_pips), standing flat on the board with the one on top.
format 1
collider convex

# Half the vertices its size would give it, and its parts half too: big, simple forms, and dozens of game pieces lie on the
# board
Detail detail=0.5
    Translate translation=(0, 1.1, 0)
        # The pips grow out of the faces with a small fillet, like warts on a cap
        SmoothUnion smoothness=0.03
            Material material=game_cap_red
                RoundBox size=(1.1, 1.1, 1.1) roundness=0.22
            Material material=game_wart_white
                # Inside an intersection with a box round the die, the pips stay in the die's own mesh, filleted
                Intersection
                    Box size=(1.3, 1.3, 1.3)
                    Part part=die_pips
