# Low chip stack 0: two giant poker chips (poker_chip_plain_red, poker_chip_plain_blue: the poker chip stack's chips with only
# their boldest paint), each 2.4 m across, lying one on the other 0.64 m high, the top one turned and pushed 0.25 m off to +x
# and -z. Knee-high cover, the poker chip stack's little sister.
format 1
collider convex

# A tenth of the vertices its size would give it, its chips too, about 950 triangles a chip: the plain chips keep only
# their boldest paint, and this is scattered cover
Detail detail=0.1
    Union
        Translate translation=(0, 0.16, 0)
            Rotate rotation=(0, 0.3, 0)
                Part part=poker_chip_plain_red
        Translate translation=(0.2, 0.48, -0.15)
            Rotate rotation=(0, 1.6, 0)
                Part part=poker_chip_plain_blue
