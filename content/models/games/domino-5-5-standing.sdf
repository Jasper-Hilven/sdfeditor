# Domino 5-5, standing: the giant double five (domino_5_5) on its end, 2 m wide, 4 m tall and 0.64 m thick, its face to +z: a wall
# to hide behind.
format 1
collider mesh

# Half the vertices its size would give it, and its parts half too: big, simple forms, and dozens of game pieces lie on the
# board
Detail detail=0.5
    Translate translation=(0, 2, 0)
        Part part=domino_5_5
