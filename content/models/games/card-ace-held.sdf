# Card, ace propped: the giant ace of spades (card_ace), 3 m wide and 4.2 m tall, standing on its bottom edge leaning back 14° with its
# top edge resting against a king (card_king) planted upright behind it, its face to +z: a card soldier keeping guard on the board.
format 1
collider mesh

# Half the vertices its size would give it, and its parts half too: big, simple forms, and dozens of game pieces lie on the
# board
Detail detail=0.5
    Union
        # The ace, its bottom edge sunk 10 cm into the ground, leaning back towards -z (a negative turn about x)
        Translate translation=(0, -0.1, 0)
            Rotate rotation=(-0.2443, 0, 0)
                Translate translation=(0, 2.1, 0)
                    Part part=card_ace
        # The king behind it, upright, turned round to show its face to -z, its bottom edge sunk 5 cm; the ace's top edge rests on it
        Translate translation=(0, 2.05, -1.1)
            Rotate rotation=(0, 3.1415927, 0)
                Part part=card_king
