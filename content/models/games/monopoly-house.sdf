# Monopoly house: the giant mushroom house (monopoly_house), 3.4 m tall under its blue-green cap, standing upright with its door
# to +z.
format 1
collider mesh

# Half the vertices its size would give it, and its parts half too: big, simple forms, and dozens of game pieces lie on the
# board
Detail detail=0.5
    Part part=monopoly_house
