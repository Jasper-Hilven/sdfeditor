# Monopoly hotel: the board game's hotel blown up to 4.4 m tall, the house's big red sister. A long, two-storey red block 5 m
# wide and 2.5 m deep under a darker red gabled roof, its ridge along x and its eaves overhanging the walls. An arched double
# door in front (+z) and another at the back, painted windows on both floors and both ends, and a plain chimney on the roof.
format 1
collider mesh

# Half the vertices its size would give it, and its parts half too: big, simple forms, and dozens of game pieces lie on the
# board
Detail detail=0.5
    Union
        # The walls, with the door and window recesses cut in
        Material material=monopoly_red
            Subtraction
                Translate translation=(0, 1.45, 0)
                    RoundBox size=(2.5, 1.45, 1.25) roundness=0.12
                Union
                    SymmetryXZ
                        Union
                            # The doorway: a wide round-headed arch
                            Translate translation=(0, 0.65, 1.25)
                                Box size=(0.5, 0.65, 0.15)
                            ArbitraryCappedCylinder a=(0, 1.3, 1.1) b=(0, 1.3, 1.4) radius=0.5
                            # The window recesses on the long sides, either side of the door on both floors
                            Translate translation=(1.55, 1, 1.25)
                                Box size=(0.25, 0.3, 0.15)
                            Translate translation=(1.55, 2.25, 1.25)
                                Box size=(0.25, 0.3, 0.15)
                    # The ends: a window on each floor
                    SymmetryX
                        Union
                            Translate translation=(2.5, 1, 0)
                                Box size=(0.15, 0.3, 0.25)
                            Translate translation=(2.5, 2.25, 0)
                                Box size=(0.15, 0.3, 0.25)

        # The roof: a gabled prism, ridge along x, overhanging the walls all round
        Material material=monopoly_red_roof
            Translate translation=(0, 2.88, 0)
                Rotate rotation=(0, 1.5707964, 0)
                    Extrusion height=2.7
                        Triangle2D a=(-1.5, 0) b=(1.5, 0) c=(0, 1.5)

        # The double doors, set 10 cm into the arches
        Material material=game_wood_door
            SymmetryXZ
                Union
                    Translate translation=(0, 0.65, 1.14)
                        Box size=(0.5, 0.65, 0.04)
                    ArbitraryCappedCylinder a=(0, 1.3, 1.1) b=(0, 1.3, 1.18) radius=0.5
                    Translate translation=(0.12, 0.75, 1.2)
                        Sphere radius=0.055

        # The seam between the leaves, a thin dark line
        Material material=monopoly_red_roof
            SymmetryXZ
                Translate translation=(0, 0.9, 1.18)
                    Box size=(0.015, 0.9, 0.02)

        # The painted windows, flush in their recesses, with bars
        Material material=monopoly_window
            Union
                SymmetryXZ
                    Union
                        Translate translation=(1.55, 1, 1.19)
                            Box size=(0.25, 0.3, 0.04)
                        Translate translation=(1.55, 2.25, 1.19)
                            Box size=(0.25, 0.3, 0.04)
                SymmetryX
                    Union
                        Translate translation=(2.4, 1, 0)
                            Box size=(0.04, 0.3, 0.25)
                        Translate translation=(2.4, 2.25, 0)
                            Box size=(0.04, 0.3, 0.25)

        # The chimney: a plain block through the roof
        Material material=monopoly_red_roof
            Translate translation=(1.6, 3.95, -0.3)
                RoundBox size=(0.22, 0.45, 0.22) roundness=0.02
