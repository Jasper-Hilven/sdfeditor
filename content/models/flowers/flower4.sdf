# Flower 4: a stylized lupin about 0.72 m tall, a straight, sturdy stem rising from two palmate leaves of seven pointed leaflets
# each, carrying a tall tapering spike of purple-pink florets: little round blobs in rings round the stem, eleven rings from fat at
# the bottom to small at the rounded tip.
format 1

# Twice the vertices its size would give it, like the other flowers
Detail detail=2
    Union
        Material material=flower_stem
            SmoothUnion smoothness=0.008
                # The stem, up into the tip of the spike
                Capsule a=(0, 0.005, 0) b=(0, 0.66, 0) radius=0.013
                # Two palmate leaves on short stalks, their leaflets spread like hands
                Capsule a=(0, 0.01, 0) b=(0.1, 0.13, 0.06) radius=0.006
                VesicaSegment a=(0.1, 0.13, 0.06) b=(0.166, 0.142, 0.096) width=0.014
                VesicaSegment a=(0.1, 0.13, 0.06) b=(0.113, 0.142, 0.134) width=0.014
                VesicaSegment a=(0.1, 0.13, 0.06) b=(0.05, 0.142, 0.116) width=0.014
                VesicaSegment a=(0.1, 0.13, 0.06) b=(0.025, 0.142, 0.056) width=0.014
                VesicaSegment a=(0.1, 0.13, 0.06) b=(0.056, 0.142, -0.001) width=0.014
                VesicaSegment a=(0.1, 0.13, 0.06) b=(0.12, 0.142, -0.012) width=0.014
                VesicaSegment a=(0.1, 0.13, 0.06) b=(0.169, 0.142, 0.031) width=0.014
                Capsule a=(0, 0.01, 0) b=(-0.09, 0.1, -0.07) radius=0.006
                VesicaSegment a=(-0.09, 0.1, -0.07) b=(-0.022, 0.112, -0.103) width=0.014
                VesicaSegment a=(-0.09, 0.1, -0.07) b=(-0.022, 0.112, -0.038) width=0.014
                VesicaSegment a=(-0.09, 0.1, -0.07) b=(-0.073, 0.112, 0.003) width=0.014
                VesicaSegment a=(-0.09, 0.1, -0.07) b=(-0.137, 0.112, -0.011) width=0.014
                VesicaSegment a=(-0.09, 0.1, -0.07) b=(-0.165, 0.112, -0.07) width=0.014
                VesicaSegment a=(-0.09, 0.1, -0.07) b=(-0.137, 0.112, -0.129) width=0.014
                VesicaSegment a=(-0.09, 0.1, -0.07) b=(-0.073, 0.112, -0.143) width=0.014
        # The spike of florets, ring above ring, a plain union so each floret keeps its own round bulge
        Material material=lupin_petal
