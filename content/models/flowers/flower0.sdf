# Flower 0: a stylized daisy about 0.5 m tall, a thin green stem leaning gently up from a rosette of three chunky leaves on the
# ground to a single flower head tilted towards the front: a ring of fourteen fat white petals round a domed, pollen-yellow centre.
# Oversized for the forest floor, like the grass turfs, so it reads at a distance.
format 1

# Twice the vertices its size would give it: the stem and petals are thin next to the flower's height
Detail detail=2
    Union
        Material material=flower_stem
            SmoothUnion smoothness=0.01
                # The stem, leaning a little towards the front
                Capsule a=(0, 0.005, 0) b=(0.03, 0.46, 0.02) radius=0.011
                # The rosette of leaves lying out over the ground, thick and pointed
                VesicaSegment a=(0, 0.005, 0) b=(0.157, 0.05, 0.066) width=0.026
                VesicaSegment a=(0, 0.005, 0) b=(-0.12, 0.06, 0.09) width=0.026
                VesicaSegment a=(0, 0.005, 0) b=(-0.064, 0.045, -0.147) width=0.026
        # The petals, radiating from under the centre, the whole head tilted towards the front
        Material material=daisy_petal
            Union
                VesicaSegment a=(0.065, 0.46, 0.02) b=(0.145, 0.471, 0.024) width=0.017
                VesicaSegment a=(0.062, 0.455, 0.034) b=(0.134, 0.454, 0.071) width=0.017
                VesicaSegment a=(0.052, 0.451, 0.046) b=(0.102, 0.44, 0.109) width=0.017
                VesicaSegment a=(0.038, 0.448, 0.052) b=(0.056, 0.433, 0.129) width=0.017
                VesicaSegment a=(0.022, 0.448, 0.052) b=(0.004, 0.433, 0.129) width=0.017
                VesicaSegment a=(0.008, 0.451, 0.046) b=(-0.042, 0.44, 0.109) width=0.017
                VesicaSegment a=(-0.002, 0.455, 0.034) b=(-0.074, 0.454, 0.071) width=0.017
                VesicaSegment a=(-0.005, 0.46, 0.02) b=(-0.085, 0.471, 0.024) width=0.017
                VesicaSegment a=(-0.002, 0.465, 0.006) b=(-0.074, 0.488, -0.023) width=0.017
                VesicaSegment a=(0.008, 0.469, -0.006) b=(-0.042, 0.502, -0.06) width=0.017
                VesicaSegment a=(0.022, 0.472, -0.012) b=(0.004, 0.51, -0.081) width=0.017
                VesicaSegment a=(0.038, 0.472, -0.012) b=(0.056, 0.51, -0.081) width=0.017
                VesicaSegment a=(0.052, 0.469, -0.006) b=(0.102, 0.502, -0.06) width=0.017
                VesicaSegment a=(0.062, 0.465, 0.006) b=(0.134, 0.488, -0.023) width=0.017
        # The domed centre, sitting on the petals
        Material material=flower_center
            Translate translation=(0.03, 0.471, 0.024)
                Rotate rotation=(0.35, 0, 0)
                    Ellipsoid radii=(0.042, 0.024, 0.042)
