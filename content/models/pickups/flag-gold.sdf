# Flag gold: the east side's flag, chanterelle gold like the chanterelle scout. A wooden pole 2 m tall (6 cm thick, a brass knob on
# top) with a cloth 0.9 m long and 0.6 m high flying from its upper part as in a steady breeze: two soft waves along its length, a
# swallowtail cut into the free end, and a sleeve round the pole. Separate from its stand, so a player can carry it: the pole's foot
# is the origin, the pole up +y, the cloth flying towards +x and waving in z. flag-red.sdf is the same shape in the west's red.
format 1
collider none

Union
    Material material=flag_pole
        # The pole, its rounded foot on the origin
        ArbitraryRoundCone a=(0, 0.032, 0) b=(0, 1.97, 0) radiusA=0.032 radiusB=0.028
    Material material=flag_brass
        Union
            # The knob on top, and a thin collar under it
            Translate translation=(0, 2.02, 0)
                Sphere radius=0.055
            Translate translation=(0, 1.96, 0)
                RoundedCylinder radius=0.04 roundness=0.01 height=0.015
    Material material=flag_gold
        Union
            Subtraction
                # The cloth, 2.4 cm thick, from 1.32 m to 1.92 m: seen from above two shallow arcs, one each way, from the pole to
                # 0.9 m out, stood upright
                Translate translation=(0, 1.62, 0)
                    Rotate rotation=(1.5707964, 0, 0)
                        Extrusion height=0.3
                            Union2D
                                Translate2D offset=(0.225, -0.481)
                                    Arc2D sinCos=(0.4237, 0.9058) radius=0.531 thickness=0.012
                                Translate2D offset=(0.675, 0.481)
                                    Rotate2D angle=3.1415927
                                        Arc2D sinCos=(0.4237, 0.9058) radius=0.531 thickness=0.012
                # The swallowtail, a notch 0.22 m deep in the free end
                Extrusion height=0.15
                    Triangle2D a=(0.7, 1.62) b=(0.98, 1.83) c=(0.98, 1.41)
            # The sleeve the cloth hangs from, round the pole
            ArbitraryRoundCone a=(0, 1.34, 0) b=(0, 1.9, 0) radiusA=0.042 radiusB=0.042
