# Pawn, dark: a classic turned pawn 2.7 m tall: a base disc, a plinth, a tapering shaft, a collar, and a round ball for a head.
# One plain material, chess_dark.
format 1
collider convex

# Half the vertices its size would give it: the piece is big, smooth turned forms, and dozens of pieces stand on the board.
Detail detail=0.5
    Union
        Material material=chess_dark
            SmoothUnion smoothness=0.06
                Translate translation=(0, 0.1, 0)
                    RoundedCylinder radius=0.85 roundness=0.06 height=0.1
                Translate translation=(0, 0.35, 0)
                    Round radius=0.03
                        CappedCone height=0.15 bottomRadius=0.697 topRadius=0.5
                Translate translation=(0, 0.975, 0)
                    Round radius=0.03
                        CappedCone height=0.525 bottomRadius=0.46 topRadius=0.2
                Translate translation=(0, 1.55, 0)
                    RoundedCylinder radius=0.48 roundness=0.05 height=0.07
                Translate translation=(0, 1.725, 0)
                    Round radius=0.03
                        CappedCone height=0.125 bottomRadius=0.22 topRadius=0.3
                Translate translation=(0, 2.08, 0)
                    Sphere radius=0.62
