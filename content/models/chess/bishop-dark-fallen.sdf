# Bishop, dark, fallen: the dark bishop (bishop-dark.sdf) knocked over in the board's chaos and lying on its side.
# Placements only turn a model about the vertical, so the fall is in the model: the upright piece below, tipped over and lifted
# until it rests on the ground. Keep the shape in step with bishop-dark.sdf.
format 1
collider convex

# Half the vertices its size would give it: the piece is big, smooth turned forms, and dozens of pieces stand on the board.
Detail detail=0.5
    Translate translation=(0, 1.04, 0)
        Rotate rotation=(0, 0, 1.6708)
            Union
                Material material=chess_dark
                    SmoothUnion smoothness=0.05
                        Translate translation=(0, 0.12, 0)
                            RoundedCylinder radius=1.0 roundness=0.06 height=0.12
                        Translate translation=(0, 0.42, 0)
                            Round radius=0.03
                                CappedCone height=0.18 bottomRadius=0.82 topRadius=0.55
                        Translate translation=(0, 1.425, 0)
                            Round radius=0.03
                                CappedCone height=0.875 bottomRadius=0.5 topRadius=0.27
                        Translate translation=(0, 2.3, 0)
                            RoundedCylinder radius=0.62 roundness=0.05 height=0.09
                        Translate translation=(0, 2.55, 0)
                            Round radius=0.03
                                CappedCone height=0.2 bottomRadius=0.3 topRadius=0.42
                        Subtraction
                            Translate translation=(0, 3.5, 0)
                                Ellipsoid radii=(0.6, 0.9, 0.6)
                            Translate translation=(0.1, 3.85, 0)
                                Rotate rotation=(0, 0, 0.75)
                                    Box size=(0.75, 0.045, 0.9)
                        Translate translation=(0, 4.33, 0)
                            Sphere radius=0.17
