# Rook, light, fallen: the light rook (rook-light.sdf) knocked over in the board's chaos and lying on its side.
# Placements only turn a model about the vertical, so the fall is in the model: the upright piece below, tipped over and lifted
# until it rests on the ground. Keep the shape in step with rook-light.sdf.
format 1
collider convex

# Half the vertices its size would give it: the piece is big, smooth turned forms, and dozens of pieces stand on the board.
Detail detail=0.5
    Translate translation=(0, 1.08, 0)
        Rotate rotation=(-1.5708, 0, 0)
            Union
                Material material=chess_light
                    SmoothUnion smoothness=0.05
                        Translate translation=(0, 0.12, 0)
                            RoundedCylinder radius=1.08 roundness=0.06 height=0.12
                        Translate translation=(0, 0.43, 0)
                            Round radius=0.03
                                CappedCone height=0.19 bottomRadius=0.8856 topRadius=0.7
                        Translate translation=(0, 1.25, 0)
                            Round radius=0.03
                                CappedCone height=0.7 bottomRadius=0.66 topRadius=0.55
                        Translate translation=(0, 2.2, 0)
                            Round radius=0.03
                                CappedCone height=0.3 bottomRadius=0.55 topRadius=0.92
                        Subtraction
                            Translate translation=(0, 2.9, 0)
                                RoundedCylinder radius=1.0 roundness=0.12 height=0.5
                            Union
                                Translate translation=(0, 3.45, 0)
                                    CappedCylinder radius=0.66 height=0.26
                                Translate translation=(0, 3.4, 0)
                                    Union
                                        Box size=(1.4, 0.22, 0.19)
                                        Box size=(0.19, 0.22, 1.4)
                                        Rotate rotation=(0, 0.7853982, 0)
                                            Union
                                                Box size=(1.4, 0.22, 0.19)
                                                Box size=(0.19, 0.22, 1.4)
