# Knight, light, fallen: the light knight (knight-light.sdf) knocked over in the board's chaos and lying on its side.
# Placements only turn a model about the vertical, so the fall is in the model: the upright piece below, tipped over and lifted
# until it rests on the ground. Keep the shape in step with knight-light.sdf.
format 1
collider convex

# Half the vertices its size would give it: the piece is big, smooth turned forms, and dozens of pieces stand on the board.
Detail detail=0.5
    Translate translation=(0, 1.14, 0)
        Rotate rotation=(0, 0, 1.6208)
            Union
                Material material=chess_light
                    SmoothUnion smoothness=0.06
                        Translate translation=(0, 0.12, 0)
                            RoundedCylinder radius=1.05 roundness=0.06 height=0.12
                        Translate translation=(0, 0.44, 0)
                            Round radius=0.03
                                CappedCone height=0.2 bottomRadius=0.861 topRadius=0.66
                        Translate translation=(0, 1.05, 0)
                            Round radius=0.03
                                CappedCone height=0.45 bottomRadius=0.62 topRadius=0.55
                        Translate translation=(0, 1.3, 0)
                            RoundedCylinder radius=0.72 roundness=0.05 height=0.09
                        SmoothUnion smoothness=0.12
                            Translate translation=(0, 2.85, 0.35)
                                Rotate rotation=(0.5, 0, 0)
                                    Ellipsoid radii=(0.4, 0.48, 0.8)
                            Translate translation=(0, 2.52, 0.95)
                                Rotate rotation=(0.6, 0, 0)
                                    Ellipsoid radii=(0.3, 0.28, 0.45)
                            SymmetryX
                                ArbitraryRoundCone a=(0.2, 3.15, -0.05) b=(0.25, 3.68, -0.2) radiusA=0.14 radiusB=0.035
                            ArbitraryRoundCone a=(0, 1.5, -0.05) b=(0, 2.85, 0) radiusA=0.58 radiusB=0.4
                            Translate translation=(0, 1.95, -0.55)
                                Sphere radius=0.2
                            Translate translation=(0, 2.3, -0.58)
                                Sphere radius=0.21
                            Translate translation=(0, 2.65, -0.55)
                                Sphere radius=0.21
                            Translate translation=(0, 3, -0.48)
                                Sphere radius=0.2
                            Translate translation=(0, 3.3, -0.35)
                                Sphere radius=0.17
