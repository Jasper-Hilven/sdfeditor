# King, dark: a classic turned king 5.6 m tall: a base disc, a long shaft, a collar flaring into a crown band, a domed crown and a cross standing on top.
# One plain material, chess_dark.
format 1
collider convex

# Half the vertices its size would give it: the piece is big, smooth turned forms, and dozens of pieces stand on the board.
Detail detail=0.5
    Union
        Material material=chess_dark
            SmoothUnion smoothness=0.05
                Translate translation=(0, 0.14, 0)
                    RoundedCylinder radius=1.18 roundness=0.06 height=0.14
                Translate translation=(0, 0.515, 0)
                    Round radius=0.03
                        CappedCone height=0.235 bottomRadius=0.9675999999999999 topRadius=0.62
                Translate translation=(0, 2.05, 0)
                    Round radius=0.03
                        CappedCone height=1.35 bottomRadius=0.6 topRadius=0.34
                Translate translation=(0, 3.5, 0)
                    RoundedCylinder radius=0.74 roundness=0.05 height=0.1
                Translate translation=(0, 3.9, 0)
                    Round radius=0.03
                        CappedCone height=0.35 bottomRadius=0.34 topRadius=0.88
                Translate translation=(0, 4.32, 0)
                    RoundedCylinder radius=0.9 roundness=0.05 height=0.1
                Intersection
                    Translate translation=(0, 4.3, 0)
                        Sphere radius=0.66
                    Translate translation=(0, 4.8, 0)
                        Box size=(1, 0.55, 1)
                Capsule a=(0, 4.8, 0) b=(0, 5.48, 0) radius=0.13
