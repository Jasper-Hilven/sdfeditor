# Queen, light: a classic turned queen 5 m tall: a base disc, a long slender shaft, a collar flaring into a cup, a coronet of eight beads round its rim, a dome in it and a ball on the very top.
# One plain material, chess_light.
format 1
collider convex

# Half the vertices its size would give it: the piece is big, smooth turned forms, and dozens of pieces stand on the board.
Detail detail=0.5
    Union
        Material material=chess_light
            SmoothUnion smoothness=0.05
                Translate translation=(0, 0.13, 0)
                    RoundedCylinder radius=1.12 roundness=0.06 height=0.13
                Translate translation=(0, 0.48, 0)
                    Round radius=0.03
                        CappedCone height=0.22 bottomRadius=0.9184 topRadius=0.58
                Translate translation=(0, 1.825, 0)
                    Round radius=0.03
                        CappedCone height=1.175 bottomRadius=0.55 topRadius=0.3
                Translate translation=(0, 3.05, 0)
                    RoundedCylinder radius=0.64 roundness=0.05 height=0.1
                Translate translation=(0, 3.525, 0)
                    Round radius=0.03
                        CappedCone height=0.425 bottomRadius=0.3 topRadius=0.95
                SymmetryXZ
                    Union
                        Translate translation=(0.84, 4.02, 0.34)
                            Sphere radius=0.16
                        Translate translation=(0.34, 4.02, 0.84)
                            Sphere radius=0.16
                Intersection
                    Translate translation=(0, 3.95, 0)
                        Sphere radius=0.7
                    Translate translation=(0, 4.5, 0)
                        Box size=(1, 0.5, 1)
                Translate translation=(0, 4.77, 0)
                    Sphere radius=0.23
