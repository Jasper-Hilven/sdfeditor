# Knight, dark: a mushroom 3.7 m tall grown into a chess knight's horse head. A broad foot with a swollen bulb and a short stem
# up to a flared ring, then the stem rears up and back as a thick neck, and its cap is stretched forward and down into a long
# horse's head with a rounded snout and two pointed ears. A fan of gills runs down the back of the neck as the mane. Floating
# eyes either side of the head, like a horse's, and floating hands by the collar.
format 1
collider convex

# Half the vertices its size would give it: the piece is big, smooth turned forms, and dozens of pieces stand on the board,
# so its eyes and hands get half too
Detail detail=0.5
    Union
        SmoothUnion smoothness=0.05
            # The head: an egg of a cap tipped forward, a smaller one for the muzzle, and the ears
            Material material=chess_dark_cap
                SmoothUnion smoothness=0.15
                    Translate translation=(0, 2.95, 0.3)
                        Rotate rotation=(0.5, 0, 0)
                            Ellipsoid radii=(0.48, 0.46, 0.85)
                    Translate translation=(0, 2.52, 0.92)
                        Rotate rotation=(0.6, 0, 0)
                            Ellipsoid radii=(0.38, 0.3, 0.42)
                    SymmetryX
                        ArbitraryRoundCone a=(0.24, 3.3, 0.0) b=(0.34, 3.78, -0.14) radiusA=0.13 radiusB=0.03
            # The mane: a thin fan of gills along the back of the neck
            Material material=chess_dark_gills
                Translate translation=(0, 2.5, -0.5)
                    Rotate rotation=(-0.3, 0, 0)
                        RadialWave amount=0.08 count=9
                            Ellipsoid radii=(0.13, 1.05, 0.5)
            # Foot, bulb, stem, collar and the rearing neck, all of one flesh and grown into each other
            Material material=chess_dark_stem
                SmoothUnion smoothness=0.08
                    Translate translation=(0, 0.12, 0)
                        RoundedCylinder radius=1.05 roundness=0.09 height=0.12
                    Translate translation=(0, 0.34, 0)
                        Torus innerRadius=0.48 outerRadius=0.96
                    Translate translation=(0, 0.82, 0)
                        CappedCone height=0.42 bottomRadius=0.62 topRadius=0.5
                    # The collar: a flared ring, the mushroom's annulus
                    Translate translation=(0, 1.26, 0)
                        Round radius=0.03
                            CappedCone height=0.07 bottomRadius=0.88 topRadius=0.62
                    ArbitraryRoundCone a=(0, 1.3, -0.05) b=(0, 2.7, -0.08) radiusA=0.58 radiusB=0.4

        # Floating eyes, mirrored, either side of the head and looking forward and out, and floating hands by the collar
        SymmetryX
            Translate translation=(0.5, 3.02, 0.55)
                Rotate rotation=(0, 0.5, 0)
                    Scale scale=(2.2, 2.2, 2.2)
                        Part part=eye
        SymmetryX
            Translate translation=(0.92, 1.5, 0.35)
                Material material=chess_dark_stem
                    Scale scale=(2.5, 2.5, 2.5)
                        Part part=hand
