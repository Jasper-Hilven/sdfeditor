# Pawn, dark, fallen: the dark pawn (pawn-dark.sdf) knocked over in the board's chaos and lying on its side, its head towards -x,
# its head end a little lower than its foot so both rest on the ground. Placements only turn a model about the vertical, so the
# fall is in the model: the upright piece below, tipped over and lifted until it rests on the ground. Keep the shape in step
# with pawn-dark.sdf.
format 1
collider convex

# Half the vertices its size would give it: the piece is big, smooth turned forms, and dozens of pieces stand on the board,
# so its eyes and hands get half too
Detail detail=0.5
    Translate translation=(0, 0.85, 0)
        Rotate rotation=(0, 0, 1.6508)
            Union
                SmoothUnion smoothness=0.04
                    # The head: a ball of a cap, the top of a sphere, over a thin disc of gills
                    Material material=chess_dark_cap
                        Intersection
                            Translate translation=(0, 2.12, 0)
                                Sphere radius=0.68
                            Translate translation=(0, 2.4, 0)
                                Box size=(0.8, 0.5, 0.8)
                    Material material=chess_dark_gills
                        Translate translation=(0, 1.93, 0)
                            CappedCylinder radius=0.6 height=0.03
                    # Foot, bulb, stem and collar, all of one flesh and grown into each other
                    Material material=chess_dark_stem
                        SmoothUnion smoothness=0.07
                            Translate translation=(0, 0.1, 0)
                                RoundedCylinder radius=0.85 roundness=0.08 height=0.1
                            Translate translation=(0, 0.3, 0)
                                Torus innerRadius=0.36 outerRadius=0.74
                            Translate translation=(0, 0.92, 0)
                                CappedCone height=0.58 bottomRadius=0.42 topRadius=0.22
                            Translate translation=(0, 1.7, 0)
                                CappedCone height=0.2 bottomRadius=0.21 topRadius=0.19
                            # The collar: a flared ring, the mushroom's annulus
                            Translate translation=(0, 1.5, 0)
                                Round radius=0.03
                                    CappedCone height=0.06 bottomRadius=0.5 topRadius=0.3

                # Floating eyes, mirrored, in front of the stem, and floating hands either side of it in the stem's flesh
                SymmetryX
                    Translate translation=(0.19, 1.08, 0.5)
                        Scale scale=(2, 2, 2)
                            Part part=eye
                SymmetryX
                    Translate translation=(0.66, 0.84, 0.2)
                        Material material=chess_dark_stem
                            Scale scale=(2.2, 2.2, 2.2)
                                Part part=hand
