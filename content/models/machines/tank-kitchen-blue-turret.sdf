# Tank turret, blue (ticket 28.8): a pepper pot: a steel dome with a black cap pierced by little holes, on a blue enamelled flange, turning on the tin; the
# scouts' floating eyes hover over the dome's front, looking where the straw barrel points.
# Pivot: the origin is at the bottom of the flange on the turret's axis (it turns about y); in tank-kitchen-blue-body it is at (0, 0.3, 0).
# The barrel's (tank-kitchen-blue-barrel) pivot is at (0, 0.05, 0.13) in this model, in the dome's front.
format 1
collider convex

Detail detail=0.32
    Union
        Material material=machine_blue_paint
            Translate translation=(0, 0.025, 0)
                CappedCylinder radius=0.16 height=0.025
        Material material=kitchen_steel
            Round radius=0.01
                Intersection
                    Translate translation=(0, 0.06, 0)
                        Ellipsoid radii=(0.17, 0.12, 0.17)
                    # A box rather than a plane, so the dome counts towards the model's bounds
                    Translate translation=(0, 0.3, 0)
                        Box size=(0.3, 0.26, 0.3)
        # The cap's holes, a ring of dark dots round a centre one
        Material material=kitchen_black
            Union
                Translate translation=(0, 0.185, 0)
                    Sphere radius=0.02
                Translate translation=(0.05, 0.175, 0)
                    Sphere radius=0.016
                Translate translation=(-0.05, 0.175, 0)
                    Sphere radius=0.016
                Translate translation=(0, 0.175, -0.05)
                    Sphere radius=0.016
        # Eyes, mirrored: the scouts' eyeballs at a little over half size, floating over the dome's front, as eye_machine,
        # the scouts' eye meshed coarser (content/parts/machines)
        SymmetryX
            Translate translation=(0.075, 0.3, 0.07)
                Scale scale=(0.55, 0.55, 0.55)
                    Part part=eye_machine
