# Helicopter rotor, red (ticket 24.1): a flat, wide scarlet cap with a wavy rim of five lobes and pale gills under it, on a little
# hub, spun by script so the lobes blur into a disc.
# Pivot: the origin is the hub's bottom on the rotor's axis (it spins about y); in helicopter-red-body it is at (0, 0.56, 0).
format 1

Union
    Material material=machine_red_flesh
        Translate translation=(0, 0.02, 0)
            CappedCylinder radius=0.035 height=0.025
    Material material=machine_red_gills
        RadialWave amount=0.035 count=5
            Translate translation=(0, 0.035, 0)
                CappedCylinder radius=0.33 height=0.006
    Material material=machine_red_cap
        Round radius=0.008
            RadialWave amount=0.035 count=5
                Intersection
                    Translate translation=(0, 0.03, 0)
                        Ellipsoid radii=(0.35, 0.06, 0.35)
                    Translate translation=(0, 0.23, 0)
                        Box size=(0.4, 0.2, 0.4)
