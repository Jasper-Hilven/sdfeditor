    Union
        Material material=pc_tin
            Union
                Sphere radius=0.04
                ArbitraryCappedCylinder a=(0, 0, 0.2) b=(0, 0, 0.25) radius=0.03
        Material material=pc_ceramic_tan
            ArbitraryCappedCylinder a=(0, 0, 0.02) b=(0, 0, 0.2) radius=0.036
