# Helicopter tail rotor, blue (ticket 28.8): a little bottle cap (mustard, fluted) on a steel hub with a short steel bar across it, facing out to
# the side (+x), spun by script.
# Pivot: the origin is the hub's inner end on the tail rotor's axis (it spins about x); in helicopter-kitchen-blue-body it is at
# (0.025, 0.4, -0.35).
format 1

Detail detail=0.7
    Rotate rotation=(0, 0, -1.5707964)
        Union
            Material material=kitchen_cap_mustard
                Translate translation=(0, 0.012, 0)
                    RadialWave amount=0.007 count=15
                        CappedCylinder radius=0.04 height=0.01
            Material material=kitchen_steel
                Translate translation=(0, 0.03, 0)
                    RoundBox size=(0.01, 0.006, 0.09) roundness=0.005
