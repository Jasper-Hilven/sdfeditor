# Flamethrower: two red fuel tanks slung under a steel body, hoses from the tanks to a long wand inside a ribbed heat shroud, a
# nozzle at the front with a pilot flame burning below it, a carry handle on top and a grip at the back. Points along +z; the tanks
# and the grip rest on the ground.
format 1

Union
    # The fuel tanks, side by side under the body
    Material material=flame_tank
        SymmetryX
            Capsule a=(0.042, 0.085, -0.02) b=(0.042, 0.085, 0.22) radius=0.045

    Material material=flame_steel
        Union
            # The body, and a gauge on its right
            Translate translation=(0, 0.17, -0.08)
                RoundBox size=(0.03, 0.035, 0.14) roundness=0.01
            ArbitraryCappedCylinder a=(0.028, 0.175, -0.03) b=(0.038, 0.175, -0.03) radius=0.02
            # Straps round the tanks
            SymmetryX
                Union
                    Translate translation=(0.042, 0.085, 0.02)
                        Rotate rotation=(1.5707964, 0, 0)
                            Torus innerRadius=0.044 outerRadius=0.054
                    Translate translation=(0.042, 0.085, 0.17)
                        Rotate rotation=(1.5707964, 0, 0)
                            Torus innerRadius=0.044 outerRadius=0.054
                    # Valve caps on the front of the tanks
                    ArbitraryCappedCylinder a=(0.042, 0.085, 0.26) b=(0.042, 0.085, 0.28) radius=0.012
            # The carry handle, an arch over the body
            Intersection
                Translate translation=(0, 0.205, -0.08)
                    Rotate rotation=(0, 0, 1.5707964)
                        Torus innerRadius=0.045 outerRadius=0.062
                Translate translation=(0, 0.3, -0.08)
                    Box size=(0.02, 0.095, 0.1)
            # The trigger guard
            Translate translation=(0, 0.12, -0.115)
                Rotate rotation=(0, 0, 1.5707964)
                    Torus innerRadius=0.02 outerRadius=0.028
            # The wand, the heat shroud around its front with ribs along it, and the nozzle, open at the end
            ArbitraryCappedCylinder a=(0, 0.17, 0.06) b=(0, 0.17, 0.47) radius=0.015
            ArbitraryCappedCylinder a=(0, 0.17, 0.2) b=(0, 0.17, 0.46) radius=0.03
            Translate translation=(0, 0.17, 0.24)
                Rotate rotation=(1.5707964, 0, 0)
                    Torus innerRadius=0.026 outerRadius=0.04
            Translate translation=(0, 0.17, 0.3)
                Rotate rotation=(1.5707964, 0, 0)
                    Torus innerRadius=0.026 outerRadius=0.04
            Translate translation=(0, 0.17, 0.36)
                Rotate rotation=(1.5707964, 0, 0)
                    Torus innerRadius=0.026 outerRadius=0.04
            Translate translation=(0, 0.17, 0.42)
                Rotate rotation=(1.5707964, 0, 0)
                    Torus innerRadius=0.026 outerRadius=0.04
            Subtraction
                ArbitraryCappedCone a=(0, 0.17, 0.46) b=(0, 0.17, 0.52) radiusA=0.03 radiusB=0.022
                ArbitraryCappedCylinder a=(0, 0.17, 0.47) b=(0, 0.17, 0.53) radius=0.012
            # The pilot tube under the nozzle
            Capsule a=(0, 0.14, 0.42) b=(0, 0.13, 0.43) radius=0.006
            ArbitraryCappedCylinder a=(0, 0.13, 0.42) b=(0, 0.13, 0.5) radius=0.008

    # The pilot flame, a teardrop licking forward and up from the pilot tube
    Material material=flame_pilot
        ArbitraryRoundCone a=(0, 0.13, 0.508) b=(0, 0.142, 0.545) radiusA=0.01 radiusB=0.003

    # The grip and trigger, and the hoses from the tanks up into the wand
    Material material=flame_hose
        Union
            Translate translation=(0, 0.09, -0.17)
                Rotate rotation=(0.28, 0, 0)
                    RoundBox size=(0.018, 0.05, 0.023) roundness=0.009
            Capsule a=(0, 0.135, -0.108) b=(0, 0.118, -0.11) radius=0.004
            Capsule a=(0, 0.118, -0.11) b=(0, 0.108, -0.118) radius=0.004
            SymmetryX
                Union
                    Capsule a=(0.042, 0.13, 0.12) b=(0.05, 0.16, 0.15) radius=0.009
                    Capsule a=(0.05, 0.16, 0.15) b=(0.035, 0.172, 0.19) radius=0.009
                    Capsule a=(0.035, 0.172, 0.19) b=(0.015, 0.17, 0.205) radius=0.009
