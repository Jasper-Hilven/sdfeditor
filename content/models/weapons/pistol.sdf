# Pistol: a blued slide pointing along +z on a tan polymer frame, the grip raked back below it with stippled panels, a trigger in a
# round guard, and a front and rear sight on top. The bottom of the grip rests on the ground.
format 1

Union
    # The slide, with the bore through its front and grooves on each side at the back to rack it by
    Material material=pistol_slide
        Subtraction
            Union
                Translate translation=(0, 0.13, 0.005)
                    RoundBox size=(0.015, 0.017, 0.095) roundness=0.004
                # Front sight, and the rear sight with a notch to look through
                Translate translation=(0, 0.149, 0.088)
                    RoundBox size=(0.0025, 0.004, 0.004) roundness=0.001
                Subtraction
                    Translate translation=(0, 0.149, -0.078)
                        RoundBox size=(0.011, 0.004, 0.004) roundness=0.001
                    Translate translation=(0, 0.153, -0.078)
                        Box size=(0.003, 0.004, 0.006)
            Union
                ArbitraryCappedCylinder a=(0, 0.128, 0.07) b=(0, 0.128, 0.11) radius=0.0055
                SymmetryX
                    Union
                        Translate translation=(0.016, 0.132, -0.055)
                            Box size=(0.003, 0.01, 0.0015)
                        Translate translation=(0.016, 0.132, -0.065)
                            Box size=(0.003, 0.01, 0.0015)
                        Translate translation=(0.016, 0.132, -0.075)
                            Box size=(0.003, 0.01, 0.0015)

    # The frame under the slide, grown into the raked grip, with the trigger guard below its front
    Material material=pistol_frame
        Union
            SmoothUnion smoothness=0.008
                Translate translation=(0, 0.1, 0.01)
                    RoundBox size=(0.0145, 0.014, 0.085) roundness=0.004
                # The grip, its bottom further back than its top
                Translate translation=(0, 0.052, -0.058)
                    Rotate rotation=(0.28, 0, 0)
                        RoundBox size=(0.015, 0.05, 0.022) roundness=0.007
            # The trigger guard, a ring standing in the gun's plane, its top half hidden in the frame
            Translate translation=(0, 0.078, 0.008)
                Rotate rotation=(0, 0, 1.5707964)
                    Torus innerRadius=0.019 outerRadius=0.027

    # Stippled panels on both sides of the grip
    Material material=pistol_grip
        SymmetryX
            Translate translation=(0.006, 0.048, -0.059)
                Rotate rotation=(0.28, 0, 0)
                    RoundBox size=(0.011, 0.038, 0.018) roundness=0.005

    # The trigger, curving down and back inside the guard
    Material material=pistol_slide
        Union
            Capsule a=(0, 0.09, 0.014) b=(0, 0.078, 0.013) radius=0.0035
            Capsule a=(0, 0.078, 0.013) b=(0, 0.069, 0.006) radius=0.0035
