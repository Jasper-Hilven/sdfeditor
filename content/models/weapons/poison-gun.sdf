# Poison gun: a glass bulb of glowing toxin caged in brass on top of a grimy purple body, a hose from the bulb to the barrel, a valve
# wheel on the left and a bulbous nozzle, open at the front. Points along +z; the bottom of the grip rests on the ground.
format 1

Union
    # The body, tapering forward, with the trigger guard below
    Material material=poison_metal
        Union
            SmoothUnion smoothness=0.015
                ArbitraryRoundCone a=(0, 0.125, -0.2) b=(0, 0.125, 0.08) radiusA=0.05 radiusB=0.038
                # The nozzle, a bulb around the end of the barrel
                Translate translation=(0, 0.125, 0.27)
                    Ellipsoid radii=(0.032, 0.032, 0.042)
            Translate translation=(0, 0.075, -0.075)
                Rotate rotation=(0, 0, 1.5707964)
                    Torus innerRadius=0.021 outerRadius=0.029

    Material material=poison_brass
        Union
            # The barrel, and the flared lip of the nozzle, open at the front
            ArbitraryCappedCylinder a=(0, 0.125, 0.07) b=(0, 0.125, 0.25) radius=0.018
            Subtraction
                ArbitraryCappedCone a=(0, 0.125, 0.29) b=(0, 0.125, 0.335) radiusA=0.024 radiusB=0.034
                ArbitraryCappedCone a=(0, 0.125, 0.3) b=(0, 0.125, 0.34) radiusA=0.012 radiusB=0.027
            # Rings around the barrel
            Translate translation=(0, 0.125, 0.13)
                Rotate rotation=(1.5707964, 0, 0)
                    Torus innerRadius=0.016 outerRadius=0.03
            Translate translation=(0, 0.125, 0.19)
                Rotate rotation=(1.5707964, 0, 0)
                    Torus innerRadius=0.016 outerRadius=0.03
            # The bulb's neck and cap, and the cage around it: a band round its middle and a hoop over the top
            ArbitraryCappedCylinder a=(0, 0.16, -0.08) b=(0, 0.185, -0.08) radius=0.038
            Translate translation=(0, 0.318, -0.08)
                CappedCylinder radius=0.018 height=0.008
            Translate translation=(0, 0.25, -0.08)
                Torus innerRadius=0.07 outerRadius=0.086
            Translate translation=(0, 0.25, -0.08)
                Rotate rotation=(0, 0, 1.5707964)
                    Torus innerRadius=0.07 outerRadius=0.084
            # The valve wheel on the left, on a short stem
            ArbitraryCappedCylinder a=(-0.04, 0.13, -0.02) b=(-0.07, 0.13, -0.02) radius=0.005
            Translate translation=(-0.07, 0.13, -0.02)
                Rotate rotation=(0, 0, 1.5707964)
                    Union
                        Torus innerRadius=0.014 outerRadius=0.026
                        CappedCylinder radius=0.008 height=0.004

    # The toxin: a bulb of it on top
    Material material=poison_liquid
        Union
            Translate translation=(0, 0.25, -0.08)
                Sphere radius=0.072

    # The grip and trigger, and the hose curving from the bulb down to the barrel
    Material material=poison_hose
        Union
            Translate translation=(0, 0.06, -0.14)
                Rotate rotation=(0.28, 0, 0)
                    RoundBox size=(0.02, 0.05, 0.025) roundness=0.01
            Capsule a=(0, 0.09, -0.068) b=(0, 0.076, -0.07) radius=0.004
            Capsule a=(0, 0.076, -0.07) b=(0, 0.066, -0.078) radius=0.004
            Capsule a=(0.055, 0.215, -0.03) b=(0.062, 0.18, 0.03) radius=0.01
            Capsule a=(0.062, 0.18, 0.03) b=(0.045, 0.145, 0.09) radius=0.01
            Capsule a=(0.045, 0.145, 0.09) b=(0.015, 0.13, 0.11) radius=0.01
