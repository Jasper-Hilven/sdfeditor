# Mousepad: a cloth mouse pad 0.3 m wide (x) and 0.25 m deep (z), 1 cm thick with rounded edges, lying on the desk: the bottom at
# y = 0, the middle on the origin.
format 1

Material material=home_fabric_pad
    Translate translation=(0, 0.005, 0)
        RoundBox size=(0.15, 0.005, 0.125) roundness=0.004
