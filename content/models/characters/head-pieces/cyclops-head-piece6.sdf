# The cyclops head, bursting: the underside piece (7 of 7). Made by tools/make-head-pieces.py (do not edit by hand): the head
# (the cyclops_head part, so the pieces follow its edits) intersected with the Voronoi cell of one seed; the cells split all of space with
# no gap or overlap, so the pieces together are the head. The cut faces are the head_inner material. Low detail: debris lives seconds.
format 1
collider none
surface part=cyclops_head

Detail detail=0.5
    Intersection
        Part part=cyclops_head
        Material material=head_inner
            Intersection
                Plane normal=(0.0000, 0.9662, 0.2577) height=0.0296
                Plane normal=(0.4027, 0.5492, 0.7323) height=0.0154
                Plane normal=(-0.4027, 0.5492, 0.7323) height=0.0154
                Plane normal=(0.5781, 0.7884, -0.2102) height=0.0221
                Plane normal=(-0.5781, 0.7884, -0.2102) height=0.0221
                Plane normal=(0.0000, 0.1644, 0.9864) height=0.0156
