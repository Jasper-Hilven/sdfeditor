# Castle 0: a blockout castle about 31 m wide and 21 m deep, its gate at the front (+z). Four curtain walls 5 m high and 1.6 m
# thick close round an open courtyard; along their tops, above a string course, runs a 1.2 m wall-walk behind a crenellated
# parapet. A round tower stands at each corner, 9 m high under a pointed roof. The gate is an arched opening 3.2 m wide in the
# middle of the front wall, and on either side of it a straight stair of twenty 25 cm steps (35°) climbs along the inside of the
# front wall to the wall-walk. A plain keep backs onto the rear wall. Blockout forms only: flat faces and crisp edges, so it
# simplifies to few triangles and its coarsest level of detail still keeps the stairs, which is what it collides with.
format 1
collider mesh

Union
    Material material=castle_stone
        Union
            # The curtain walls: a ring of wall round the courtyard, with the gate cut through the front
            Subtraction
                Union
                    Subtraction
                        Translate translation=(0, 2.5, 0)
                            Box size=(15, 2.5, 10)
                        Translate translation=(0, 2.5, 0)
                            Box size=(13.4, 3, 8.4)
                    # A string course round the wall's top, 15 cm proud of its face: it also ends the wall's flat faces, so their
                    # triangles do not fan out to the merlons' corners
                    Subtraction
                        Translate translation=(0, 4.85, 0)
                            Box size=(15.15, 0.15, 10.15)
                        Translate translation=(0, 4.85, 0)
                            Box size=(13.4, 1, 8.4)
                    # The parapet on the outer edge of the wall-walk
                    Subtraction
                        Translate translation=(0, 5.45, 0)
                            Box size=(15, 0.45, 10)
                        Translate translation=(0, 5.45, 0)
                            Box size=(14.6, 1, 9.6)
                    # The merlons on the parapet, 0.7 m wide with 0.5 m gaps: boxes standing on it, along the front and back walls
                    # and along the sides
                    SymmetryXZ
                        Union
                            Translate translation=(0, 6.2, 9.8)
                                LimitedRepetition spacing=1.2 limits=(10, 0, 0)
                                    Box size=(0.35, 0.3, 0.2)
                            Translate translation=(14.8, 6.2, 0)
                                LimitedRepetition spacing=1.2 limits=(0, 0, 6)
                                    Box size=(0.2, 0.3, 0.35)
                # The gate: a passage with a round arch over it, through the front wall
                Union
                    Translate translation=(0, 1.4, 9.2)
                        Box size=(1.6, 1.4, 1.5)
                    ArbitraryCappedCylinder a=(0, 2.8, 7.5) b=(0, 2.8, 10.8) radius=1.6

            # The towers, one at each corner
            SymmetryXZ
                ArbitraryCappedCylinder a=(13, 0, 8) b=(13, 9, 8) radius=2.6

            # The stairs, either side of the gate along the inside of the front wall, from the courtyard up to the wall-walk
            SymmetryX
                Union
                    Translate translation=(6.700, 0.125, 7.6)
                        Box size=(3.500, 0.125, 0.8)
                    Translate translation=(6.875, 0.375, 7.6)
                        Box size=(3.325, 0.125, 0.8)
                    Translate translation=(7.050, 0.625, 7.6)
                        Box size=(3.150, 0.125, 0.8)
                    Translate translation=(7.225, 0.875, 7.6)
                        Box size=(2.975, 0.125, 0.8)
                    Translate translation=(7.400, 1.125, 7.6)
                        Box size=(2.800, 0.125, 0.8)
                    Translate translation=(7.575, 1.375, 7.6)
                        Box size=(2.625, 0.125, 0.8)
                    Translate translation=(7.750, 1.625, 7.6)
                        Box size=(2.450, 0.125, 0.8)
                    Translate translation=(7.925, 1.875, 7.6)
                        Box size=(2.275, 0.125, 0.8)
                    Translate translation=(8.100, 2.125, 7.6)
                        Box size=(2.100, 0.125, 0.8)
                    Translate translation=(8.275, 2.375, 7.6)
                        Box size=(1.925, 0.125, 0.8)
                    Translate translation=(8.450, 2.625, 7.6)
                        Box size=(1.750, 0.125, 0.8)
                    Translate translation=(8.625, 2.875, 7.6)
                        Box size=(1.575, 0.125, 0.8)
                    Translate translation=(8.800, 3.125, 7.6)
                        Box size=(1.400, 0.125, 0.8)
                    Translate translation=(8.975, 3.375, 7.6)
                        Box size=(1.225, 0.125, 0.8)
                    Translate translation=(9.150, 3.625, 7.6)
                        Box size=(1.050, 0.125, 0.8)
                    Translate translation=(9.325, 3.875, 7.6)
                        Box size=(0.875, 0.125, 0.8)
                    Translate translation=(9.500, 4.125, 7.6)
                        Box size=(0.700, 0.125, 0.8)
                    Translate translation=(9.675, 4.375, 7.6)
                        Box size=(0.525, 0.125, 0.8)
                    Translate translation=(9.850, 4.625, 7.6)
                        Box size=(0.350, 0.125, 0.8)
                    Translate translation=(10.025, 4.875, 7.6)
                        Box size=(0.175, 0.125, 0.8)

            # The keep against the rear wall
            Translate translation=(0, 3.5, -5.6)
                Box size=(5, 3.5, 2.8)

    # The towers' and the keep's roofs
    Material material=castle_roof
        Union
            SymmetryXZ
                ArbitraryCappedCone a=(13, 9, 8) b=(13, 12.5, 8) radiusA=3.1 radiusB=0.05
            Translate translation=(0, 7, -5.6)
                Rotate rotation=(0, 1.5708, 0)
                    TriPrism size=(3.4, 5.2)
