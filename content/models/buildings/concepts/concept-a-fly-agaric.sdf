# Concept A, "Fly agaric hold": the castle grown from fly agarics, in the amanita scout's red, white and cream. Four towers are
# giant fly agarics: a white stem flared into a bulb at the foot, the stem's ring as the balcony round the tower at wall-walk height,
# and a domed red cap flecked white over cream gills, modelled at an eighth and scaled up so the flecks read from the field. The
# curtain walls are packed white stems with a wall-walk and parapet on top, crenellated with red button caps. The gate is an arch
# of two stems leaning together under one cap; the keep at the back is a squat giant with glowing windows. Shelf fungi step up
# the inside of the front wall; young fly agarics grow at the wall foot. Same footprint as castle0 (31 x 21 m, gate at +z).
# A concept for ticket 06, one model; the comments name the parts it would split into.
format 1

# Cut off at the ground
Intersection
    Translate translation=(0, 30, 0)
        Box size=(40, 30, 30)
    Union
        # part castle-tower (x4): one tower, placed at each corner by the symmetry
        SymmetryXZ
            Translate translation=(13, 0, 8)
                Scale scale=(8, 8, 8)
                    # The tower at an eighth of its size, so the cap's white flecks come out a hand wide, as on the mushrooms
                    Union
                        # Stem with a flared bulb at its foot, grown into the ground
                        Material material=amanita_stem
                            SmoothUnion smoothness=0.06
                                ArbitraryRoundCone a=(0, 0.12, 0) b=(0, 1.12, 0) radiusA=0.3 radiusB=0.235
                                Translate translation=(0, 0.06, 0)
                                    Ellipsoid radii=(0.36, 0.1, 0.36)
                        # The ring (annulus) at the wall-walk's height, a skirt that is the tower's balcony
                        Material material=amanita_stem
                            Translate translation=(0, 0.655, 0)
                                Round radius=0.006
                                    CappedCone height=0.016 bottomRadius=0.39 topRadius=0.27
                        # A glowing round window under the ring, on the side facing out
                        Material material=flower_center
                            Translate translation=(0.17, 0.46, 0.17)
                                Ellipsoid radii=(0.05, 0.065, 0.05)
                        # Gills under the cap, then the red cap itself, flecked white
                        Material material=amanita_gills
                            Translate translation=(0, 1.135, 0)
                                CappedCylinder radius=0.5 height=0.012
                        Material material=amanita_cap
                            Round radius=0.02
                                Intersection
                                    Translate translation=(0, 1.1, 0)
                                        Ellipsoid radii=(0.54, 0.4, 0.54)
                                    Translate translation=(0, 1.4, 0)
                                        Box size=(0.6, 0.26, 0.6)

        # part castle-wall-bay (x12) and castle-wall-gate: the curtain wall, a core with stems packed along its outer face
        Material material=amanita_stem
            Subtraction
                Union
                    Subtraction
                        Translate translation=(0, 2.4, 0)
                            Box size=(14.8, 2.4, 9.8)
                        Translate translation=(0, 2.4, 0)
                            Box size=(13.6, 3, 8.6)
                    SymmetryXZ
                        Union
                            Translate translation=(0, 0, 9.75)
                                LimitedRepetition spacing=1.3 limits=(9, 0, 0)
                                    ArbitraryRoundCone a=(0, 0.3, 0) b=(0, 4.4, 0) radiusA=0.72 radiusB=0.52
                            Translate translation=(14.75, 0, 0)
                                LimitedRepetition spacing=1.3 limits=(0, 0, 5)
                                    ArbitraryRoundCone a=(0, 0.3, 0) b=(0, 4.4, 0) radiusA=0.72 radiusB=0.52
                    # The wall-walk on top, 1.6 m wide, and the parapet on its outer edge
                    Subtraction
                        Translate translation=(0, 4.8, 0)
                            Box size=(15.1, 0.2, 10.1)
                        Translate translation=(0, 4.8, 0)
                            Box size=(13.4, 1, 8.4)
                    Subtraction
                        Translate translation=(0, 5.3, 0)
                            Box size=(15.1, 0.3, 10.1)
                        Translate translation=(0, 5.3, 0)
                            Box size=(14.7, 1, 9.7)
                # The gate passage, an arched opening through the front wall
                Union
                    Translate translation=(0, 1.4, 9.6)
                        Box size=(1.6, 1.4, 2)
                    ArbitraryCappedCylinder a=(0, 2.8, 7.4) b=(0, 2.8, 11.8) radius=1.6

        # detail merlon (x60): red button caps along the parapet
        SymmetryXZ
            Union
                Translate translation=(0.65, 5.6, 9.9)
                    LimitedRepetition spacing=1.3 limits=(9, 0, 0)
                        # A button mushroom as a merlon: a short stem and a red cap at mushroom scale
                        Union
                            Material material=amanita_stem
                                Translate translation=(0, 0.15, 0)
                                    CappedCylinder radius=0.16 height=0.15
                            Material material=amanita_cap
                                Intersection
                                    Translate translation=(0, 0.3, 0)
                                        Ellipsoid radii=(0.38, 0.3, 0.38)
                                    Translate translation=(0, 0.6, 0)
                                        Box size=(0.4, 0.3, 0.4)
                Translate translation=(14.9, 5.6, 0)
                    LimitedRepetition spacing=1.3 limits=(0, 0, 5)
                        # A button mushroom as a merlon: a short stem and a red cap at mushroom scale
                        Union
                            Material material=amanita_stem
                                Translate translation=(0, 0.15, 0)
                                    CappedCylinder radius=0.16 height=0.15
                            Material material=amanita_cap
                                Intersection
                                    Translate translation=(0, 0.3, 0)
                                        Ellipsoid radii=(0.38, 0.3, 0.38)
                                    Translate translation=(0, 0.6, 0)
                                        Box size=(0.4, 0.3, 0.4)

        # part castle-gate: two stems leaning together over the arch under one cap, a veil of cream hanging under it
        Material material=amanita_stem
            SymmetryX
                ArbitraryRoundCone a=(2.6, 0, 10.7) b=(0.9, 6.2, 10.5) radiusA=0.95 radiusB=0.5
        Translate translation=(0, 6.1, 10.5)
            Scale scale=(4, 4, 4)
                Union
                    Material material=amanita_gills
                        Translate translation=(0, 0.02, 0)
                            CappedCylinder radius=0.62 height=0.01
                    Material material=amanita_cap
                        Round radius=0.02
                            Intersection
                                Ellipsoid radii=(0.66, 0.46, 0.56)
                                Translate translation=(0, 0.3, 0)
                                    Box size=(0.7, 0.28, 0.6)
        Material material=amanita_gills
            Translate translation=(0, 5.3, 10.5)
                Round radius=0.02
                    CappedCone height=0.45 bottomRadius=2.1 topRadius=1.7

        # part castle-keep: a squat giant against the rear wall, its cap above the wall, glowing windows facing the courtyard
        Translate translation=(0, 0, -5.4)
            Scale scale=(10, 10, 10)
                Union
                    Material material=amanita_stem
                        SmoothUnion smoothness=0.08
                            ArbitraryRoundCone a=(0, 0.1, 0) b=(0, 0.75, 0) radiusA=0.36 radiusB=0.3
                            Translate translation=(0, 0.08, 0)
                                Ellipsoid radii=(0.46, 0.14, 0.4)
                    Material material=flower_center
                        Union
                            SymmetryX
                                Translate translation=(0.14, 0.42, 0.29)
                                    Ellipsoid radii=(0.05, 0.07, 0.04)
                            Translate translation=(0, 0.12, 0.32)
                                Ellipsoid radii=(0.08, 0.12, 0.05)
                    Material material=amanita_gills
                        Translate translation=(0, 0.74, 0)
                            CappedCylinder radius=0.6 height=0.01
                    Material material=amanita_cap
                        Round radius=0.02
                            Intersection
                                Translate translation=(0, 0.7, 0)
                                    Ellipsoid radii=(0.64, 0.42, 0.56)
                                Translate translation=(0, 1.05, 0)
                                    Box size=(0.7, 0.3, 0.6)

        # part castle-stair (x2, mirrored): shelf fungi stepping up the inside of the front wall, 25 cm a step
        Material material=amanita_gills
            SymmetryX
                Union
                    Translate translation=(3.400, 0.190, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(3.730, 0.440, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(4.060, 0.690, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(4.390, 0.940, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(4.720, 1.190, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(5.050, 1.440, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(5.380, 1.690, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(5.710, 1.940, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(6.040, 2.190, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(6.370, 2.440, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(6.700, 2.690, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(7.030, 2.940, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(7.360, 3.190, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(7.690, 3.440, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(8.020, 3.690, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(8.350, 3.940, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(8.680, 4.190, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(9.010, 4.440, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(9.340, 4.690, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(9.670, 4.940, 8.6)
                        Ellipsoid radii=(0.42, 0.07, 0.55)

        # detail cluster (x8): young fly agarics at the wall foot
        SymmetryXZ
            Union
                Translate translation=(5, 0, 10.9)
                    # Two young fly agarics, one tall one short, at the foot of the wall
                    Union
                        Material material=amanita_stem
                            Union
                                ArbitraryRoundCone a=(0, 0.05, 0) b=(0, 0.75, 0) radiusA=0.13 radiusB=0.09
                                ArbitraryRoundCone a=(0.45, 0.05, 0.2) b=(0.5, 0.42, 0.2) radiusA=0.1 radiusB=0.07
                        Material material=amanita_cap
                            Union
                                Intersection
                                    Translate translation=(0, 0.72, 0)
                                        Ellipsoid radii=(0.34, 0.24, 0.34)
                                    Translate translation=(0, 1.1, 0)
                                        Box size=(0.4, 0.38, 0.4)
                                Intersection
                                    Translate translation=(0.5, 0.4, 0.2)
                                        Ellipsoid radii=(0.24, 0.2, 0.24)
                                    Translate translation=(0.5, 0.7, 0.2)
                                        Box size=(0.3, 0.3, 0.3)
                Translate translation=(9.4, 0, 10.8)
                    # Two young fly agarics, one tall one short, at the foot of the wall
                    Union
                        Material material=amanita_stem
                            Union
                                ArbitraryRoundCone a=(0, 0.05, 0) b=(0, 0.75, 0) radiusA=0.13 radiusB=0.09
                                ArbitraryRoundCone a=(0.45, 0.05, 0.2) b=(0.5, 0.42, 0.2) radiusA=0.1 radiusB=0.07
                        Material material=amanita_cap
                            Union
                                Intersection
                                    Translate translation=(0, 0.72, 0)
                                        Ellipsoid radii=(0.34, 0.24, 0.34)
                                    Translate translation=(0, 1.1, 0)
                                        Box size=(0.4, 0.38, 0.4)
                                Intersection
                                    Translate translation=(0.5, 0.4, 0.2)
                                        Ellipsoid radii=(0.24, 0.2, 0.24)
                                    Translate translation=(0.5, 0.7, 0.2)
                                        Box size=(0.3, 0.3, 0.3)
                Translate translation=(15.8, 0, 3.6)
                    # Two young fly agarics, one tall one short, at the foot of the wall
                    Union
                        Material material=amanita_stem
                            Union
                                ArbitraryRoundCone a=(0, 0.05, 0) b=(0, 0.75, 0) radiusA=0.13 radiusB=0.09
                                ArbitraryRoundCone a=(0.45, 0.05, 0.2) b=(0.5, 0.42, 0.2) radiusA=0.1 radiusB=0.07
                        Material material=amanita_cap
