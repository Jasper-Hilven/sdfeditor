                                    Translate translation=(0, 0.6, 0)
                                        Box size=(0.4, 0.3, 0.4)

        # part castle-gate: two small porcini guarding the arch
        SymmetryX
            Translate translation=(3.7, 0, 10.9)
                Scale scale=(3.4, 3.4, 3.4)
                    # A porcini at a sixth of its size: a fat barrel stem and a thick brown cap over pale pores
