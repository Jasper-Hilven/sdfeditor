                                    Translate translation=(0, 1.62, 0)
                                        Box size=(0.8, 0.4, 0.8)

        # part castle-keep: the parasol donjon behind the rear wall's middle
        Translate translation=(0, 0, -6)
            Union
                Material material=amanita_stem
                    SmoothUnion smoothness=0.6
                        ArbitraryRoundCone a=(0, 0, 0) b=(0, 20, 0) radiusA=2.2 radiusB=1.3
                        Translate translation=(0, 0.6, 0)
                            Ellipsoid radii=(3.4, 1.6, 3.4)
                # The ring, a balcony above the wall-walk
                Material material=amanita_gills
                    Translate translation=(0, 11, 0)
                        Round radius=0.08
                            CappedCone height=0.35 bottomRadius=3.4 topRadius=2
                Material material=flower_center
