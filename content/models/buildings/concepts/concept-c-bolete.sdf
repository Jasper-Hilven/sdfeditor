                                        Ellipsoid radii=(0.36, 0.32, 0.36)
                                    Translate translation=(0, 0.6, 0)
                                        Box size=(0.4, 0.3, 0.4)
                Translate translation=(14.8, 5.05, 0)
                    LimitedRepetition spacing=1.6 limits=(0, 0, 4)
                        # A button bolete as a merlon
                        Union
