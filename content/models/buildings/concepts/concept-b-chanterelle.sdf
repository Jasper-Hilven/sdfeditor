# Concept B, "Chanterelle bastion": a stone castle with fungus grown through it. The curtain walls are castle0's dressed stone with
# its string course and parapet, but the merlons are capped with small golden domes. The four towers are stone stems swelling to a
# flared foot, each crowned with a golden chanterelle funnel instead of a roof: a wavy rim, its ridges running down underneath, the
# chanterelle scout's cap scaled six times. Bracket fungi climb the towers' outer faces, shelf fungi step up the inside of the front
# wall as stairs, and the gate is ringed by an arch of ridged golden flesh. The keep is a round stone hall under the largest funnel.
# Golden caps against warm grey stone, so it reads as a castle first. Same footprint as castle0 (31 x 21 m, gate at +z).
# A concept for ticket 06, one model; the comments name the parts it would split into.
format 1

# Cut off at the ground
Intersection
    Translate translation=(0, 30, 0)
        Box size=(40, 30, 30)
    Union
        # part castle-tower (x4): a stone stem with a flared foot and a ring of stone at wall-walk height, crowned by a funnel
        SymmetryXZ
            Translate translation=(13, 0, 8)
                Union
                    Material material=castle_stone
                        Union
                            SmoothUnion smoothness=0.8
                                ArbitraryRoundCone a=(0, 0, 0) b=(0, 9.4, 0) radiusA=2.7 radiusB=2.2
                                Translate translation=(0, 0.3, 0)
                                    Ellipsoid radii=(3.5, 1.1, 3.5)
                            Translate translation=(0, 5.1, 0)
                                CappedCylinder radius=2.6 height=0.15
                    Material material=flower_center
                        Union
                            Translate translation=(1.5, 6.8, 1.5)
                                Ellipsoid radii=(0.4, 0.55, 0.4)
                            Translate translation=(1.75, 2.8, 1.25)
                                Ellipsoid radii=(0.3, 0.45, 0.3)
                    Translate translation=(0, 9.1, 0)
                        Scale scale=(6, 6, 6)
                            # A chanterelle's funnel cap and ridges at character size, waved seven times round, scaled up by the use
                            RadialWave amount=0.08 count=7
                                Union
                                    Material material=chanterelle_cap
                                        Union
                                            Revolution offset=0
                                                Translate2D offset=(0.12, 0.05)
                                                    Rotate2D angle=-1.0667
                                                        UnevenCapsule2D bottomRadius=0.07 topRadius=0.018 height=0.66
                                            Translate translation=(0, 0.06, 0)
                                                Ellipsoid radii=(0.2, 0.06, 0.2)
                                    Material material=chanterelle_ridges
                                        SymmetryXZ
                                            Union
                                                Capsule a=(0.164, 0, 0.044) b=(0.58, 0.28, 0.155) radius=0.02
                                                Capsule a=(0.12, 0, 0.12) b=(0.424, 0.28, 0.424) radius=0.02
                                                Capsule a=(0.044, 0, 0.164) b=(0.155, 0.28, 0.58) radius=0.02
                    # detail bracket fungi on the tower's outer face
                    Translate translation=(2.2, 4.0, 1.3)
                        Rotate rotation=(0, 0.5, 0)
                            # Bracket fungi in a step on the stone, golden flesh
                            Material material=chanterelle_flesh
                                Union
                                    Translate translation=(0, 0, 0)
                                        Ellipsoid radii=(0.9, 0.16, 0.6)
                                    Translate translation=(0.5, -0.55, 0.05)
                                        Ellipsoid radii=(0.6, 0.12, 0.45)
                                    Translate translation=(-0.4, -1.0, 0)
                                        Ellipsoid radii=(0.7, 0.13, 0.5)

        # part castle-wall-bay and castle-wall-gate: castle0's curtain wall
        Material material=castle_stone
            Subtraction
                Union
                    Subtraction
                        Translate translation=(0, 2.5, 0)
                            Box size=(15, 2.5, 10)
                        Translate translation=(0, 2.5, 0)
                            Box size=(13.4, 3, 8.4)
                    Subtraction
                        Translate translation=(0, 4.85, 0)
                            Box size=(15.15, 0.15, 10.15)
                        Translate translation=(0, 4.85, 0)
                            Box size=(13.4, 1, 8.4)
                    Subtraction
                        Translate translation=(0, 5.4, 0)
                            Box size=(15, 0.4, 10)
                        Translate translation=(0, 5.4, 0)
                            Box size=(14.6, 1, 9.6)
                    # Buttresses swelling out at the foot like roots, one per bay
                    SymmetryXZ
                        Union
                            Translate translation=(0, 0, 10)
                                LimitedRepetition spacing=4 limits=(2, 0, 0)
                                    Ellipsoid radii=(0.7, 2.2, 0.6)
                            Translate translation=(15, 0, 0)
                                LimitedRepetition spacing=4 limits=(0, 0, 1)
                                    Ellipsoid radii=(0.6, 2.2, 0.7)
                Union
                    Translate translation=(0, 1.4, 9.2)
                        Box size=(1.6, 1.4, 1.5)
                    ArbitraryCappedCylinder a=(0, 2.8, 7.5) b=(0, 2.8, 10.8) radius=1.6

        # detail merlon (x64): stone blocks with golden caps
        SymmetryXZ
            Union
                Translate translation=(0, 5.8, 9.8)
                    LimitedRepetition spacing=1.2 limits=(10, 0, 0)
                        # A merlon: a block of stone capped with a little golden dome
                        Union
                            Material material=castle_stone
                                Translate translation=(0, 0.2, 0)
                                    Box size=(0.32, 0.2, 0.18)
                            Material material=chanterelle_cap
                                Translate translation=(0, 0.4, 0)
                                    Ellipsoid radii=(0.38, 0.16, 0.26)
                Translate translation=(14.8, 5.8, 0)
                    LimitedRepetition spacing=1.2 limits=(0, 0, 6)
                        Rotate rotation=(0, 1.5708, 0)
                            # A merlon: a block of stone capped with a little golden dome
                            Union
                                Material material=castle_stone
                                    Translate translation=(0, 0.2, 0)
                                        Box size=(0.32, 0.2, 0.18)
                                Material material=chanterelle_cap
                                    Translate translation=(0, 0.4, 0)
                                        Ellipsoid radii=(0.38, 0.16, 0.26)

        # part castle-gate: an arch of ridged golden flesh round the opening, like the gills under a cap
        Material material=chanterelle_ridges
            Subtraction
                Union
                    ArbitraryCappedCylinder a=(0, 2.8, 10) b=(0, 2.8, 10.6) radius=2.3
                    SymmetryX
                        Translate translation=(1.95, 1.4, 10.3)
                            Box size=(0.4, 1.4, 0.3)
                Union
                    ArbitraryCappedCylinder a=(0, 2.8, 9.8) b=(0, 2.8, 10.8) radius=1.6
                    Translate translation=(0, 1.4, 10.3)
                        Box size=(1.6, 1.4, 0.5)
                    Translate translation=(0, -1, 10.3)
                        Box size=(3, 1, 1)
        Material material=chanterelle_cap
            Translate translation=(0, 5.6, 10.25)
                Ellipsoid radii=(1.2, 0.5, 0.7)

        # part castle-keep: a round stone hall against the rear wall under the largest funnel, with glowing windows
        Translate translation=(0, 0, -5.4)
            Union
                Material material=castle_stone
                    Translate translation=(0, 4, 0)
                        CappedCylinder radius=3.6 height=4
                Material material=flower_center
                    SymmetryX
                        Translate translation=(1.5, 5, 3.3)
                            Ellipsoid radii=(0.45, 0.65, 0.4)
                Translate translation=(0, 8, 0)
                    Scale scale=(9, 9, 9)
                        # A chanterelle's funnel cap and ridges at character size, waved seven times round, scaled up by the use
                        RadialWave amount=0.08 count=7
                            Union
                                Material material=chanterelle_cap
                                    Union
                                        Revolution offset=0
                                            Translate2D offset=(0.12, 0.05)
                                                Rotate2D angle=-1.0667
                                                    UnevenCapsule2D bottomRadius=0.07 topRadius=0.018 height=0.66
                                        Translate translation=(0, 0.06, 0)
                                            Ellipsoid radii=(0.2, 0.06, 0.2)
                                Material material=chanterelle_ridges
                                    SymmetryXZ
                                        Union
                                            Capsule a=(0.164, 0, 0.044) b=(0.58, 0.28, 0.155) radius=0.02
                                            Capsule a=(0.12, 0, 0.12) b=(0.424, 0.28, 0.424) radius=0.02
                                            Capsule a=(0.044, 0, 0.164) b=(0.155, 0.28, 0.58) radius=0.02

        # part castle-stair (x2, mirrored): shelf fungi stepping up the inside of the front wall, 25 cm a step
        Material material=chanterelle_flesh
            SymmetryX
                Union
                    Translate translation=(3.400, 0.190, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(3.730, 0.440, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(4.060, 0.690, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(4.390, 0.940, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(4.720, 1.190, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(5.050, 1.440, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(5.380, 1.690, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(5.710, 1.940, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(6.040, 2.190, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(6.370, 2.440, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(6.700, 2.690, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(7.030, 2.940, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(7.360, 3.190, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(7.690, 3.440, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(8.020, 3.690, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(8.350, 3.940, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(8.680, 4.190, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(9.010, 4.440, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(9.340, 4.690, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
                    Translate translation=(9.670, 4.940, 8.4)
                        Ellipsoid radii=(0.42, 0.07, 0.55)
