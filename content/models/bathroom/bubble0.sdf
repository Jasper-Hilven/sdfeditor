# Bubble 0: a soap bubble resting on the floor, 0.4 m across (30 times life size). Drawn opaque in pale pearl; the toon rim light shows the
# shine. Ground clutter: no collider.
format 1

# A plain ball
Detail detail=0.16
    Material material=bath_bubble
        Translate translation=(0, 0.2, 0)
            Sphere radius=0.2
