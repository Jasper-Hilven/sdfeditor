# Shampoo 0: a lilac shampoo bottle with a white flip cap, 6.6 m tall, 3.6 m wide and 2.4 m deep (30 times life size, 22 cm), standing on its flat base, an
# oval bottle with rounded shoulders, a cream label on the front (+z) and a domed cap. Tall blocker: convex collider.
format 1
collider convex

# The bottle: an oval body (the round one stretched 1.5 times along x) with the shoulders swept into the neck
body =
    Scale scale=(1.5, 1, 1)
        SmoothUnion smoothness=0.4
            Translate translation=(0, 2.1, 0)
                RoundedCylinder radius=0.95 roundness=0.5 height=2.1
            ArbitraryRoundCone a=(0, 3.2, 0) b=(0, 5.3, 0) radiusA=0.85 radiusB=0.45

Detail detail=0.5
    Union
        Material material=bath_plastic_lilac
            $body
        # The label: a flat oval on the front, a hair proud of the bottle
        Material material=bath_plastic_cream
            Translate translation=(0, 3.0, 1.2)
                Ellipsoid radii=(1.2, 0.8, 0.2)
        # The flip cap: a domed oval lid on the neck
        Material material=bath_plastic_white
            Scale scale=(1.4, 1, 1)
                SmoothUnion smoothness=0.1
                    Translate translation=(0, 5.65, 0)
                        RoundedCylinder radius=0.62 roundness=0.15 height=0.5
                    Translate translation=(0, 5.95, 0)
                        Ellipsoid radii=(0.62, 0.65, 0.62)
