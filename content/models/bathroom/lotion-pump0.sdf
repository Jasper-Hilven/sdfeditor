# Lotion pump 0: a cream lotion bottle with a pump head, 6 m tall and 2.8 m round (30 times life size), a peach label band round the middle, rounded shoulders,
# a neck with a collar, a stem and a pump head with its spout turned to the front (+z). Tall blocker: convex collider.
format 1
collider convex

Detail detail=0.5
    Union
        # The bottle: a round-edged drum with the shoulders swept up into the neck
        Material material=bath_plastic_cream
            SmoothUnion smoothness=0.3
                Translate translation=(0, 1.95, 0)
                    RoundedCylinder radius=1.2 roundness=0.35 height=1.95
                ArbitraryRoundCone a=(0, 3.5, 0) b=(0, 4.6, 0) radiusA=1.1 radiusB=0.55
        # The peach label band, a hair proud of the drum
        Material material=bath_plastic_peach
            Translate translation=(0, 1.9, 0)
                CappedCylinder radius=1.22 height=0.85
        # The pump: collar, stem, head and spout, white
        Material material=bath_plastic_white
            Union
                Translate translation=(0, 4.85, 0)
                    RoundedCylinder radius=0.72 roundness=0.1 height=0.15
                Capsule a=(0, 4.9, 0) b=(0, 5.4, 0) radius=0.3
                SmoothUnion smoothness=0.15
                    Translate translation=(0, 5.5, 0.3)
                        RoundBox size=(0.45, 0.3, 0.6) roundness=0.2
                    Capsule a=(0, 5.5, 0.6) b=(0, 5.42, 1.3) radius=0.2
