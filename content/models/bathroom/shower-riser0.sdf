# Shower riser 0: the bathtub's chrome fittings on the north wall (30 times life size): a mixer tap with two lever handles and a spout (y 20 to 24 m) over the tub, and a
# riser rail 1 m thick going up 40 m to a round shower head 4.5 m across at y = 57 m (nothing below y = 18.5 m, the tub's rim is at 16.5 m). Pale silver chrome, a hard toon
# highlight, no reflection. Origin: the rail's axis on y = 0 (the floor), so the wall is the plane z = -0.5 behind the rail; the front (spout and head) is +z, the level places it
# with yaw 180 on the north wall. Landmark; out of reach, no collider.
format 1
collider none

Detail detail=0.5
    Material material=bath_chrome
        SmoothUnion smoothness=0.25
            # The rail, up to the elbow
            Capsule a=(0, 18.5, 0) b=(0, 58.5, 0) radius=0.5
            # The elbow's arm to the head's neck
            Capsule a=(0, 58.5, 0) b=(0, 58.5, 4.5) radius=0.5
            Capsule a=(0, 58.5, 4.5) b=(0, 57.4, 4.5) radius=0.5
            # The shower head: a round flat disc on a short neck, tilted forward to look down over the tub
            Translate translation=(0, 57, 4.5)
                Rotate rotation=(-0.3, 0, 0)
                    Union
                        CappedCone height=0.5 bottomRadius=2.25 topRadius=2.0
                        Translate translation=(0, 0.7, 0)
                            CappedCone height=0.7 bottomRadius=0.9 topRadius=0.55
            # The mixer: a valve body on the wall with two levers and a spout over the tub
            Capsule a=(0, 22, -0.4) b=(0, 22, 1.4) radius=1.3
            Capsule a=(2.0, 22.2, 0.6) b=(3.6, 23.3, 0.9) radius=0.35
            Capsule a=(-2.0, 22.2, 0.6) b=(-3.6, 23.3, 0.9) radius=0.35
            Translate translation=(3.7, 23.3, 0.9)
                Sphere radius=0.5
            Translate translation=(-3.7, 23.3, 0.9)
                Sphere radius=0.5
            Capsule a=(0, 21.8, 0.8) b=(0, 21.8, 5.2) radius=0.55
            Capsule a=(0, 21.8, 5.2) b=(0, 20.5, 5.2) radius=0.5
