# Swab half 0: half a cotton swab, 1.1 m long (30 times life size), snapped across the stick: a cotton tip 0.3 m long at -z, the stick
# ending in a slanted break at +z. Lying on the floor along z. Ground clutter: no collider.
format 1

# Thin stick with a slanted cut, and one soft tip
Detail detail=0.28
    Union
        Material material=bath_swab_stick
            Subtraction
                Capsule a=(0, 0.14, -0.5) b=(0, 0.14, 0.7) radius=0.05
                Translate translation=(0, 0.14, 1.08)
                    Rotate rotation=(0, 0.3, 0)
                        Box size=(0.5, 0.5, 0.5)
        Material material=bath_cotton
            Translate translation=(0, 0.14, -0.4)
                Ellipsoid radii=(0.14, 0.14, 0.15)
