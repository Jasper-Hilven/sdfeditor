# Birch: a stylized silver birch about 6.8 m tall, a slender pale trunk with a lean and a gentle bend, two thin branches up into a
# tall, narrow oval crown of light green clumps. The black birch marks are painted on by the bark material, not modelled, so the
# slender trunk stays a handful of triangles.
format 1

# Half the vertices its 6.8 m would give it: trunk and crown are simple, smooth forms. The trunk, the thinnest form in it, stays
# round at that density
Detail detail=0.5
    Union
        Material material=birch_bark
            Distort amount=0.006 frequency=4
                # Branches grow out of the trunk in small fillets; a larger blend would swell the slender trunk where they meet
                SmoothUnion smoothness=0.04
                    # The trunk in two lengths of the same radius where they meet, leaning towards +x and bending back a little
                    # higher up. A plain union: two round cones joined end to end already meet smoothly, where a smooth union
                    # would swell the joint
                    Union
                        # The lower length tapers from a wider base flaring into the ground in a low skirt, all cut flat at
                        # the ground: the rounded end of the cone below it made the slender trunk read as a bone
                        Intersection
                            SmoothUnion smoothness=0.15
                                ArbitraryRoundCone a=(0, 0, 0) b=(0.32, 2.6, 0.04) radiusA=0.16 radiusB=0.1
                                Ellipsoid radii=(0.26, 0.14, 0.26)
                            # The ground: only what is above it. A box rather than a plane, so the trunk counts towards the
                            # model's bounds
                            Translate translation=(0, 1.5, 0)
                                Box size=(1, 1.5, 1)
                        ArbitraryRoundCone a=(0.32, 2.6, 0.04) b=(0.5, 5.6, 0.1) radiusA=0.1 radiusB=0.05
                    # Two short branches, reaching up into the crown and ending inside it
                    ArbitraryRoundCone a=(0.37, 3.3, 0.06) b=(-0.05, 4.2, 0.2) radiusA=0.06 radiusB=0.04
                    ArbitraryRoundCone a=(0.4, 3.6, 0.07) b=(0.85, 4.3, -0.15) radiusA=0.06 radiusB=0.04

        # The crown, high on the trunk and following its lean, so a long stretch of white trunk shows beneath it
        Translate translation=(0.48, 5.0, 0.08)
            Rotate rotation=(0, 0, -0.06)
                Material material=birch_leaves
                    Part part=birch_crown
