# Rock 1: a big, mossy boulder about 1.9 m across and 1.3 m tall, a rounded, slightly tilted lump with broad soft facets and a
# flat underside, its top and the upper sides of its facets wrapped in a thick, cushiony cap of moss that ends in an uneven edge
# halfway down. The moss is the stone itself, grown a little and cut to the top, so the two always fit.
format 1

# The stone, used twice: as the rock, and grown a little for the moss over its top
stone =
    # Large lumps first, then a finer roughness over them, both shallow next to the rock's size
    Distort amount=0.015 frequency=6
        Distort amount=0.06 frequency=1.6
            # Soft facets cut into an oversized lump
            SmoothIntersection smoothness=0.1
                Translate translation=(0, 0.45, 0)
                    Rotate rotation=(0.08, -0.5, 0.1)
                        Ellipsoid radii=(1.05, 0.9, 0.85)
                # The underside, flat on the ground
                Plane normal=(0, -1, 0) height=0
                # A broad top facet tilted towards the back left, and four around the sides
                Plane normal=(-0.2, 0.95, -0.24) height=-1.2
                Plane normal=(0.9, 0.25, 0.35) height=-0.82
                Plane normal=(-0.85, 0.3, 0.42) height=-0.78
                Plane normal=(0.25, 0.2, -0.95) height=-0.66
                Plane normal=(-0.3, 0.15, 0.94) height=-0.7

Union
    Material material=rock_stone
        $stone
    # The moss: the stone grown by two centimetres, kept only above a wavy line halfway up, so it caps the top in a cushion
    Material material=rock_moss
        Intersection
            Round radius=0.02
                $stone
            Distort amount=0.12 frequency=2.4
                Plane normal=(0.1, -1, 0.15) height=0.7
