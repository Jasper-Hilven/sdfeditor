# Rock 2: a flat slab of slate about 1.9 m long, 1.4 m wide and 0.5 m thick, lying nearly flat with one end lifted a
# little, its top a broad, gently tilted table and its sides broken into a few soft, stepped facets. Low enough to step onto.
format 1
collider convex

Material material=rock_slate
    # A shallow lumpiness and a finer roughness, kept small so the top stays a table
    Distort amount=0.008 frequency=7
        Distort amount=0.025 frequency=2
            SmoothIntersection smoothness=0.05
                # The slab: a wide, flat, rounded box, lifted a little at its +x end
                Translate translation=(0, 0.16, 0)
                    Rotate rotation=(0.03, 0.35, 0.06)
                        RoundBox size=(0.88, 0.26, 0.62) roundness=0.1
                # The underside, flat on the ground
                Plane normal=(0, -1, 0) height=0
                # The top, a broad, gently tilted table
                Plane normal=(0.06, 1, 0.03) height=-0.36
                # A few broken facets around the edges
                Plane normal=(0.7, 0.45, 0.55) height=-0.82
                Plane normal=(-0.75, 0.4, -0.5) height=-0.8
                Plane normal=(-0.5, 0.5, 0.7) height=-0.68
                Plane normal=(0.45, 0.35, -0.82) height=-0.62
