# crowd-mushroom-blue-fan (ticket 33.2): one of Prime's fans for the east stand, cream-capped with a blue scarf band: 1.3 m high with a cap 0.8 m across, a plain stem and two coarse floating eyes (the
# part eye_machine at 0.6 times) at its front. Stands in the arena's crowd, drawn instanced and swaying in the stands' wind; no
# collider. The origin is the stem's foot, front along +z.
format 1

Detail detail=0.18
    Union
        Material material=crowd_flesh
            ArbitraryRoundCone a=(0, 0.16, 0) b=(0, 1.06, 0) radiusA=0.16 radiusB=0.13
        # The blue scarf band round the stem, a fan's
        Material material=crowd_scarf_blue
            Translate translation=(0.000, 0.47, 0)
                Torus innerRadius=0.05 outerRadius=0.19
        Material material=crowd_cap_cream
            Translate translation=(0, 1.00, 0)
                Intersection
                    Ellipsoid radii=(0.4, 0.3, 0.4)
                    Translate translation=(0, 0.3, 0)
                        Box size=(0.5, 0.3, 0.5)
        SymmetryX
            Translate translation=(0.1, 0.72, 0.2)
                Scale scale=(0.6, 0.6, 0.6)
                    Part part=eye_machine
