# SMD resistor 0: an 0805 chip resistor, 0.5 m long, 0.31 m wide and 0.13 m tall (250 times life size), lying on the board along x: a black epoxy body
# (pc_epoxy_black) between two tin end caps (pc_tin). Ground clutter: no collider.
format 1

# Big simple forms: a block and two caps
Detail detail=0.1
    Translate translation=(0, 0.065, 0)
        Union
            Material material=pc_epoxy_black
                RoundBox size=(0.17, 0.06, 0.145) roundness=0.012
            Material material=pc_tin
                SymmetryX
                    Translate translation=(0.2, 0, 0)
                        RoundBox size=(0.05, 0.065, 0.155) roundness=0.012
