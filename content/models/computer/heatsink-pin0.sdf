# Pin heatsink 0: a pin-fin heatsink on a chip, 3.5 m long, 3.5 m wide and 2.5 m tall (250 times life size): a black chip slab (pc_epoxy_black) under an aluminium base
# plate carrying a 5 x 5 grid of tapered pins (pc_aluminium). Tall blocker: convex collider.
format 1

# The chip, the base plate and a grid of tapered pins
Detail detail=0.17
    Union
        Material material=pc_epoxy_black
            Translate translation=(0, 0.15, 0)
                RoundBox size=(1.75, 0.15, 1.75) roundness=0.05
        Material material=pc_aluminium
            Union
                Translate translation=(0, 0.45, 0)
                    RoundBox size=(1.65, 0.15, 1.65) roundness=0.05
                Translate translation=(0, 1.55, 0)
                    LimitedRepetition spacing=0.62 limits=(2, 0, 2)
                        CappedCone height=0.95 bottomRadius=0.19 topRadius=0.12
