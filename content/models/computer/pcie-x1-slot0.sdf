# PCIe x1 slot 0: a PCIe x1 slot, 6.25 m long, 1.9 m wide and 2.75 m tall (250 times life size) along x: a black body (pc_epoxy_black) with a long socket groove
# in the top holding two gold contact strips (pc_gold). Tall blocker: convex collider.
format 1

# A rounded body with the socket cut into the top, the contact strips on the groove's floor
Detail detail=0.6
    Union
        Material material=pc_epoxy_black
            Subtraction
                Translate translation=(0, 1.375, 0)
                    RoundBox size=(3.125, 1.375, 0.95) roundness=0.15
                Translate translation=(0, 2.75, 0.1)
                    Box size=(2.85, 1.25, 0.32)
        Material material=pc_gold
            Union
                Translate translation=(0, 1.52, 0)
                    Box size=(2.75, 0.03, 0.06)
                Translate translation=(0, 1.52, 0.2)
                    Box size=(2.75, 0.03, 0.06)
