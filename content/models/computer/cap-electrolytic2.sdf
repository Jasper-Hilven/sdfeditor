# Electrolytic capacitor 2: a 10 x 20 mm electrolytic capacitor, 2.5 m across and 5 m tall (250 times life size), standing on the board:
# a black sleeve with two gold bands (pc_cap_black, pc_gold), an aluminium top with the vent cross as a shallow groove (pc_aluminium). Tall blocker: convex collider.
format 1
collider convex

# A sleeve with its bands and foot, an aluminium top with the vent cross cut into it
Detail detail=0.27
    Union
        Material material=pc_cap_black
            Translate translation=(0, 2.470, 0)
                Round radius=0.12
                    CappedCylinder radius=1.110 height=2.350
        Material material=pc_gold
            Union
                Translate translation=(0, 3.700, 0)
                    Subtraction
                        CappedCylinder radius=1.250 height=0.250
                        CappedCylinder radius=1.050 height=0.350
                Translate translation=(0, 3.000, 0)
                    Subtraction
                        CappedCylinder radius=1.250 height=0.080
                        CappedCylinder radius=1.050 height=0.180
        Material material=pc_aluminium
            Subtraction
                Translate translation=(0, 4.940, 0)
                    CappedCylinder radius=1.050 height=0.06
                Union
                    Translate translation=(0, 5.000, 0)
                        Box size=(0.900, 0.06, 0.17)
                    Translate translation=(0, 5.000, 0)
                        Box size=(0.17, 0.06, 0.900)
