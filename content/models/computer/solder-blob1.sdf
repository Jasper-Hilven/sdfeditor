# Solder blob 1: a small lopsided dome of silver solder (pc_solder), 0.3 m across and 0.12 m tall (250 times life size), a second smaller bump on its side
# (an old joint). Ground clutter: no collider.
format 1

# A dome with a bump
Detail detail=0.14
    Material material=pc_solder
        Intersection
            SmoothUnion smoothness=0.05
                Translate translation=(-0.03, 0.03, 0)
                    Ellipsoid radii=(0.12, 0.09, 0.14)
                Translate translation=(0.09, 0.02, 0.04)
                    Ellipsoid radii=(0.07, 0.07, 0.07)
            Translate translation=(0, 0.2, 0)
                Box size=(0.5, 0.2, 0.5)
