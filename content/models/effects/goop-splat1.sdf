# Goop splat: a blob of the blob gun's goo flattened where it landed, a starburst of a puddle about 36 cm across with fingers of goo
# running out from a thick middle, its base on the ground at y = 0. The effect lays it on the ground or on whatever was hit, along
# the surface, and lets it shrink away.
format 1

Detail detail=0.6
    Material material=blob_goo
        Distort amount=0.004 frequency=8
            Intersection
                # Only what is above the ground, so the puddle sits flat on it
                Plane normal=(0, -1, 0) height=0
                SmoothUnion smoothness=0.018
                    Ellipsoid radii=(0.07, 0.035, 0.07)
                    Capsule a=(0, 0, 0) b=(0.16, 0, 0.03) radius=0.02
                    Capsule a=(0, 0, 0) b=(-0.05, 0, 0.15) radius=0.022
                    Capsule a=(0, 0, 0) b=(-0.15, 0, -0.04) radius=0.018
                    Capsule a=(0, 0, 0) b=(0.04, 0, -0.16) radius=0.021
                    Capsule a=(0, 0, 0) b=(0.11, 0, -0.1) radius=0.016
