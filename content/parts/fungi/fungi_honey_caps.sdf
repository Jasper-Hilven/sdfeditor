# Honey caps: the eight caps of a honey fungus clump, honey-amber domes 1.8 to 3 m across with a pale gill disc under each, each at the
# top of a stem of the `honey-cluster0` model (the stems end at the cap's underside, at the origin of this part = the clump's base).
# The caps stand at the heights of the stems: this part and the model's stems are one drawing, split in two so the caps can sway apart.
format 1

Union
    # The tall one in the middle
    Translate translation=(0.2, 6.1, 0.1)
        Union
            Material material=ftree_honey_cap
                Intersection
                    Ellipsoid radii=(1.5, 1.0, 1.5)
                    Translate translation=(0, 1, 0)
                        Box size=(4, 1, 4)
            Material material=ftree_gills
                CappedCylinder radius=1.35 height=0.2
    Translate translation=(1.8, 4.9, 0.6)
        Rotate rotation=(0, 0, -0.25)
            Union
                Material material=ftree_honey_cap
                    Intersection
                        Ellipsoid radii=(1.25, 0.85, 1.25)
                        Translate translation=(0, 1, 0)
                            Box size=(4, 1, 4)
                Material material=ftree_gills
                    CappedCylinder radius=1.1 height=0.2
    Translate translation=(-1.7, 5.1, 0.8)
        Rotate rotation=(0, 0, 0.25)
            Union
                Material material=ftree_honey_cap
                    Intersection
                        Ellipsoid radii=(1.3, 0.9, 1.3)
                        Translate translation=(0, 1, 0)
                            Box size=(4, 1, 4)
                Material material=ftree_gills
                    CappedCylinder radius=1.15 height=0.2
    Translate translation=(0.7, 4.3, -1.9)
        Rotate rotation=(-0.25, 0, 0)
            Union
                Material material=ftree_honey_cap
                    Intersection
                        Ellipsoid radii=(1.15, 0.8, 1.15)
                        Translate translation=(0, 1, 0)
                            Box size=(4, 1, 4)
                Material material=ftree_gills
                    CappedCylinder radius=1.0 height=0.2
    Translate translation=(-1.1, 3.9, -1.7)
        Rotate rotation=(-0.2, 0, 0.15)
            Union
                Material material=ftree_honey_cap
                    Intersection
                        Ellipsoid radii=(1.0, 0.7, 1.0)
                        Translate translation=(0, 1, 0)
                            Box size=(4, 1, 4)
                Material material=ftree_gills
                    CappedCylinder radius=0.9 height=0.2
    Translate translation=(2.8, 3.3, -0.4)
        Rotate rotation=(0, 0, -0.4)
            Union
                Material material=ftree_honey_cap
                    Intersection
                        Ellipsoid radii=(1.0, 0.7, 1.0)
                        Translate translation=(0, 1, 0)
                            Box size=(4, 1, 4)
                Material material=ftree_gills
                    CappedCylinder radius=0.9 height=0.2
    Translate translation=(-2.7, 3.4, -0.6)
        Rotate rotation=(0, 0, 0.4)
            Union
                Material material=ftree_honey_cap
                    Intersection
                        Ellipsoid radii=(1.05, 0.7, 1.05)
                        Translate translation=(0, 1, 0)
                            Box size=(4, 1, 4)
                Material material=ftree_gills
                    CappedCylinder radius=0.95 height=0.2
    Translate translation=(0.9, 3.2, 2.4)
        Rotate rotation=(0.3, 0, 0)
            Union
                Material material=ftree_honey_cap
                    Intersection
                        Ellipsoid radii=(1.0, 0.7, 1.0)
                        Translate translation=(0, 1, 0)
                            Box size=(4, 1, 4)
                Material material=ftree_gills
                    CappedCylinder radius=0.9 height=0.2
