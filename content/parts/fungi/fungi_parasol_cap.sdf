# Parasol cap: the broad, flat cap of a parasol mushroom (Macrolepiota), 8 m across and 2.2 m tall with its central boss, its rim wavy
# and a little turned down, its underside at the origin. Cream gills fill the underside. The scales are the material's big flecks, not
# geometry. A part, so it is a mesh of its own that sways in the wind apart from the stem.
format 1

Union
    Material material=ftree_parasol_cap
        # A gentle, large-scale lumpiness, shallow next to the cap
        Distort amount=0.05 frequency=1.0
            SmoothUnion smoothness=0.5
                # The cap: the top half of a flat ellipsoid, its rim lobed
                RadialWave amount=0.12 count=9
                    Intersection
                        Translate translation=(0, 0.15, 0)
                            Ellipsoid radii=(4.0, 1.25, 4.0)
                        Translate translation=(0, 1.2, 0)
                            Box size=(10, 1.2, 10)
                # The boss in the middle
                Translate translation=(0, 1.0, 0)
                    Ellipsoid radii=(1.3, 0.8, 1.3)
    # Gills: a pale disc filling the underside
    Material material=ftree_gills
        Translate translation=(0, 0, 0)
            CappedCylinder radius=3.7 height=0.3
