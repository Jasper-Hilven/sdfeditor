# Card, king of mushrooms: a giant playing card 3 m wide, 4.2 m tall and 13 cm thick, centred on the origin and standing in the xy
# plane with its face to +z, its back the fly agaric's red with white warts. The suit is mushrooms: fly agarics, red with white
# spots on ivory stems, outlined in dark ink. Every mark is painted flush on the white blank: the blank cut to the front (or back)
# half of the space and to the 2D shapes of the mark, so the card stays one smooth slab and one mesh; where marks overlap, the
# later one in the union shows. The blank is written out in each mark rather than used as a part, which would make it a mesh of
# its own under the marks. The king is a double-headed portrait, as on a real face card: in each half a fly agaric king, his crown
# of chanterelle gold on his red cap, his ivory stem his face with two dark eyes and a smile, a golden collar at his foot, the
# halves parted by a thin line. A K with a small mushroom in two opposite corners.
format 1

Union
    # The blank, 3 m wide, 4.2 m tall and 13 cm thick, with rounded corners and edges
    Material material=game_wart_white
        Round radius=0.03
            Extrusion height=0.035
                RoundedBox2D size=(1.47, 2.07) radiusTopRight=0.22 radiusBottomRight=0.22 radiusTopLeft=0.22 radiusBottomLeft=0.22
    # The back: a red panel inside a white border
    Material material=game_cap_red
        Intersection
            Round radius=0.03
                Extrusion height=0.035
                    RoundedBox2D size=(1.47, 2.07) radiusTopRight=0.22 radiusBottomRight=0.22 radiusTopLeft=0.22 radiusBottomLeft=0.22
            Translate translation=(0, 0, -0.5)
                Extrusion height=0.5
                    RoundedBox2D size=(1.3, 1.9) radiusTopRight=0.14 radiusBottomRight=0.14 radiusTopLeft=0.14 radiusBottomLeft=0.14
    # flecked with rows of white warts, every other row smaller and shifted half a step
