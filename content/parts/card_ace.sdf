                                OrientedBox2D a=(0.13, -0.17) b=(0, 0.17) thickness=0.06
                                OrientedBox2D a=(-0.075, -0.04) b=(0.075, -0.04) thickness=0.05
                        Translate2D offset=(1.18, -1.7)
                            Rotate2D angle=3.1416
                                Union2D
                                    OrientedBox2D a=(-0.13, -0.17) b=(0, 0.17) thickness=0.06
                                    OrientedBox2D a=(0.13, -0.17) b=(0, 0.17) thickness=0.06
                                    OrientedBox2D a=(-0.075, -0.04) b=(0.075, -0.04) thickness=0.05
    # Their ivory stems
    Material material=game_porcini_flesh
        Intersection
            Round radius=0.03
                Extrusion height=0.035
                    RoundedBox2D size=(1.47, 2.07) radiusTopRight=0.22 radiusBottomRight=0.22 radiusTopLeft=0.22 radiusBottomLeft=0.22
            Translate translation=(0, 0, 0.5)
                Extrusion height=0.5
                    Union2D
                        Translate2D offset=(0, 0.15)
                            Translate2D offset=(0, -0.462)
                                RoundedBox2D size=(0.336, 0.504) radiusTopRight=0.063 radiusBottomRight=0.21 radiusTopLeft=0.063 radiusBottomLeft=0.21
                        Translate2D offset=(-1.18, 1.3)
                            Translate2D offset=(0, -0.0924)
                                RoundedBox2D size=(0.0672, 0.1008) radiusTopRight=0.0126 radiusBottomRight=0.042 radiusTopLeft=0.0126 radiusBottomLeft=0.042
                        Translate2D offset=(1.18, -1.3)
                            Rotate2D angle=3.1416
                                Translate2D offset=(0, -0.0924)
                                    RoundedBox2D size=(0.0672, 0.1008) radiusTopRight=0.0126 radiusBottomRight=0.042 radiusTopLeft=0.0126 radiusBottomLeft=0.042
