# Castle veil: a small banner of the partial veil of a young mushroom, hung from a ring collar at the top. The skirt is 1.2 m long and
# 0.6 m wide at the top, tapering a little to a scalloped lower edge, with two soft folds down its face. Modelled at its own origin, the
# top middle, hanging down -y, the back flat at z = 0 against the wall.
format 1
collider none
shadows off
cull 35
outline off
Detail detail=0.4
    Union
        # The ring collar the veil hangs from, lying in the wall's plane
        Material material=amanita_stem
            Translate translation=(0, 0.04, 0.03)
                Rotate rotation=(1.5707964, 0, 0)
                    Torus innerRadius=0.04 outerRadius=0.07
        Material material=amanita_gills
            Union
                # The skirt: a tapering cloth, its back flat on the wall, with a scalloped lower edge cut in
                Subtraction
                    # The cloth, 4 cm thick, its back on z = 0
                    Translate translation=(0, -0.6, 0.02)
                        Extrusion height=0.02
                            Trapezoid2D bottomRadius=0.22 topRadius=0.3 height=0.6
                    Union
                        Translate translation=(-0.2, -1.2, 0.02)
                            Ellipsoid radii=(0.1, 0.1, 0.1)
                        Translate translation=(0, -1.2, 0.02)
                            Ellipsoid radii=(0.1, 0.1, 0.1)
                        Translate translation=(0.2, -1.2, 0.02)
                            Ellipsoid radii=(0.1, 0.1, 0.1)
                # Two soft folds, low rounded ribs running down the face of the cloth
                ArbitraryRoundCone a=(-0.1, -0.08, 0.03) b=(-0.13, -1.0, 0.03) radiusA=0.022 radiusB=0.016
                ArbitraryRoundCone a=(0.12, -0.08, 0.03) b=(0.1, -0.95, 0.03) radiusA=0.022 radiusB=0.016
