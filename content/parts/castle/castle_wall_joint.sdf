# Castle wall joint: where two wall bays meet, a stem stands out of the wall's outer face (+z) with a small red cap, and a round pad
# at the walk's height fills the angle between the bays' walks. The stem hides the seam on the outside; it leaves 1.3 m of walk.
format 1
collider mesh
Detail detail=0.3
    # Cut off 30 cm below the ground
    Intersection
        Translate translation=(0, 11.7, 0)
            Box size=(12, 12, 12)
        Union
            Material material=amanita_stem
                Union
                    SmoothUnion smoothness=0.4
                        ArbitraryRoundCone a=(0, 0, 0.75) b=(0, 5.5, 0.85) radiusA=1.05 radiusB=0.62
                        Translate translation=(0, 0.15, 0.6)
                            Ellipsoid radii=(1.6, 0.9, 1.5)
                    Translate translation=(0, 4.85, -0.05)
                        CappedCylinder radius=1.15 height=0.15
            # The cap at mushroom scale, scaled up so its flecks are a hand wide
            Translate translation=(0, 5.4, 0.85)
                Scale scale=(2.4, 2.4, 2.4)
                    Material material=amanita_cap
                        Intersection
                            Translate translation=(0, 0.04, 0)
                                Ellipsoid radii=(0.42, 0.28, 0.42)
                            Translate translation=(0, 0.33, 0)
                                Box size=(0.45, 0.29, 0.45)
