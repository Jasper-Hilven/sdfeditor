# Castle wall bay: one bay of the fly agaric castle's curtain wall, 3.8 m long (x), its outer face towards +z, standing on y = 0.
# A core 1.2 m thick of pale stem flesh, swelling at the foot like a stem's bulb, with three stems packed along the outer face;
# on top a 2.1 m wall-walk at 5 m (the lowest of the castle's floor heights, see castle0.sdf) and a parapet on its outer edge.
# The castle's layout turns one bay per chord of its oval wall; neighbouring bays overlap under a castle_wall_joint, whose pad
# above the walk covers the overlap and the seam. Merlons are placed by the layout.
format 1
collider mesh
Detail detail=0.3
    # Cut off 30 cm below the ground
    Intersection
        Translate translation=(0, 11.7, 0)
            Box size=(12, 12, 12)
        Material material=castle_wall
            Union
                # The core, the walk on top of it and the parapet on its outer edge
                Translate translation=(0, 2.4, 0)
                    Box size=(1.9, 2.4, 0.6)
                Translate translation=(0, 4.85, -0.05)
                    Box size=(1.9, 0.15, 1.05)
                Translate translation=(0, 5.25, 0.85)
                    Box size=(1.9, 0.25, 0.15)
                # The foot swells out like a stem's bulb on both sides
                Translate translation=(0, 0.2, 0)
                    Ellipsoid radii=(2.1, 1.5, 1.3)
                # Stems packed along the outer face, thick at the foot and tapering up
                ArbitraryRoundCone a=(-1.25, 0, 0.6) b=(-1.25, 4.3, 0.5) radiusA=0.72 radiusB=0.42
                ArbitraryRoundCone a=(0, 0, 0.6) b=(0, 4.3, 0.5) radiusA=0.72 radiusB=0.42
                ArbitraryRoundCone a=(1.25, 0, 0.6) b=(1.25, 4.3, 0.5) radiusA=0.72 radiusB=0.42
