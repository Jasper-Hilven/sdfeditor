# Castle tower, large: a fly agaric 12.5 m tall with a 4.4 m cap, for the ends of the castle's oval.
# Modelled at an eighth of its size and scaled up, so the cap's white flecks and the stem's fibres come out at the size they have on
# the fly agaric scout. Base at y = 0, the side with the windows towards +z (out of the castle). The ring's flat top is at
# 5.3 m, 30 cm above the wall-walk (the floor heights are in castle0.sdf), a balcony round the stem that the walk runs onto; the
# layout may scale a tower up only if it sinks it by as much as the ring rose.
format 1
collider mesh
Detail detail=0.4
    # Cut off 30 cm below the ground
    Intersection
        Translate translation=(0, 11.7, 0)
            Box size=(12, 12, 12)
        Scale scale=(8, 8, 8)
            Union
                Material material=castle_stem
                    SmoothUnion smoothness=0.06
                        ArbitraryRoundCone a=(0, 0.1, 0) b=(0, 1.542, 0) radiusA=0.29 radiusB=0.24
                        Translate translation=(0, 0.05, 0)
                            Ellipsoid radii=(0.4, 0.12, 0.4)
                # The ring (annulus): a flat balcony with the skirt of the ring hanging under its edge
                Material material=castle_stem
                    Union
                        Translate translation=(0, 0.6545, 0)
                            CappedCylinder radius=0.44 height=0.008
                        Translate translation=(0, 0.6325, 0)
                            Round radius=0.004
                                CappedCone height=0.016 bottomRadius=0.43 topRadius=0.44
                # Glowing round windows on the side facing out
                Material material=flower_center
                    Union
                        Translate translation=(0, 0.3, 0.271)
                            Ellipsoid radii=(0.045, 0.06, 0.03)
                        Translate translation=(0, 1.141, 0.242)
                            Ellipsoid radii=(0.04, 0.055, 0.03)
                Material material=amanita_gills
                    Translate translation=(0, 1.575, 0)
                        CappedCylinder radius=0.512 height=0.012
                Material material=amanita_cap
                    Round radius=0.02
                        Intersection
                            Translate translation=(0, 1.542, 0)
                                Ellipsoid radii=(0.55, 0.407, 0.55)
                            Translate translation=(0, 2.112, 0)
                                Box size=(0.605, 0.539, 0.605)
