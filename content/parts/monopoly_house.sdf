# Monopoly house: the board game's little house, standing on the origin with its front to +z, blown up to 3.4 m tall. A
# squat green block 2.5 m wide and 2.1 m deep with soft corners under a darker green gabled roof, its ridge along x and its
# eaves overhanging the walls. A wooden arched door in front (+z) between two painted windows, one more on each side, and a
# plain chimney on the roof.
format 1

Union
    # The walls, with the door and window recesses cut in
    Material material=monopoly_green
        Subtraction
            Translate translation=(0, 1, 0)
                RoundBox size=(1.25, 1, 1.05) roundness=0.1
            Union
                # The doorway: a round-headed arch
                Translate translation=(0, 0.55, 1.05)
                    Box size=(0.36, 0.55, 0.15)
                ArbitraryCappedCylinder a=(0, 1.1, 0.9) b=(0, 1.1, 1.2) radius=0.36
                # The window recesses, either side of the door and one in each side wall
                SymmetryX
                    Union
                        Translate translation=(0.8, 1.25, 1.05)
                            Box size=(0.25, 0.3, 0.15)
                        Translate translation=(1.25, 1.25, 0)
                            Box size=(0.15, 0.3, 0.25)

    # The roof: a gabled prism, ridge along x, 1.4 m high, overhanging the walls front and back and at the gables
    Material material=monopoly_green_roof
        Translate translation=(0, 1.98, 0)
            Rotate rotation=(0, 1.5707964, 0)
                Extrusion height=1.55
                    Triangle2D a=(-1.45, 0) b=(1.45, 0) c=(0, 1.42)

    # The door, set 10 cm into the arch
    Material material=game_wood_door
        Union
            Translate translation=(0, 0.55, 0.94)
                Box size=(0.36, 0.55, 0.04)
            ArbitraryCappedCylinder a=(0, 1.1, 0.9) b=(0, 1.1, 0.98) radius=0.36
            Translate translation=(0.22, 0.62, 1)
                Sphere radius=0.055

    # The windows: painted panes flush in the recesses, crossed by thin bars
    Material material=monopoly_window
        SymmetryX
            Union
                Translate translation=(0.8, 1.25, 0.99)
                    Box size=(0.25, 0.3, 0.04)
                Translate translation=(1.2, 1.25, 0)
                    Box size=(0.04, 0.3, 0.25)
    Material material=monopoly_green
        SymmetryX
            Union
                Translate translation=(0.8, 1.25, 1.03)
                    Union
                        Box size=(0.27, 0.02, 0.02)
                        Box size=(0.02, 0.32, 0.02)
                Translate translation=(1.24, 1.25, 0)
                    Union
                        Box size=(0.02, 0.02, 0.27)
                        Box size=(0.02, 0.32, 0.02)

    # The chimney: a plain block through the roof
    Material material=monopoly_green_roof
        Translate translation=(0.8, 3.05, -0.2)
            RoundBox size=(0.18, 0.36, 0.18) roundness=0.02
