# Domino 6-3: a giant domino 2 m wide, 4 m tall and 0.64 m thick, centred on the origin and standing in the xy plane with its face
# to +z: a plain ivory tile with soft rounded edges, a plain divider groove across its middle, and its pips sunk into the face as
# round dimples painted black: six in the top half and three in the bottom one. The back is plain.
format 1

Union
    # The tile, the divider groove and the pips cut into its face
    Material material=game_ivory
        Subtraction
            RoundBox size=(1, 2, 0.32) roundness=0.14
            Union
                Translate translation=(0, 0, 0.32)
                    Box size=(0.82, 0.04, 0.06)
                Union
                    Translate translation=(0.5, 1.5, 0.32)
                        Ellipsoid radii=(0.16, 0.16, 0.07)
                    Translate translation=(-0.5, 1.5, 0.32)
                        Ellipsoid radii=(0.16, 0.16, 0.07)
                    Translate translation=(0.5, 1, 0.32)
                        Ellipsoid radii=(0.16, 0.16, 0.07)
                    Translate translation=(-0.5, 1, 0.32)
                        Ellipsoid radii=(0.16, 0.16, 0.07)
                    Translate translation=(0.5, 0.5, 0.32)
                        Ellipsoid radii=(0.16, 0.16, 0.07)
                    Translate translation=(-0.5, 0.5, 0.32)
                        Ellipsoid radii=(0.16, 0.16, 0.07)
                    Translate translation=(0.5, -0.5, 0.32)
                        Ellipsoid radii=(0.16, 0.16, 0.07)
                    Translate translation=(0, -1, 0.32)
                        Ellipsoid radii=(0.16, 0.16, 0.07)
                    Translate translation=(-0.5, -1.5, 0.32)
                        Ellipsoid radii=(0.16, 0.16, 0.07)
    # The divider's floor and the pips' floors in ink, a few centimetres below the face
    Material material=game_pip_black
        Intersection
            RoundBox size=(1, 2, 0.29) roundness=0.14
            Union
                Translate translation=(0, 0, 0.27)
                    Box size=(0.82, 0.04, 0.02)
                Union
                    Translate translation=(0.5, 1.5, 0.32)
                        Ellipsoid radii=(0.16, 0.16, 0.07)
                    Translate translation=(-0.5, 1.5, 0.32)
                        Ellipsoid radii=(0.16, 0.16, 0.07)
                    Translate translation=(0.5, 1, 0.32)
                        Ellipsoid radii=(0.16, 0.16, 0.07)
                    Translate translation=(-0.5, 1, 0.32)
                        Ellipsoid radii=(0.16, 0.16, 0.07)
                    Translate translation=(0.5, 0.5, 0.32)
                        Ellipsoid radii=(0.16, 0.16, 0.07)
                    Translate translation=(-0.5, 0.5, 0.32)
                        Ellipsoid radii=(0.16, 0.16, 0.07)
                    Translate translation=(0.5, -0.5, 0.32)
                        Ellipsoid radii=(0.16, 0.16, 0.07)
                    Translate translation=(0, -1, 0.32)
                        Ellipsoid radii=(0.16, 0.16, 0.07)
                    Translate translation=(-0.5, -1.5, 0.32)
                        Ellipsoid radii=(0.16, 0.16, 0.07)
