# Poker chip, blue: a giant clay poker chip 2.4 m across and 0.32 m thick, centred on the origin and lying flat, in glossy blue, its
# edge rounded. Painted flush on it in white, as the colours of a real chip are inlaid rather than raised: eight blocks round the
# edge that wrap over the rim onto both faces, a thin ring inside them, and a round disc with a ring round it in the middle of each face. Each painted
# piece is the chip itself cut to the space of its pattern, so the surface stays one smooth disc; where two pieces of a union lie
# on the same surface, the later one shows.
format 1

Union
    # The chip
    Material material=game_chip_blue
        RoundedCylinder radius=1.2 roundness=0.06 height=0.16
    Material material=game_pip_white
        Intersection
            RoundedCylinder radius=1.2 roundness=0.06 height=0.16
            Union
                # The edge blocks: two radial bars in the +x +z quarter (a turn about y by a negative angle takes +x towards +z),
                # mirrored into the others
                SymmetryXZ
                    Union
                        Rotate rotation=(0, -0.3926991, 0)
                            Translate translation=(1.2, 0, 0)
                                Box size=(0.24, 1, 0.17)
                        Rotate rotation=(0, -1.1780972, 0)
                            Translate translation=(1.2, 0, 0)
                                Box size=(0.24, 1, 0.17)
                # The ring
                Subtraction
                    CappedCylinder radius=0.86 height=1
                    CappedCylinder radius=0.81 height=1
                # The inlay, through the chip so it shows on both faces: a round disc with a ring round it
                Rotate rotation=(-1.5707964, 0, 0)
                    Extrusion height=1
                        Union2D
                            Circle radius=0.3
                            Subtraction2D
                                Circle radius=0.5
                                Circle radius=0.43
