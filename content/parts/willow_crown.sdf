# Willow crown: the leaves of a stylized weeping willow, a rounded dome about 3.4 m across, the dome's centre at the origin, from
# which two rings of thick, tapering curtains of leaves hang: an inner ring of long ones, their tips 1.6 to 2.8 m below the
# centre, nearly to the ground, and an outer ring of shorter ones between and over them, so the curtains fall in layers. The
# curtains run into the dome and into each other at the top, so the crown is one surface, and part lower down, so the trunk shows
# between them. Each tip is a round blob rather than a point: no thin strands to mesh. Form only: the model wraps it in its
# material.
format 1

# A gentle, large-scale lumpiness, shallow next to the curtains
Distort amount=0.03 frequency=1.5
    # Soft creases where the curtains leave the dome, but not so soft that they melt into one skirt
    SmoothUnion smoothness=0.16
        # The dome, with a smaller clump on top so the outline is not a perfect lid
        Ellipsoid radii=(1.45, 0.9, 1.45)
        Translate translation=(0.2, 0.6, -0.15)
            Ellipsoid radii=(0.9, 0.55, 0.85)
        # The curtains, turned so the front (+z) falls between two long ones and shows the trunk
        Rotate rotation=(0, 0.35, 0)
            Union
                # The long inner ring, from under the dome's rim down nearly to the ground, of uneven lengths so the hem is
                # ragged
                ArbitraryRoundCone a=(1.20, -0.25, -0.05) b=(1.74, -2.75, -0.07) radiusA=0.47 radiusB=0.21
                ArbitraryRoundCone a=(0.91, -0.25, 0.78) b=(1.36, -2.65, 1.16) radiusA=0.46 radiusB=0.21
                ArbitraryRoundCone a=(0.23, -0.25, 1.18) b=(0.33, -2.62, 1.69) radiusA=0.45 radiusB=0.26
                ArbitraryRoundCone a=(-0.50, -0.25, 1.09) b=(-0.74, -2.75, 1.59) radiusA=0.47 radiusB=0.27
                ArbitraryRoundCone a=(-1.14, -0.25, 0.39) b=(-1.70, -1.82, 0.58) radiusA=0.42 radiusB=0.26
                ArbitraryRoundCone a=(-1.15, -0.25, -0.35) b=(-1.66, -2.59, -0.51) radiusA=0.44 radiusB=0.26
                ArbitraryRoundCone a=(-0.68, -0.25, -0.99) b=(-1.04, -2.75, -1.52) radiusA=0.47 radiusB=0.23
                ArbitraryRoundCone a=(0.22, -0.25, -1.18) b=(0.32, -2.65, -1.69) radiusA=0.44 radiusB=0.25
                ArbitraryRoundCone a=(0.91, -0.25, -0.79) b=(1.34, -2.17, -1.17) radiusA=0.46 radiusB=0.23
                # The shorter outer ring, from higher on the dome, falling over the gaps between the long ones
                ArbitraryRoundCone a=(0.87, 0.35, 0.38) b=(1.70, -1.35, 0.74) radiusA=0.42 radiusB=0.24
                ArbitraryRoundCone a=(0.46, 0.35, 0.83) b=(0.89, -1.73, 1.60) radiusA=0.42 radiusB=0.24
                ArbitraryRoundCone a=(-0.21, 0.35, 0.93) b=(-0.39, -1.79, 1.75) radiusA=0.42 radiusB=0.24
                ArbitraryRoundCone a=(-0.68, 0.35, 0.66) b=(-1.30, -1.65, 1.27) radiusA=0.42 radiusB=0.24
                ArbitraryRoundCone a=(-0.95, 0.35, 0.07) b=(-1.82, -1.22, 0.13) radiusA=0.42 radiusB=0.24
                ArbitraryRoundCone a=(-0.71, 0.35, -0.63) b=(-1.39, -1.54, -1.25) radiusA=0.42 radiusB=0.24
                ArbitraryRoundCone a=(-0.09, 0.35, -0.95) b=(-0.18, -1.62, -1.79) radiusA=0.42 radiusB=0.24
                ArbitraryRoundCone a=(0.49, 0.35, -0.81) b=(0.95, -1.47, -1.57) radiusA=0.42 radiusB=0.24
                ArbitraryRoundCone a=(0.91, 0.35, -0.26) b=(1.82, -1.48, -0.52) radiusA=0.42 radiusB=0.24
