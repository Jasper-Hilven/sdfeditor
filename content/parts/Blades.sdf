# Blades: the blades and hub of a 120 mm fan (250 times life size, 24.8 m across), in the fan's own space: the turning axis the z axis through the origin, the front towards +z.
# A script spins whatever is named Blades about this axis (Spinner). Used by case-fan0.
format 1

# A hub with eight tilted blades round it
Material material=pc_fan_white
    Union
        Translate translation=(0, 0, 0.3)
            Rotate rotation=(1.571, 0, 0)
                Round radius=0.12
                    CappedCylinder radius=3.28 height=2.08
        Translate translation=(0, 0, 0.3)
            Rotate rotation=(0, 0, 0.2)
                Translate translation=(7.6, 0, 0)
                    Rotate rotation=(0.5, 0, 0)
                        RoundBox size=(4.6, 1.9, 0.3) roundness=0.25
        Translate translation=(0, 0, 0.3)
            Rotate rotation=(0, 0, 0.985)
