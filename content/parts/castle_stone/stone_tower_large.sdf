# Stone tower, large: a round tower of dressed stone 12.3 m to the eaves with a conical tile roof 4.4 m high, for the ends of the castle's oval.
# Modelled at its real size. Base at y = 0, the side with the windows towards +z (out of the castle). The ring's flat top is at
# 5.3 m, 30 cm above the wall-walk (the floor heights are in castle1.sdf), a balcony round the tower that the walk runs onto; the
# layout may scale a tower up only if it sinks it by as much as the ring rose. Shaft radius matches castle_tower_large, so the window frames sit on it.
format 1
collider mesh
Detail detail=0.4
    # Cut off 30 cm below the ground
    Intersection
        Translate translation=(0, 11.7, 0)
            Box size=(12, 12, 12)
        Union
            Material material=castle_stone
                Union
                    # The shaft with a batter at its foot
                    Translate translation=(0, 6.170, 0)
                        CappedCone height=6.170 bottomRadius=2.35 topRadius=1.92
                    Translate translation=(0, 0.9, 0)
                        CappedCone height=0.9 bottomRadius=3.10 topRadius=2.30
                    # The ring: a flat stone balcony round the tower with a bevelled skirt under its edge
                    Translate translation=(0, 5.236, 0)
                        CappedCylinder radius=3.52 height=0.064
                    Translate translation=(0, 5.06, 0)
                        Round radius=0.03
                            CappedCone height=0.128 bottomRadius=3.4 topRadius=3.52
                    # The corbelled top: the shaft flares into the drum under the roof
                    Translate translation=(0, 11.74, 0)
                        CappedCone height=0.6 bottomRadius=1.92 topRadius=2.9
                    Translate translation=(0, 12.64, 0)
                        CappedCylinder radius=2.9 height=0.3
            # Glowing windows on the side facing out
            Material material=flower_center
                Union
                    Translate translation=(0, 2.4, 2.146)
                        Ellipsoid radii=(0.3, 0.5, 0.25)
                    Translate translation=(0, 9.13, 1.912)
                        Ellipsoid radii=(0.3, 0.5, 0.25)
            # The conical roof of tiles, with a little overhang
            Material material=castle_roof
                Translate translation=(0, 15.14, 0)
                    CappedCone height=2.2 bottomRadius=3.3 topRadius=0.06
