# Stone wall joint: where two wall bays meet, a round buttress pier stands out of the wall's outer face (+z) with a small conical tile
# cap, and a round pad 15 cm above the walk (at 5.15 m) fills the angle between the bays' walks and covers where they overlap. The
# pier hides the seam on the outside; it leaves 1.3 m of walk. The cap's flat underside sits 5 cm below the pier's top (5.5 m).
format 1
collider mesh
Detail detail=0.3
    # Cut off 30 cm below the ground
    Intersection
        Translate translation=(0, 11.7, 0)
            Box size=(12, 12, 12)
        Union
            Material material=castle_stone
                Union
                    # The pier, with a splayed plinth at its foot
                    Translate translation=(0, 2.75, 0.8)
                        CappedCone height=2.75 bottomRadius=1.1 topRadius=0.7
                    Translate translation=(0, 0.4, 0.7)
                        CappedCone height=0.4 bottomRadius=1.6 topRadius=1.1
                    # The pad over the seam of the walks
                    Translate translation=(0, 5, -0.05)
                        CappedCylinder radius=1.15 height=0.15
            # The cap, a cone of roof tiles
            Material material=castle_roof
                Translate translation=(0, 5.95, 0.85)
                    CappedCone height=0.5 bottomRadius=0.9 topRadius=0.04
