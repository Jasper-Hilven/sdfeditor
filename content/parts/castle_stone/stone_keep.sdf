# Stone keep: a drum of dressed stone 12 m high against the rear wall, with a square watch chamber on a slab above and a pyramid
# roof of tiles. Its flat ring at 5.3 m, 30 cm above the wall-walk, is a balcony 1.7 m wide that the rear walk steps up onto and the
# two stone_stairs climb to; a door and glowing windows on the courtyard side (+z). The drum has castle_keep's radius at every
# height, so the layout's window frames sit on it.
format 1
collider mesh
Detail detail=0.45
    # Cut off 30 cm below the ground
    Intersection
        Translate translation=(0, 11.7, 0)
            Box size=(12, 12, 12)
        Union
            Material material=castle_stone
                Union
                    # The drum with a plinth at its foot, kept inside the stairs' first steps so they stand clear of it
                    Translate translation=(0, 5.975, 0)
                        CappedCone height=5.975 bottomRadius=3.46 topRadius=2.72
                    Translate translation=(0, 0.8, 0)
                        CappedCone height=0.8 bottomRadius=3.7 topRadius=3.35
                    # A square slab on the drum carries the square watch chamber above, with a battlemented rim
                    Translate translation=(0, 12.2, 0)
                        Round radius=0.03
                            Box size=(3.1, 0.25, 3.1)
                    Translate translation=(0, 13.8, 0)
                        Box size=(2.85, 1.35, 2.85)
                    Subtraction
                        Translate translation=(0, 15.6, 0)
                            Box size=(3.1, 0.45, 3.1)
                        Translate translation=(0, 15.75, 0)
                            Box size=(2.7, 0.5, 2.7)
            # The ring, with an opening on either side where the stairs come up through it (from 0.98 to 1.98 radians round from the
            # front, the last ten steps), so they have headroom under it
            Material material=castle_stone
                Subtraction
                    Union
                        Translate translation=(0, 5.22, 0)
                            CappedCylinder radius=4.85 height=0.08
                        Translate translation=(0, 5.0, 0)
                            Round radius=0.04
                                CappedCone height=0.16 bottomRadius=4.75 topRadius=4.85
                    SymmetryX
                        Intersection
                            Plane normal=(-0.557, 0, 0.83) height=0
                            Plane normal=(-0.398, 0, -0.917) height=0
                            Translate translation=(0, 5.2, 0)
                                CappedCylinder radius=5.3 height=0.6
            # The door and the glowing windows on the courtyard side
            Material material=castle_wood
                Union
                    Translate translation=(0, 1.4, 3.35)
                        Box size=(0.55, 0.7, 0.2)
                    Translate translation=(0, 2.1, 3.35)
                        Rotate rotation=(1.5707964, 0, 0)
                            CappedCylinder radius=0.55 height=0.2
            Material material=flower_center
                Union
                    SymmetryX
                        Translate translation=(1.3, 7.5, 2.8)
                            Ellipsoid radii=(0.45, 0.65, 0.3)
                    Translate translation=(0, 13.6, 2.8)
                        Ellipsoid radii=(0.5, 0.7, 0.3)
            # The pyramid roof of tiles
            Material material=castle_roof
                Intersection
                    Plane normal=(0, -1, 0) height=16.05
                    Plane normal=(0.717, 0.697, 0) height=-13.6
                    Plane normal=(-0.717, 0.697, 0) height=-13.6
                    Plane normal=(0, 0.697, 0.717) height=-13.6
                    Plane normal=(0, 0.697, -0.717) height=-13.6
