# Toy castle keep (ticket 27.7): three stacked blocks and a cone roof, 12 m high. Origin on the middle of its foot at y = 0, the front (door, windows) towards +z; the
# layout stands it against the rear wall. A beech block 6.4 m square to 3 m, a cream block 6 m square to 5.3 m (its flat top is the keep's ring, a ledge 0.8 m wide
# round the top block, which the rear walk at 5 m steps up onto) and a peach block 4.4 m square to 9 m, then a lilac cone roof on a brim to 12 m.
format 1
collider mesh
Detail detail=0.25
    Union
        Material material=toy_beech
            Translate translation=(0, 1.5, 0)
                RoundBox size=(3.2, 1.5, 3.2) roundness=0.08
        Material material=toy_paint_cream
            Translate translation=(0, 4.15, 0)
                RoundBox size=(3, 1.15, 3) roundness=0.08
        Material material=toy_paint_peach
            Translate translation=(0, 7.15, 0)
                RoundBox size=(2.2, 1.85, 2.2) roundness=0.08
        # The door on the first block and two windows on the top one
        Material material=toy_paint_mint
            Union
                Translate translation=(0, 1.1, 3.22)
                    RoundBox size=(0.8, 1.1, 0.08) roundness=0.04
                Translate translation=(-1, 7.4, 2.22)
                    RoundBox size=(0.4, 0.55, 0.08) roundness=0.04
                Translate translation=(1, 7.4, 2.22)
                    RoundBox size=(0.4, 0.55, 0.08) roundness=0.04
        Material material=toy_paint_lilac
            Union
                Translate translation=(0, 9.1, 0)
                    Round radius=0.04
                        CappedCylinder radius=3.26 height=0.06
                Translate translation=(0, 10.5, 0)
                    CappedCone height=1.3 bottomRadius=3.0 topRadius=0.06
                Translate translation=(0, 11.9, 0)
                    Sphere radius=0.2
