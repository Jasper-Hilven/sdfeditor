                    RoundBox size=(1.2, 0.75, 0.3) roundness=0.04
                Translate translation=(0, 1.05, 3.9)
                    RoundBox size=(1.2, 1.05, 0.3) roundness=0.04
                Translate translation=(0, 1.35, 5.1)
                    RoundBox size=(1.2, 1.35, 0.3) roundness=0.04
                Translate translation=(0, 1.65, 6.3)
                    RoundBox size=(1.2, 1.65, 0.3) roundness=0.04
                Translate translation=(0, 1.95, 7.5)
                    RoundBox size=(1.2, 1.95, 0.3) roundness=0.04
                Translate translation=(0, 2.25, 8.7)
                    RoundBox size=(1.2, 2.25, 0.3) roundness=0.04
        Material material=toy_paint_cream
            Union
                Translate translation=(0, 0.3, 0.9)
