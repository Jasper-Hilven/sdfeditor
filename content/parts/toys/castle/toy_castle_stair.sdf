                    RoundBox size=(1.2, 0.6, 0.3) roundness=0.04
                Translate translation=(0, 0.9, 3.3)
                    RoundBox size=(1.2, 0.9, 0.3) roundness=0.04
                Translate translation=(0, 1.2, 4.5)
                    RoundBox size=(1.2, 1.2, 0.3) roundness=0.04
                Translate translation=(0, 1.5, 5.7)
                    RoundBox size=(1.2, 1.5, 0.3) roundness=0.04
                Translate translation=(0, 1.8, 6.9)
                    RoundBox size=(1.2, 1.8, 0.3) roundness=0.04
                Translate translation=(0, 2.1, 8.1)
                    RoundBox size=(1.2, 2.1, 0.3) roundness=0.04
