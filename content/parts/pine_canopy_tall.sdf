                RadialWave amount=0.07 count=6
                    Round radius=0.094
                        CappedCone height=0.363 bottomRadius=0.514 topRadius=0.154
        Translate translation=(0, 5.55, 0)
            Rotate rotation=(0, 2.3, 0)
                RadialWave amount=0.07 count=6
                    Round radius=0.087
                        CappedCone height=0.351 bottomRadius=0.417 topRadius=0.137
        Translate translation=(0, 6.4, 0)
            Rotate rotation=(0, 0.1, 0)
                RadialWave amount=0.07 count=6
                    Round radius=0.08
                        CappedCone height=0.34 bottomRadius=0.32 topRadius=0.12
        # The tip, a narrow cone with a rounded point
        Translate translation=(0, 7.05, 0)
            Round radius=0.07
