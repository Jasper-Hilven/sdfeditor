# Pine canopy tall: the needles of a tall, slender spruce, a narrow spire of eight stacked tiers about 2.2 m across at the bottom
# and 7.6 m tall, its base at the origin. The tiers are the same soft-rimmed, scalloped lampshades as the pine canopy's, closer in
# width to each other so the spire stays narrow most of the way up. Form only: the model wraps it in its material.
format 1

# A gentle, large-scale lumpiness, shallow next to the tiers
Distort amount=0.025 frequency=1.4
    # The tiers run into each other where they overlap
    SmoothUnion smoothness=0.08
        # Eight tiers, broadest at the bottom, each turned against the last so the scallops do not line up
        Translate translation=(0, 0.45, 0)
            Rotate rotation=(0, 0, 0)
                RadialWave amount=0.07 count=7
                    Round radius=0.13
                        CappedCone height=0.42 bottomRadius=1 topRadius=0.24
        Translate translation=(0, 1.3, 0)
            Rotate rotation=(0, 0.9, 0)
                RadialWave amount=0.07 count=7
                    Round radius=0.123
                        CappedCone height=0.409 bottomRadius=0.903 topRadius=0.223
        Translate translation=(0, 2.15, 0)
            Rotate rotation=(0, 1.8, 0)
                RadialWave amount=0.07 count=7
                    Round radius=0.116
                        CappedCone height=0.397 bottomRadius=0.806 topRadius=0.206
        Translate translation=(0, 3, 0)
            Rotate rotation=(0, 2.7, 0)
                RadialWave amount=0.07 count=7
                    Round radius=0.109
                        CappedCone height=0.386 bottomRadius=0.709 topRadius=0.189
        Translate translation=(0, 3.85, 0)
            Rotate rotation=(0, 0.5, 0)
                RadialWave amount=0.07 count=6
                    Round radius=0.101
                        CappedCone height=0.374 bottomRadius=0.611 topRadius=0.171
        Translate translation=(0, 4.7, 0)
