# Old canopy tall: the crown of an old, hollow tree trained like a bonsai, flat cloud pads at four heights stepping up and turning
# round the middle, about 3.8 m across and 2.6 m tall, centred on the origin: two broad low pads to either side, two smaller ones a
# level up to the front and back, one over the middle and a small cap on top. A hidden core joins them into one surface, as in the
# old canopy. Form only: the model wraps it in its material.
format 1

# A gentle, large-scale lumpiness, shallow next to the pads
Distort amount=0.03 frequency=1.4
    # Creases soft enough to join the pads, tight enough to keep each one's edge
    SmoothUnion smoothness=0.1
        # The hidden core, a tall column inside the pads
        Ellipsoid radii=(0.7, 1.1, 0.65)
        # The low pads, out to either side
        Translate translation=(1.2, -0.85, 0.15)
            Ellipsoid radii=(0.85, 0.28, 0.75)
        Translate translation=(-1.15, -0.7, -0.2)
            Ellipsoid radii=(0.8, 0.27, 0.72)
        # A level up, to the front and back
        Translate translation=(0.15, -0.15, 0.95)
            Ellipsoid radii=(0.75, 0.26, 0.65)
        Translate translation=(-0.2, -0.05, -0.95)
            Ellipsoid radii=(0.72, 0.26, 0.62)
        # The broad pad over the middle
        Translate translation=(0.1, 0.5, 0.05)
            Ellipsoid radii=(0.95, 0.3, 0.85)
        # The small cap on top
        Translate translation=(-0.1, 1.05, 0)
            Ellipsoid radii=(0.5, 0.24, 0.45)
