# Meeple: the board game's little wooden person, 2.65 m tall, its feet on the origin and its front to +z. A flat, soft-edged
# body, 1.9 m across the arms and 0.84 m thick with its edges rounded, in plain varnished wood of one colour: wide legs with a
# gap between them, a broad torso, arms stretched out, a neck and a round head.
format 1

Material material=meeple_wood
    Round radius=0.12
        Extrusion height=0.3
            SmoothUnion2D smoothness=0.07
                # Body and legs, with the gap between the legs cut out
                Subtraction2D
                    Translate2D offset=(0, 0.72)
                        Trapezoid2D bottomRadius=0.62 topRadius=0.3 height=0.6
                    Triangle2D a=(-0.34, -0.1) b=(0.34, -0.1) c=(0, 0.75)
                # The arms, stretched out wide
                Translate2D offset=(0, 1.38)
                    Ellipse2D radii=(0.82, 0.22)
                # The neck
                Translate2D offset=(0, 1.8)
                    Ellipse2D radii=(0.17, 0.3)
                # The head
                Translate2D offset=(0, 2.14)
                    Circle radius=0.3
