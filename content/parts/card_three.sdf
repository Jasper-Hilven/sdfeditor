# Card, three of diamonds: a giant playing card 3 m wide, 4.2 m tall and 13 cm thick, centred on the origin and standing in the xy
# plane with its face to +z, its back the blue lattice of a plain card back. Every mark is painted flush on the white blank: the blank
# cut to the front (or back) half of the space and to the 2D shapes of the mark, so the card stays one smooth slab and one mesh;
# where marks overlap, the later one in the union shows. The blank is written out in each mark rather than used as a part, which
# would make it a mesh of its own under the marks.
# The three has three diamonds down the middle and a 3 with a small diamond in two opposite corners.
format 1

Union
    # The blank, 3 m wide, 4.2 m tall and 13 cm thick, with rounded corners and edges
    Material material=card_paper
        Round radius=0.03
            Extrusion height=0.035
                RoundedBox2D size=(1.47, 2.07) radiusTopRight=0.22 radiusBottomRight=0.22 radiusTopLeft=0.22 radiusBottomLeft=0.22
    # The back: a blue panel inside a white border
    Material material=card_back_blue
        Intersection
            Round radius=0.03
                Extrusion height=0.035
                    RoundedBox2D size=(1.47, 2.07) radiusTopRight=0.22 radiusBottomRight=0.22 radiusTopLeft=0.22 radiusBottomLeft=0.22
            Translate translation=(0, 0, -0.5)
                Extrusion height=0.5
                    RoundedBox2D size=(1.3, 1.9) radiusTopRight=0.14 radiusBottomRight=0.14 radiusTopLeft=0.14 radiusBottomLeft=0.14
    # with a lattice of pale diamonds, every other row shifted half a step
    Material material=card_back_light
        Intersection
            Round radius=0.03
                Extrusion height=0.035
                    RoundedBox2D size=(1.47, 2.07) radiusTopRight=0.22 radiusBottomRight=0.22 radiusTopLeft=0.22 radiusBottomLeft=0.22
            Translate translation=(0, 0, -0.5)
                Intersection
                    Extrusion height=0.5
                        RoundedBox2D size=(1.2, 1.8) radiusTopRight=0.1 radiusBottomRight=0.1 radiusTopLeft=0.1 radiusBottomLeft=0.1
                    Union
                        LimitedRepetition spacing=0.3 limits=(4, 6, 0)
                            Extrusion height=0.5
                                Rotate2D angle=0.7854
                                    Box2D size=(0.09, 0.09)
                        Translate translation=(0.15, 0.15, 0)
                            LimitedRepetition spacing=0.3 limits=(3, 5, 0)
                                Extrusion height=0.5
                                    Rotate2D angle=0.7854
                                        Box2D size=(0.055, 0.055)
    # A round medallion in the middle: a white ring round a blue disc with a white diamond
    Material material=card_paper
        Intersection
            Round radius=0.03
                Extrusion height=0.035
                    RoundedBox2D size=(1.47, 2.07) radiusTopRight=0.22 radiusBottomRight=0.22 radiusTopLeft=0.22 radiusBottomLeft=0.22
            Translate translation=(0, 0, -0.5)
                Extrusion height=0.5
                    Union2D
                        Circle radius=0.55
    Material material=card_back_blue
        Intersection
            Round radius=0.03
                Extrusion height=0.035
                    RoundedBox2D size=(1.47, 2.07) radiusTopRight=0.22 radiusBottomRight=0.22 radiusTopLeft=0.22 radiusBottomLeft=0.22
            Translate translation=(0, 0, -0.5)
                Extrusion height=0.5
                    Circle radius=0.47
    Material material=card_paper
        Intersection
            Round radius=0.03
                Extrusion height=0.035
                    RoundedBox2D size=(1.47, 2.07) radiusTopRight=0.22 radiusBottomRight=0.22 radiusTopLeft=0.22 radiusBottomLeft=0.22
            Translate translation=(0, 0, -0.5)
                Extrusion height=0.5
                    Rhombus2D size=(0.28, 0.4)
    Material material=card_back_blue
        Intersection
            Round radius=0.03
                Extrusion height=0.035
                    RoundedBox2D size=(1.47, 2.07) radiusTopRight=0.22 radiusBottomRight=0.22 radiusTopLeft=0.22 radiusBottomLeft=0.22
            Translate translation=(0, 0, -0.5)
                Extrusion height=0.5
                    Rhombus2D size=(0.17, 0.26)
    # The three diamonds down the middle, the last turned upside down
    Material material=card_red
        Intersection
            Round radius=0.03
                Extrusion height=0.035
                    RoundedBox2D size=(1.47, 2.07) radiusTopRight=0.22 radiusBottomRight=0.22 radiusTopLeft=0.22 radiusBottomLeft=0.22
            Translate translation=(0, 0, 0.5)
                Union
                    Translate translation=(0, 1.2, 0)
                        Scale scale=(0.62, 0.62, 0.62)
                            Extrusion height=0.8065
                                Rhombus2D size=(0.55, 0.85)
                    Translate translation=(0, 0, 0)
                        Scale scale=(0.62, 0.62, 0.62)
                            Extrusion height=0.8065
                                Rhombus2D size=(0.55, 0.85)
                    Translate translation=(0, -1.2, 0)
                        Scale scale=(0.62, 0.62, 0.62)
                            Extrusion height=0.8065
                                Rotate2D angle=3.1416
                                    Rhombus2D size=(0.55, 0.85)
    # The index numbers, and a small diamond under each
    Material material=card_red
        Intersection
            Round radius=0.03
                Extrusion height=0.035
                    RoundedBox2D size=(1.47, 2.07) radiusTopRight=0.22 radiusBottomRight=0.22 radiusTopLeft=0.22 radiusBottomLeft=0.22
            Translate translation=(0, 0, 0.5)
                Extrusion height=0.5
                    Union2D
                        Translate2D offset=(-1.18, 1.72)
                            Union2D
                                Translate2D offset=(0, 0.085)
                                    Rotate2D angle=-1.5708
                                        Arc2D sinCos=(0.8, -0.6) radius=0.085 thickness=0.03
                                Translate2D offset=(0, -0.085)
                                    Rotate2D angle=-1.5708
                                        Arc2D sinCos=(0.8, -0.6) radius=0.085 thickness=0.03
                        Translate2D offset=(1.18, -1.72)
                            Rotate2D angle=3.1416
                                Union2D
                                    Translate2D offset=(0, 0.085)
                                        Rotate2D angle=-1.5708
                                            Arc2D sinCos=(0.8, -0.6) radius=0.085 thickness=0.03
                                    Translate2D offset=(0, -0.085)
                                        Rotate2D angle=-1.5708
                                            Arc2D sinCos=(0.8, -0.6) radius=0.085 thickness=0.03
    Material material=card_red
        Intersection
            Round radius=0.03
                Extrusion height=0.035
                    RoundedBox2D size=(1.47, 2.07) radiusTopRight=0.22 radiusBottomRight=0.22 radiusTopLeft=0.22 radiusBottomLeft=0.22
            Translate translation=(0, 0, 0.5)
                Union
                    Translate translation=(-1.18, 1.3, 0)
                        Scale scale=(0.3, 0.3, 0.3)
                            Extrusion height=1.6667
                                Rhombus2D size=(0.55, 0.85)
                    Translate translation=(1.18, -1.3, 0)
                        Scale scale=(0.3, 0.3, 0.3)
                            Extrusion height=1.6667
                                Rotate2D angle=3.1416
                                    Rhombus2D size=(0.55, 0.85)
