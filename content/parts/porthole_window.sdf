# Porthole window: a round window 0.64 m across for the mushroom houses and hotels, centred on the origin and facing +z. A ring of
# dark wood frames a lit amber pane set 6 cm back, crossed by two thin glazing bars. The wall using it cuts a hole of radius
# 0.27 m behind it, at least 12 cm deep, for the pane to sit in.
format 1

Union
    # The pane, set back into the hole
    Material material=game_window_glow
        Translate translation=(0, 0, -0.06)
            Rotate rotation=(1.5707964, 0, 0)
                CappedCylinder radius=0.28 height=0.04
    Material material=game_wood_door
        Union
            # The frame: a fat ring round the hole, half sunk into the wall
            Rotate rotation=(1.5707964, 0, 0)
                Torus innerRadius=0.22 outerRadius=0.36
            # The glazing bars, a cross
            Translate translation=(0, 0, -0.03)
                Union
                    Box size=(0.27, 0.025, 0.025)
                    Box size=(0.025, 0.27, 0.025)
