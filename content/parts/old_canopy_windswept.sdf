# Old canopy windswept: the crown of an old tree bent by the wind, long, flat pads all streaming out to -x, about 4.4 m long, 2.4 m
# deep and 1.3 m tall, centred on the origin: a thick pad at the windward end over the trunk, thinning into longer, lower pads that
# reach out downwind, and a small one riding on top. A hidden core joins them. Form only: the model wraps it in its material.
format 1

# A gentle, large-scale lumpiness, shallow next to the pads
Distort amount=0.03 frequency=1.4
    # Creases soft enough to join the pads, tight enough to keep each one's edge
    SmoothUnion smoothness=0.1
        # The hidden core, long and low
        Ellipsoid radii=(1.6, 0.35, 0.7)
        # The thick windward pad
        Translate translation=(1.2, 0.15, 0)
            Ellipsoid radii=(0.85, 0.38, 0.8)
        # The middle pads, one either side
        Translate translation=(0.1, 0.05, 0.55)
            Ellipsoid radii=(1.1, 0.3, 0.7)
        Translate translation=(-0.2, -0.05, -0.55)
            Ellipsoid radii=(1.05, 0.28, 0.68)
        # The long downwind pad, lowest and thinnest
        Translate translation=(-1.4, -0.2, 0.1)
            Ellipsoid radii=(0.95, 0.24, 0.65)
        # The small pad riding on top
        Translate translation=(0.4, 0.45, -0.05)
            Ellipsoid radii=(0.7, 0.24, 0.55)
