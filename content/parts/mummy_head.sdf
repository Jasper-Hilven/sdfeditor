# The Ancient Mummy's head shape (ticket 45), a part so the model (content/models/characters/monsters/mummy.sdf) and its bursting pieces
# (content/models/characters/head-pieces/, ticket 51) share one shape: edit it here and both follow. Frame and notes: see the model.
format 1

# Normalized by tools/normalize-head.py (ticket 45): one uniform scale about the socket and the whole head set so its underside is at y=-0.29
# (1.525 m). The shape below is drawn at its own size. The wrapping is eight bands, each a slab (a box turned about the head) cut to a
# shell a little larger than the head, alternating light and old brown; they cross at different angles, with a slot left open for the eyes.
Translate translation=(0, -0.0982, 0)
    Scale scale=(1.3320, 1.3320, 1.3320)
        Union
            # The wrapped head under the bands: round, a nose and a chin under the linen, with the dark slot for the eyes
            Material material=mummy_wrap_dark
                Subtraction
                    Union
                        Translate translation=(0, 0, -0.02)
                            Ellipsoid radii=(0.208, 0.21, 0.208)
                        Translate translation=(0, -0.045, 0.2)
                            Ellipsoid radii=(0.04, 0.05, 0.045)
                        Translate translation=(0, -0.16, 0.12)
                            Ellipsoid radii=(0.1, 0.07, 0.1)
                    Translate translation=(0, 0.05, 0.2)
                        Box size=(0.36, 0.07, 0.2)
            Material material=mummy_dark
                Intersection
                    Translate translation=(0, 0, -0.02)
                        Ellipsoid radii=(0.205, 0.207, 0.205)
                    Translate translation=(0, 0.05, 0.2)
                        Box size=(0.36, 0.07, 0.2)
            # Eyes in the slot: pale, dead, with small black pupils
            Material material=mummy_eye
                SymmetryX
                    Translate translation=(0.07, 0.05, 0.165)
                        Sphere radius=0.037
            Material material=mummy_pupil
                SymmetryX
                    Translate translation=(0.07, 0.05, 0.199)
                        Ellipsoid radii=(0.014, 0.014, 0.012)
            # The bands
            Material material=mummy_wrap
                Subtraction
                    Intersection
                        Translate translation=(0, 0, -0.02)
                            Ellipsoid radii=(0.219, 0.219, 0.219)
                        Rotate rotation=(0.0, 0.0, 0.0)
                            Translate translation=(0, 0.12, 0)
                                Box size=(0.7, 0.04, 0.7)
                    Translate translation=(0, 0.05, 0.2)
                        Box size=(0.36, 0.07, 0.2)
            Material material=mummy_wrap_dark
                Subtraction
                    Intersection
                        Translate translation=(0, 0, -0.02)
                            Ellipsoid radii=(0.219, 0.219, 0.219)
                        Rotate rotation=(0.0, 0.0, 0.35)
