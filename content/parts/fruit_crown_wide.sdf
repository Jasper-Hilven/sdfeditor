# Fruit crown wide: the crown of a grown, standard apple tree, a broad, flattened dome of leaves about 3.1 m across and 1.5 m
# tall, centred on the origin: a wide core under a ring of six clumps and two more on top, with ten big apples set half into it, each
# centred on the surface of a clump like those of the round fruit crown. Carries its own materials, leaves and apples, so the
# fruit sways with the crown; the model leaves it unwrapped.
format 1

Union
    # The leaves
    Material material=fruit_leaves
        # A gentle, large-scale lumpiness, shallow next to the clumps
        Distort amount=0.02 frequency=1.6
            # Soft creases between the clumps, each keeping its bulge in the outline
            SmoothUnion smoothness=0.1
                # The wide, flat core joining the ring
                Ellipsoid radii=(1.05, 0.5, 0.9)
                # The ring of six clumps around the rim, then two on top
                Translate translation=(0.908, 0.013, 0.251)
                    Ellipsoid radii=(0.62, 0.48, 0.58)
                Translate translation=(0.211, -0.113, 0.829)
                    Ellipsoid radii=(0.62, 0.48, 0.58)
                Translate translation=(-0.697, 0.013, 0.578)
                    Ellipsoid radii=(0.62, 0.48, 0.58)
                Translate translation=(-0.908, -0.113, -0.251)
                    Ellipsoid radii=(0.62, 0.48, 0.58)
                Translate translation=(-0.211, 0.013, -0.829)
                    Ellipsoid radii=(0.62, 0.48, 0.58)
                Translate translation=(0.697, -0.113, -0.578)
                    Ellipsoid radii=(0.62, 0.48, 0.58)
                Translate translation=(0.35, 0.42, 0.15)
                    Ellipsoid radii=(0.62, 0.42, 0.56)
                Translate translation=(-0.32, 0.38, -0.22)
                    Ellipsoid radii=(0.6, 0.42, 0.55)

    # The apples, a plain union so the red stops crisply at the leaves
    Material material=apple
        Union
            Translate translation=(1.253, -0.103, 0.712)
                Sphere radius=0.16
            Translate translation=(0.325, -0.113, 1.399)
                Sphere radius=0.16
            Translate translation=(-1.057, -0.167, 0.997)
                Sphere radius=0.16
            Translate translation=(-1.505, -0.232, -0.191)
                Sphere radius=0.16
            Translate translation=(-0.427, -0.041, -1.369)
                Sphere radius=0.16
            Translate translation=(1.12, -0.294, -0.94)
                Sphere radius=0.16
            Translate translation=(1.519, 0.074, 0.312)
                Sphere radius=0.16
            Translate translation=(0.463, 0.797, 0.376)
                Sphere radius=0.16
            Translate translation=(-0.567, 0.751, -0.344)
                Sphere radius=0.16
            Translate translation=(-0.646, -0.394, 0.882)
                Sphere radius=0.16
