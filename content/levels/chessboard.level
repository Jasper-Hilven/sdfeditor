# The unique models, each from content/models/ by name, its base on the ground at (x, z), turned yaw degrees (counter-clockwise
# from above). Squares are 8 m, their centres at -76, -68, ..., 76 on both axes; the pieces keep to none of them
place
    # The game pieces from other games, strewn over the board as if the players had flipped the table: off the squares,
    # turned every which way, in spills and piles, knocked over. Each comment below starts a group that may touch within itself
    # (the overlap test in LevelFileTests reads the groups from these comments)
    # A dice spill
    die-red at=(-46.5, -29.2) yaw=17 scale=1.2
    die-red-tumbled at=(-41.3, -25.8) yaw=63 scale=1.1
    die-ivory at=(-50.8, -23.1) yaw=-34
    die-d8 at=(-38.6, -31.7) yaw=112
    # Stray dice
    die-red-tumbled at=(28.4, 51.6) yaw=-148 scale=1.4
    # A die in the east
    die-d8 at=(61.2, -12.5) yaw=41 scale=0.9
    # A die in the north
    die-ivory at=(-12.7, 68.3) yaw=203 scale=1.3
    # A crooked street of houses and a hotel, one house blown over
    monopoly-house at=(12.6, -54.4) yaw=8
    monopoly-house at=(19.3, -51.2) yaw=-21
    monopoly-house-toppled at=(26.8, -55.9) yaw=74
    monopoly-hotel at=(39.2, -48.6) yaw=-12
    # A second street in a far corner
    monopoly-house at=(-66.4, 44.7) yaw=135 scale=0.9
    monopoly-hotel at=(-69.0, 36.0) yaw=161
    # A house blown across the board
    monopoly-house-toppled at=(52.7, 27.9) yaw=-103
    # A domino run gone wrong
    domino-chain at=(-20.5, -6.4) yaw=58
    domino-5-5-standing at=(-27.9, -11.3) yaw=50
    domino-6-3-lying at=(-14.0, -10.0) yaw=-24
    # Stray tiles
    domino-2-6-side at=(5.6, 30.2) yaw=97
    # A tile in the east
    domino-6-3-lying at=(66.9, 61.4) yaw=12 scale=1.2
    # A tile in the south-west
    domino-5-5-standing at=(-70.3, -60.8) yaw=-37
    # Meeples, some still standing
    meeple-standing at=(44.8, -6.9) yaw=-120
    meeple-fallen at=(47.3, -1.2) yaw=31
    # Lone meeples
    meeple-standing at=(-4.1, -42.6) yaw=170 scale=1.2
    # A meeple that fell on the left
    meeple-fallen at=(-37.5, 45.5) yaw=-66
    # A meeple in the far corner
    meeple-standing at=(71.5, -70.2) yaw=225
    # Poker chips: a stack and a runaway
    poker-chip-stack at=(-61.8, 9.7) yaw=33
    poker-chip-rolling at=(-55.2, 14.6) yaw=-48
    # A second stack
    poker-chip-stack at=(4.0, -28.5) yaw=-77 scale=0.8
    # A runaway chip
    poker-chip-rolling at=(37.6, 70.8) yaw=125
    # A house of cards amid a spilled hand
    card-house at=(2.4, 49.1) yaw=27
    card-face-down at=(9.8, 55.7) yaw=-41
    card-three-lying at=(3.0, 64.5) yaw=66
    # A card soldier on guard
    card-king-stuck at=(-29.7, -63.4) yaw=-15
    # An ace propped against a king
    card-ace-held at=(58.6, -38.2) yaw=-140
    # Cards thrown into the board
    card-king-stuck at=(73.6, 9.3) yaw=-95
    # A card face down on the left
    card-face-down at=(-73.8, -24.6) yaw=12
    # A card lying in the middle
    card-three-lying at=(21.9, 13.7) yaw=158
    #
    # The chess pieces, in no order at all: clusters and pile-ups, a ragged pawn line, strays, and open squares between.
    # Light and dark mixed everywhere and in mismatched numbers; the -fallen models lie toppled
    # A scrum in the middle of the board's left half: every kind of piece of both colours piled together, a few knocked flat
    rook-light at=(-24.5, 22.9) yaw=-51 scale=1.04
    pawn-dark-fallen at=(-29.2, 18.8) yaw=103 scale=0.93
    pawn-light at=(-25.6, 17.2) yaw=-86 scale=1.15
