# The chessboard: a closed cube of six chessboards of board-game pieces. The floor is one huge board of 20 × 20 squares of 8 m,
# 160 m × 160 m, flat as a table, in a state of complete anarchy: board-game pieces of every kind, chess among them, stand and lie all
# over it, off their squares, in heaps and scrums, with far too many queens, some knocked flat, and open squares between. Four
# chessboards stand round it as walls and a sixth hangs over it as the ceiling (the room line), all one checker pattern. Nothing lies
# outside the cube: no hills, no island edge, no foliage, no sky.
format 1

play size=(160, 160) noise=0              # the board, centred on the origin: x across, z along; no unevenness, a board is flat
seed 2

# The board, from 2D shapes; where regions overlap, the later one wins. Each is drawn in its material,
# materials/ground/ground_<region>.sdfmat. No noise: the squares' edges are ruled straight
regions
    light wobble=0                                # the whole board in the light squares' cream...
        Box2D center=(0, 0) size=(160, 160)
    dark wobble=0                                 # ...and the dark squares over it, the corner squares dark: (i + j) even, from the -x, -z corner
        # Rank 1, z = -76
        Box2D center=(-76, -76) size=(8, 8)
        Box2D center=(-60, -76) size=(8, 8)
        Box2D center=(-44, -76) size=(8, 8)
        Box2D center=(-28, -76) size=(8, 8)
        Box2D center=(-12, -76) size=(8, 8)
        Box2D center=(4, -76) size=(8, 8)
        Box2D center=(20, -76) size=(8, 8)
        Box2D center=(36, -76) size=(8, 8)
        Box2D center=(52, -76) size=(8, 8)
        Box2D center=(68, -76) size=(8, 8)
