# The fungal level: the third level. The same 150 m × 100 m floating island as the meadow, walled in by hills whose crests, 8 to 12 m
# high, hide everything behind them from eye height, but everything that grows here is a fungus: mushroom trees for trees, moss and
# small fungi for grass and flowers on bare dark earth, and the fly agaric castle grown whole. Stumps, logs,
# lichened rock, moss and leaf litter are what fungi live on; nothing else grows. Under the Eye-Moon Night sky.
format 1

play size=(150, 100)                      # the playable rectangle, centred on the origin: x across, z along
seed 1

hills
    ring width=28 height=10               # rise outside the rectangle, crest about 8-12 m
    noise amplitude=2.5 scale=18          # unevenness along the crest and on the slopes

edge                                      # where the island ends, behind the hill crests
    margin=6 rim=3 shoulder=3             # its last 3 m bend down to 3 m high all round, where the underside meets the ground
    underside island-underside            # the rock below the island, content/models/terrain/, made for these numbers

# The ground other than dirt (the base: bare earth, the ground outside the regions), from 2D shapes; where regions overlap, the
# later one wins. Each is drawn in its material, materials/ground/ground_<region>.sdfmat. The fungi grow right up to the castles'
# walls: nothing but the trail is kept clear
regions base=dirt
    trail                                 # a track of pale spore dust, trodden from gate to gate
        Polyline points=[(-49, 0), (-36, 4), (-18, 7), (0, 2), (16, -5), (34, -5), (49, 0)] width=2.6 noise=0.5 noiseScale=4

# The unique models, each from content/models/ by name, its base on the ground at (x, z) or y metres above it, turned yaw degrees
# (counter-clockwise from above, so yaw=90 turns a model's front, +z, to +x). The fungal castles face each other across the island,
# standing on level plateaus with the fungi grown up to their walls, each dressed in its side's team mushrooms; a few big lichened
# rocks break up the open field, and the fairy rings (rings of small mushrooms on a low band of the dirt, with no collider) lie in
# the open ground, clear of the trail, the rocks and the giants
place
    castle0 at=(-62, 0) yaw=90 flatten=22
    castle0 at=(62, 0) yaw=-90 flatten=22
    rock1 at=(10, 30) yaw=40 scale=2.2                # a mossy outcrop, too big for a convex collider
    rock3 at=(-20, -35) yaw=0 scale=1.5
    rock4 at=(30, -32) yaw=125
    rock2 at=(-32, 30) yaw=200 scale=1.3
    rock0 at=(-40, -42) yaw=15 scale=2
    rock0 at=(34, 26) yaw=70 scale=2.4
    rock3 at=(4, -44) yaw=250 scale=1.8
    # The giant mushrooms standing in the open field between the castles, each on the ground where it is, with a convex collider: no
    # eyes and no hands. They stand clear of the trail and the castles
    giant-amanita0 at=(-26, -14) yaw=20
    giant-amanita0 at=(26, 12) yaw=200
    giant-amanita0 at=(-20, 30) yaw=300
    giant-amanita0 at=(2, 14) yaw=45
    giant-porcini0 at=(-4, -26) yaw=60
    giant-porcini0 at=(30, -14) yaw=30
    giant-porcini0 at=(-18, -6) yaw=0
    giant-porcini1 at=(14, -22) yaw=150
    giant-porcini1 at=(-2, 38) yaw=80
    giant-amanita-cluster0 at=(-14, 14) yaw=0
    giant-amanita-cluster0 at=(22, 36) yaw=-40
    giant-amanita-cluster0 at=(-36, -30) yaw=110
    # The fairy rings. The four nearest the castles are mirrored across x = 0, as the battle sides' weapon pods stand in them
    fairy-ring0 at=(-8, 24) yaw=0
    fairy-ring1 at=(18, -34) yaw=90
    fairy-ring0 at=(-30, 16) yaw=45
    fairy-ring1 at=(14, 12) yaw=20
    fairy-ring0 at=(-46, 38) yaw=130
    fairy-ring1 at=(44, -22) yaw=300
    fairy-ring0 at=(46, 38) yaw=200
    fairy-ring1 at=(-44, -22) yaw=75
    # The team mushrooms (ticket 19): each castle dressed in its side's colour, reddish on the west castle and bluish on the east, as
    # the sides' flags are; the castle model itself is unchanged. Clumps at the foot of the walls, by the gate, on the plateau and
    # in the courtyard stand on the ground; crowns on the caps, sprigs on the parapet and the towers' rings stand y metres above it,
    # on the castle (its heights over its base, which stands on its level plateau). Mirrored across x = 0, the heights each
    # castle's own (its towers differ a little). Only uses of small parts, drawn instanced with the castle's parts; no colliders
    # West, on the caps' crowns: the keep's (20 m up), the large towers' (15 m), the small towers' (12 m), the gate turrets' (9 m)
    team-red-crown0 at=(-67, 0) yaw=35 scale=1.3 y=20.35
    team-red-crown0 at=(-62, -12.4) yaw=-171 y=15.7
    team-red-crown0 at=(-62, 12.4) yaw=-9 y=14.87
    team-red-crown0 at=(-68.05, -8.61) yaw=-18 scale=0.8 y=11.89
    team-red-crown0 at=(-68.05, 8.61) yaw=65 scale=0.8 y=12.28
    team-red-crown0 at=(-53.83, -3.24) yaw=-60 scale=0.55 y=9.1
    team-red-crown0 at=(-53.83, 3.24) yaw=60 scale=0.55 y=9.26
    # West, on the parapet's top (5.5 m) between two merlons, outside the wall-walk
    team-red-sprig0 at=(-55.03, -7.72) yaw=115 y=5.5
    team-red-sprig0 at=(-56.44, -9.79) yaw=134 y=5.5
    team-red-sprig0 at=(-59.49, -12.08) yaw=162 y=5.5
    team-red-sprig0 at=(-66.69, -10.7) yaw=-134 y=5.5
    team-red-sprig0 at=(-70.27, -4.27) yaw=-102 y=5.5
    team-red-sprig0 at=(-70.27, 4.26) yaw=-78 y=5.5
    team-red-sprig0 at=(-66.7, 10.7) yaw=-46 y=5.5
    team-red-sprig0 at=(-59.49, 12.08) yaw=18 y=5.5
    team-red-sprig0 at=(-56.44, 9.8) yaw=46 y=5.5
    team-red-sprig0 at=(-55.03, 7.73) yaw=65 y=5.5
    # West, on the outer rim of the large towers' rings (5.3 m), on the balcony's outer half, between its lantern and veil
    team-red-sprig0 at=(-64.16, -14.56) yaw=-135 y=5.31
    team-red-sprig0 at=(-60.48, -15.04) yaw=150 y=5.34
    team-red-sprig0 at=(-64.16, 14.56) yaw=-45 y=5.26
    team-red-sprig0 at=(-60.48, 15.04) yaw=30 y=5.28
    # West, at the foot of the walls and the large towers, outside
    team-red-clump0 at=(-52.33, -7.97) yaw=-175
    team-red-clump0 at=(-55.94, -12.38) yaw=-156
    team-red-clump0 at=(-65.55, -14.42) yaw=-92
    team-red-clump0 at=(-72.95, -3.87) yaw=-32
    team-red-clump0 at=(-72.71, 5.04) yaw=-8
    team-red-clump0 at=(-64.99, 14.61) yaw=52
    team-red-clump0 at=(-59.02, 14.61) yaw=88
    team-red-clump0 at=(-52.08, 7.43) yaw=135
    # West, either side of the gate, clear of the apron and the trail, and out on the plateau
    team-red-clump1 at=(-50.2, -5.6) yaw=110
    team-red-clump1 at=(-50.2, 5.6) yaw=-70 scale=0.95
    team-red-clump1 at=(-69.5, -16.5) yaw=170
    team-red-clump1 at=(-69.5, 16.5) yaw=20 scale=1.05
    # West, in the courtyard against the side walls, clear of the gate, the flag stand and the keep's stairs
    team-red-clump0 at=(-60.5, -6.6) yaw=120 scale=0.85
    team-red-clump0 at=(-60.2, 6.6) yaw=-20 scale=0.85
    # East, on the caps' crowns: the keep's (20 m up), the large towers' (15 m), the small towers' (12 m), the gate turrets' (9 m)
    team-blue-crown0 at=(67, 0) yaw=-35 scale=1.3 y=20.35
    team-blue-crown0 at=(62, -12.4) yaw=171 y=14.87
    team-blue-crown0 at=(62, 12.4) yaw=9 y=15.7
    team-blue-crown0 at=(68.05, -8.61) yaw=18 scale=0.8 y=12.28
    team-blue-crown0 at=(68.05, 8.61) yaw=-65 scale=0.8 y=11.89
    team-blue-crown0 at=(53.83, -3.24) yaw=60 scale=0.55 y=9.25
    team-blue-crown0 at=(53.83, 3.24) yaw=-60 scale=0.55 y=9.1
    # East, on the parapet's top (5.5 m) between two merlons, outside the wall-walk
    team-blue-sprig0 at=(55.03, -7.72) yaw=-115 y=5.5
    team-blue-sprig0 at=(56.44, -9.79) yaw=-134 y=5.5
    team-blue-sprig0 at=(59.49, -12.08) yaw=-162 y=5.5
    team-blue-sprig0 at=(66.69, -10.7) yaw=134 y=5.5
    team-blue-sprig0 at=(70.27, -4.27) yaw=102 y=5.5
    team-blue-sprig0 at=(70.27, 4.26) yaw=78 y=5.5
    team-blue-sprig0 at=(66.7, 10.7) yaw=46 y=5.5
    team-blue-sprig0 at=(59.49, 12.08) yaw=-18 y=5.5
    team-blue-sprig0 at=(56.44, 9.8) yaw=-46 y=5.5
    team-blue-sprig0 at=(55.03, 7.73) yaw=-65 y=5.5
    # East, on the outer rim of the large towers' rings (5.3 m), on the balcony's outer half, between its lantern and veil
    team-blue-sprig0 at=(64.16, -14.56) yaw=135 y=5.26
    team-blue-sprig0 at=(60.48, -15.04) yaw=-150 y=5.28
    team-blue-sprig0 at=(64.16, 14.56) yaw=45 y=5.31
    team-blue-sprig0 at=(60.48, 15.04) yaw=-30 y=5.34
    # East, at the foot of the walls and the large towers, outside
    team-blue-clump0 at=(52.33, -7.97) yaw=175
    team-blue-clump0 at=(55.94, -12.38) yaw=156
    team-blue-clump0 at=(65.55, -14.42) yaw=92
    team-blue-clump0 at=(72.95, -3.87) yaw=32
    team-blue-clump0 at=(72.71, 5.04) yaw=8
    team-blue-clump0 at=(64.99, 14.61) yaw=-52
    team-blue-clump0 at=(59.02, 14.61) yaw=-88
    team-blue-clump0 at=(52.08, 7.43) yaw=-135
    # East, either side of the gate, clear of the apron and the trail, and out on the plateau
    team-blue-clump1 at=(50.2, -5.6) yaw=-110
    team-blue-clump1 at=(50.2, 5.6) yaw=70 scale=0.95
    team-blue-clump1 at=(69.5, -16.5) yaw=-170
    team-blue-clump1 at=(69.5, 16.5) yaw=-20 scale=1.05
    # East, in the courtyard against the side walls, clear of the gate, the flag stand and the keep's stairs
    team-blue-clump0 at=(60.5, -6.6) yaw=-120 scale=0.85
    team-blue-clump0 at=(60.2, 6.6) yaw=20 scale=0.85

# The battle sides (ticket 17), west at -x and east at +x, mirrored: each side is its castle. The flag stand stands in the middle of
# the castle (half a metre towards the gate, clear of the keep stairs' foot); the spawn zone (ticket 20; 2.5 m round) lies outside
# the castle, beside it on its north (+z) side by the front corner, on the open level plateau 9 m out from the wall and the north
# large tower, between the front and the north flank turrets (5.5 m or more from the turrets, the clumps at the walls' foot and the
# gate's clumps, edge to edge) and well clear of the machine zone, facing out over the field like the gate; the minigun
# and pistol pods each stand in the middle of a fairy ring near the castle, north and south of it, and the health pods out on the
# south and north flanks, halfway to the middle, and one behind the castle, in the strip between its back wall (south of the keep,
# clear of the small tower and the clumps at the wall's foot) and the play area's edge. Everything stands on the ground, which is the courtyard's floor (the castles have none of
# their own there). The neutral pods stand in two of the fairy rings nearer the middle, one north and one south of the trail; the
# scatter keeps clear of every pod, stand and spawn.
# The machines (ticket 24): one turret per side outside the castle's walls (one, so a point can still be scored), before its front north of
# the gate (5 m out, 10 m from the trail, past the gate's clumps) facing out over the field; each turret's place is where it respawns. The machine zone, where the side's helicopter and
# tanks start and respawn: the castle's back reaches x = -72.3 at the keep, which leaves a strip only 2.7 m deep to the play area's
# edge (x = -75), cut by two of the team clumps, so the zone lies on the open, level plateau off the castle's back north corner,
# behind its back line, 6 m from the large tower and clear of the plateau clump; tanks drive out to the field round the tower
sides
    west
        spawn at=(-52, 20) yaw=90 radius=2.5
        flag at=(-61.5, 0)
        pod minigun at=(-46, 38)
        pod pistol at=(-44, -22)
        pod health at=(-28, -43)
        pod health at=(-28, 43)
        pod health at=(-73.5, -9)
        turret at=(-47, 10) yaw=60
        machines at=(-70, 22.5) yaw=90 radius=3
    east
        spawn at=(52, 20) yaw=-90 radius=2.5
        flag at=(61.5, 0)
        pod minigun at=(46, 38)
        pod pistol at=(44, -22)
        pod health at=(28, -43)
        pod health at=(28, 43)
        pod health at=(73.5, -9)
        turret at=(47, 10) yaw=-60
        machines at=(70, 22.5) yaw=-90 radius=3
neutral
    pod electro-gun at=(-8, 24)
    pod poison-gun at=(18, -34)

# The ground foliage, scattered by the thousand and drawn instanced: cushions of moss on the dirt ground (the turfs are
# cushions on top, not a carpet) and tufts of small fungi in looser drifts, nothing on the trail.
# density is instances per square metre on average, up to cluster times that in the clusters, which are about clusterScale
# metres wide; cluster is kept low (1.5 and 2) so the clumps are not too dense, the same amount spread over more of the ground;
# density is kept a little sparse (0.72 and 0.288) so the foliage does not crowd the ground
scatter
    moss-turf0 weight=3
    moss-turf1 weight=1
    moss-turf2 weight=1.5
    moss-turf3 weight=1
    moss-turf4 weight=1
    density=0.72 cluster=1.5 clusterScale=6 spacing=0.4 avoid=trail margin=0.5 maxSlope=25
scatter
    fungi-tuft0 weight=2
    fungi-tuft1 weight=1
    fungi-tuft2 weight=0.4
    fungi-tuft3 weight=1
    fungi-tuft4 weight=1
    density=0.288 cluster=2 clusterScale=8 spacing=0.5 avoid=trail margin=0.8 maxSlope=20

# The woods on the border hills, drawn instanced like the foliage. band is how far from the playable rectangle's edge they stand
# (negative inside it). The front row of mushroom trees climbs the inner slopes to the crest, 5 to 8 m apart, their caps large
# enough that they and the crest hide what is behind; a few smaller mushroom trees stand at the island's edge, where the player can
# walk up to them (their stems block); behind the crest, masses of caps grown into one fill the gaps between the front row's stems
# and carry the hill line. The tallest parasols reach about 14 m at the top of the scale
trees
    parasol0 weight=2
    parasol1 weight=1.5
    inkcap0 weight=1.5
    bracket-tower0 weight=1.5
    bracket-tower1 weight=0.8
    honey-cluster0
    band=(12, 28) density=0.00945 spacing=6 scale=(0.9, 1.2) maxSlope=35
trees
    honey-cluster0
    bracket-tower1
    inkcap0
    band=(-3, 6) density=0.0036 spacing=9 scale=(0.9, 1.2) avoid=trail margin=2
trees group=clusters
    cap-cluster0
    cap-cluster1
    cap-cluster2
    cap-cluster3
    cap-cluster4
    cap-cluster5
    band=(27.5, 31.5) density=0.045 spacing=3.5 scale=(0.9, 1.2)

# The field between the castles: groves of mushroom trees, clumps of them with open glades between, drawn instanced like the woods
# and with stems that block the player. band is inside the playable rectangle, 8 m or more from its edge, so the island's edge and the
# hills keep their own trees; margin keeps them 3 m clear of the trail
trees
    parasol0 weight=1
    parasol1 weight=0.8
    inkcap0 weight=1
    bracket-tower0 weight=0.8
    bracket-tower1 weight=1
    honey-cluster0 weight=2
    band=(-50, -8) density=0.0405 spacing=4 cluster=3 clusterScale=10 scale=(0.9, 1.2) avoid=trail margin=3 maxSlope=20

# More giant mushrooms in the open field, the same models as the placed ones, each with the convex collider of its model (a trees
# section takes any model with a collider: the rocks group does the same). Their own group, so that no wind bends them
trees group=giants
    giant-amanita0
    giant-porcini0
    giant-porcini1
    giant-amanita-cluster0 weight=0.6
    band=(-50, -8) density=0.0027 spacing=9 scale=(0.8, 1.2) avoid=trail margin=4 maxSlope=15

# Rocks in the field, scattered in the same way, with what fungi live on: stumps with brackets, a fallen log and puffballs among them
trees group=rocks
    rock0 weight=1
    rock1 weight=0.6
    rock2 weight=0.5
    rock3 weight=0.8
    rock4 weight=0.8
    stump-brackets0 weight=0.7
    stump-brackets1 weight=0.7
    log-fungi0 weight=0.4
    puffball0 weight=0.8
    band=(-50, -8) density=0.02 spacing=4 scale=(0.8, 1.6) avoid=trail margin=2.5 maxSlope=25

# How the foliage is drawn round the first-person camera: the finest level with its outline and shadows up to 6 m, the next to 15 m,
# the coarsest to 35 m, fading out over its last 15 m. A gentle sway of 4 cm at half a metre up, and the lowest 8 cm of each turf (its
# mound of soil) in the colour of the ground under it. The integrated GPU / web preset draws half of them, to 0.7 times the distance
draw foliage
    rings=[6, 15, 35] outline=1 shadows=1 blend=1 fade=15
    wind=0.04 windHeight=0.5 tintHeight=0.08
    lowDensity=0.5 lowDistance=0.7

# How the castles' repeated parts (walls, towers, merlons, stairs, mycelium) are drawn: instanced, without wind, each use at LOD0 up
# to 25 m, LOD1 to 60 m and LOD2 out past the far castle, with the ink outline on the nearer two rings (as their prefabs have it)
# and shadows on all three. The integrated GPU / web preset casts them from the nearest ring only and ends each ring at 0.4 times
# the distance (LOD0 to 10 m, LOD1 to 24 m, LOD2 to 160 m, past the far castle). Details cull at their own distance (their parts'
# cull setting). Without this section the castles are drawn as GameObjects.
draw castle
    rings=[25, 60, 400] outline=2 shadows=3 lowShadows=1 blend=2 lowDistance=0.4

# How the mushroom trees are drawn: LOD0 to 25 m, LOD1 to 60 m, LOD2 beyond, never ended by distance inside the level (only by the
# view), all with the ink outline, which carries the hill line; shadows from the nearer two rings (only the nearest on the
# integrated GPU / web preset, which also ends LOD0 and LOD1 at 0.7 times the distance). The caps sway only a few centimetres at the
# top, growing with the square of the height, much less than leafy crowns, so the stems do not bend like branches
draw trees
    rings=[25, 60, 1000] outline=3 shadows=2 lowShadows=1 blend=2 wind=0.025 windHeight=8 lowDistance=0.7

# The cap masses behind the crest, never nearer than about 30 m: LOD0 to 45 m and LOD1 beyond, outlined, casting no shadow (they would
# only fall on the hills' back slopes, behind the crest)
draw clusters
    rings=[45, 1000] outline=2 blend=3 wind=0.04 windHeight=8 lowDistance=0.7

# The extra giant mushrooms: as the trees, without any wind
draw giants
    rings=[25, 60, 1000] outline=3 shadows=2 lowShadows=1 blend=2 lowDistance=0.7

# The field's rocks, stumps, log and puffballs: LOD0 to 20 m, LOD1 to 50 m, LOD2 beyond, outlined, shadows from the nearest ring only
draw rocks
    rings=[20, 50, 1000] outline=2 shadows=1 blend=2 lowDistance=0.7

sky preset=night                          # Eye-Moon Night, content/skies/night.sky
