# The meadow: the first level. A 150 m × 100 m grass field on a floating island, walled in by hills whose crests, 8 to 12 m high,
# hide everything behind them from eye height; beyond them the island ends and there is only sky.
format 1

play size=(150, 100)                      # the playable rectangle, centred on the origin: x across, z along
seed 1

hills
    ring width=28 height=10               # rise outside the rectangle, crest about 8-12 m
    noise amplitude=2.5 scale=18          # unevenness along the crest and on the slopes

edge                                      # where the island ends, behind the hill crests
    margin=6 rim=3 shoulder=3             # its last 3 m bend down to 3 m high all round, where the underside meets the ground
    underside island-underside            # the rock below the island, content/models/terrain/, made for these numbers

# The ground other than grass, from 2D shapes; where regions overlap, the later one wins. Each is drawn in its material,
# materials/ground/ground_<region>.sdfmat; the tiles also get the castles' footprints (ground=tiles below)
regions
    dirt                                  # trodden earth round each castle
        Circle center=(-60, 0) radius=27 noise=2 noiseScale=7
        Circle center=(60, 0) radius=27 noise=2 noiseScale=7
    path                                  # a footpath wandering from gate to gate
        Polyline points=[(-49, 0), (-36, 4), (-18, 7), (0, 2), (16, -5), (34, -5), (49, 0)] width=2.6 noise=0.5 noiseScale=4
    tiles stone=0.6 grout=0.05            # flagstones: an apron before each gate, and the castles' courtyards and surrounds
        RoundedBox2D center=(-48, 0) size=(5, 7) radius=1.5
        RoundedBox2D center=(48, 0) size=(5, 7) radius=1.5

# The unique models, each from content/models/ by name, its base on the ground at (x, z), turned yaw degrees (counter-clockwise
# from above, so yaw=90 turns a model's front, +z, to +x). The castles face each other across the meadow, standing on level
# plateaus of tiles; a few big rocks break up the open field
place
    castle0 at=(-62, 0) yaw=90 ground=tiles groundMargin=2.5 flatten=22
    castle0 at=(62, 0) yaw=-90 ground=tiles groundMargin=2.5 flatten=22
    rock1 at=(10, 30) yaw=40 scale=2.2                # a mossy outcrop, too big for a convex collider
    rock3 at=(-20, -35) yaw=0 scale=1.5
    rock4 at=(30, -32) yaw=125
    rock2 at=(-32, 30) yaw=200 scale=1.3

# The ground foliage, scattered by the thousand and drawn instanced: clumps of grass on the grass ground (which reads as grass on its
# own; the turfs are clumps on top, not a carpet) and flowers in looser drifts, nothing on the dirt, path or tiles. density is
# instances per square metre on average, up to cluster times that in the clusters, which are about clusterScale metres wide
scatter
    grass-turf0 weight=3
    grass-turf1 weight=1
    grass-turf2 weight=1.5
    grass-turf3 weight=1
    grass-turf4 weight=1
    density=0.6 cluster=2 clusterScale=6 spacing=0.45 avoid=dirt,tiles,path margin=0.5 maxSlope=25
scatter
    flower0 weight=2
    flower1 weight=1
    flower2 weight=0.4
    flower3 weight=1
    flower4 weight=1
    density=0.12 cluster=3 clusterScale=10 spacing=0.6 avoid=dirt,tiles,path margin=0.8 maxSlope=20

# The woods on the border hills, drawn instanced like the foliage. band is how far from the playable rectangle's edge they stand
# (negative inside it). The front row climbs the inner slopes to the crest, 5 to 8 m apart, large enough that its crowns and the
# crest hide what is behind; a few trees stand at the meadow's edge, where the player can walk up to them (their trunks block);
# behind the crest, clusters of crowns grown into one mass fill the gaps between the front row's trunks and carry the hill line
trees
    tree0 weight=2
    tree1 weight=1.5
    tree2 weight=1.5
    old-tree1
    pine0
    pine1 weight=0.8
    band=(12, 28) density=0.0105 spacing=6 scale=(0.95, 1.4) maxSlope=35
trees
    tree0
    tree2
    old-tree1
    band=(-3, 6) density=0.004 spacing=9 scale=(0.9, 1.2) avoid=dirt,tiles,path margin=2
trees group=clusters
    cluster0
    cluster1
    cluster2
    cluster3
    cluster4
    cluster5
    cluster6 weight=0.6
    cluster7 weight=0.6
    cluster8
    cluster9
    band=(27.5, 31.5) density=0.05 spacing=3.5 scale=(0.9, 1.2)

# How the foliage is drawn round the first-person camera: the finest level with its outline and shadows up to 6 m, the next to 15 m,
# the coarsest to 35 m, fading out over its last 5 m. A gentle sway of 4 cm at half a metre up, and the lowest 8 cm of each turf (its
# mound of earth) in the colour of the ground under it. The integrated GPU / web preset draws half of them, to 0.7 times the distance
draw foliage
    rings=[6, 15, 35] outline=1 shadows=1 blend=1 fade=5
    wind=0.04 windHeight=0.5 tintHeight=0.08
    lowDensity=0.5 lowDistance=0.7

# How the castles' repeated parts (walls, towers, merlons, stairs, mycelium) are drawn: instanced, without wind, each use at LOD0 up
# to 25 m, LOD1 to 60 m and LOD2 out past the far castle, with the ink outline on the nearer two rings (as their prefabs have it)
# and shadows on all three. The integrated GPU / web preset casts them from the nearest ring only and ends each ring at 0.4 times
# the distance (LOD0 to 10 m, LOD1 to 24 m, LOD2 to 160 m, past the far castle). Details cull at their own distance (their parts'
# cull setting). Without this section the castles are drawn as GameObjects.
draw castle
    rings=[25, 60, 400] outline=2 shadows=3 lowShadows=1 blend=2 lowDistance=0.4

# How the trees are drawn: LOD0 to 25 m, LOD1 to 60 m, LOD2 beyond, never ended by distance inside the level (only by the view),
# all with the ink outline, which carries the hill line; shadows from the nearer two rings (only the nearest on the integrated
# GPU / web preset, which also ends LOD0 and LOD1 at 0.7 times the distance). The crowns sway a few centimetres at the treetops,
# growing with the square of the height, so the trunks stay put
draw trees
    rings=[25, 60, 1000] outline=3 shadows=2 lowShadows=1 blend=2 wind=0.06 windHeight=5 lowDistance=0.7

# The crest clusters, never nearer than about 30 m: LOD0 to 45 m and LOD1 beyond, outlined, casting no shadow (they would only fall
# on the hills' back slopes, behind the crest)
draw clusters
    rings=[45, 1000] outline=2 blend=3 wind=0.08 windHeight=8 lowDistance=0.7

sky preset=night                          # Eye-Moon Night, content/skies/night.sky
